{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/report-failed-main-check.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-scratch-in-checkout.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-legacy-hyprctl.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-in-background.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(gh * pr merge*)",
      "Bash(*merge-prs.sh 0*)",
      "Bash(*merge-prs.sh 1*)",
      "Bash(*merge-prs.sh 2*)",
      "Bash(*merge-prs.sh 3*)",
      "Bash(*merge-prs.sh 4*)",
      "Bash(*merge-prs.sh 5*)",
      "Bash(*merge-prs.sh 6*)",
      "Bash(*merge-prs.sh 7*)",
      "Bash(*merge-prs.sh 8*)",
      "Bash(*merge-prs.sh 9*)"
    ]
  }
}
