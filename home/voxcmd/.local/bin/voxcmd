#!/usr/bin/env bash
# voxcmd: route a spoken command to an action declared by a drop-in integration.
# Integration and replacement formats: ~/.config/voxcmd/README.md
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  voxcmd <text...>            route text as a spoken command; "and then" joins up to 5 steps, run in order
  voxcmd --dry-run <text...>  show what would run, without running it
  voxcmd listen               start a voxtype recording that stops itself after speech and a pause, then route the
                              transcript (as a reply when a voxcmd picker is open); while voxtype records, stop it
  voxcmd listen --start-only  the same, but only when voxtype is idle: never stops a recording
  voxcmd --reply <text...>    answer the open voxcmd picker (a choice, an ordinal, or cancel) or confirm card (yes or no)
  voxcmd --dry-run --reply <text...>
  voxcmd click-explain <text...> [--window <stableId>]
                              show why "click <text>" would or would not click, from the real capture and matcher,
                              without clicking or moving the pointer (the focused window, or that client)
  voxcmd rapid                open rapid mode: a voice session where every turn is a command
  voxcmd end-session          end the open voice session and every mode in it, if any
  voxcmd stop                 stop all voice activity: end the open session, cancel the open picker, card or hints, and
                              cancel a recording under way, discarding what was said; silent when none is open
  voxcmd wake on|off|toggle|status
                              start or stop the "hey jarvis" listener, which holds the microphone while it runs
  voxcmd list                 list integrations and their verbs
  voxcmd help                 pick from the integrations' example phrases (Tab lists what one can run); one without placeholders runs
  voxcmd errors [N]           print the last N (default 10) voxcmd notifications the bar kept: its errors, as info is transient
EOF
}

config_dir="${VOXCMD_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/voxcmd}"
runtime_dir="${XDG_RUNTIME_DIR:-/tmp}/voxcmd"
voxtype_state_file="${XDG_RUNTIME_DIR:-/tmp}/voxtype/state"
# Written by voxcmd-pick, voxcmd-confirm or voxcmd-hints while it waits: {pid, fifo, label, choices: [{id, label}]}, plus
# {kind: "confirm", listen_again} from voxcmd-confirm and {kind: "hints", listen_again} from voxcmd-hints.
pending_pick_file="$runtime_dir/pending-pick.json"
transcript_file="$runtime_dir/transcript.txt"
# Present while a voice session is open: the current mode {kind, integration, label, exit_hint, ...} with the session's
# {started, owner, owner_start, turns} and the modes underneath it as stack. owner is the PID of the watcher that will hear
# the next turn; a session whose owner is gone is stale and never read as open.
session_file="$runtime_dir/session.json"
qs_ipc="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/qs-ipc"
voxcmd_self="$(readlink -f "$0")"
voxcmd_pick="$(dirname "$voxcmd_self")/voxcmd-pick"
voxcmd_confirm="$(dirname "$voxcmd_self")/voxcmd-confirm"
voxcmd_autostop="$(dirname "$voxcmd_self")/voxcmd-autostop"
# Helpers integrations and print_errors source ("$voxcmd_share_dir/spoken-time.sh"), found from voxcmd's real path so a stowed or
# checked-out voxcmd reads its own copy. Not in integrations.d/, where every file is loaded as an integration.
voxcmd_share_dir="$(dirname "$voxcmd_self")/../share/voxcmd"
dry_run=0
# 1 while a voice session's turn is being handled.
in_session_turn=0
# 1 while routing a transcript from `voxcmd listen`, so a confirmation or a one-choice picker listens for its answer
# too.
came_by_voice=0
# Set by voxcmd-confirm, voxcmd-pick and voxcmd-hints for the recording they start: the watcher keeps its PID there while voxtype
# records or transcribes it, so a card or picker answered by key cancels only its own recording.
recording_owner_file="${VOXCMD_RECORDING_OWNER_FILE:-}"
# A phrase of several steps joined by "and then" is a sequence: its steps are routed one after another, each only once
# the one before has finished. in_sequence holds back the steps' own no-match and failure toasts, so the sequence
# can send one for the step it stopped at.
sequence_max_steps=5
step_timeout_secs="${VOXCMD_STEP_TIMEOUT_SECS:-15}"
# One file per running sequence, {pid, start}, so Stop Voice reaches all of them when Voice Command starts a second
# while the first still waits.
sequence_dir="$runtime_dir/sequences"
in_sequence=0
# The options route_step found in a dry run.
dry_run_options="[]"
# How the step just routed ended: ran, no_match, cancelled (a picker closed), declined (a confirm answered no), failed,
# timed_out or discarded. Set by route_step and run_option.
step_outcome=ran
# What a failed step reports: its label (blank for private labels) and the tail of its output.
step_label="" step_detail=""
# The option run_option last ran, for the wait that follows it, and the window that was active before the step, which
# a step_waits condition reads.
# shellcheck disable=SC2034
last_step_option="" active_before=""
# 1 in a watcher, whose discard flag is its recording's as well as a sequence's.
in_watcher=0
# Debug trace of listening, routing and replies, shared with voxcmd-confirm: VOXCMD_DEBUG=1, or
# create the file, turns it on.
debug_log_file="$runtime_dir/debug.log"

debug() {
  [ -n "${VOXCMD_DEBUG:-}" ] || [ -e "$debug_log_file" ] || return 0
  mkdir -p "$runtime_dir"
  printf '%s voxcmd[%s] %s\n' "$(date +%T.%3N)" "$$" "$*" >>"$debug_log_file"
}

# A test hook: VOXCMD_TIME_SCALE=0.1 makes voxcmd's fixed polls ten times as frequent, and every wait counted in polls
# ten times as short, so the test suite's sessions run fast without changing what the waits decide. Unset, it is 1.
time_scale="${VOXCMD_TIME_SCALE:-1}"
scaled_secs() {
  if [ "$time_scale" = 1 ]; then printf '%s' "$1"; else awk -v secs="$1" -v scale="$time_scale" 'BEGIN { print secs * scale }'; fi
}

# notify info|error <summary> <body>. Info (what ran, answers, hints) is transient: the bar shows it but keeps it
# out of its history, which is left to errors.
notify() {
  local kind="$1" summary="$2" body="$3"
  if [ "$dry_run" = 1 ] || ! command -v notify-send >/dev/null; then
    printf '%s: %s\n' "$summary" "$body" >&2
    return
  fi
  local -a flags=(-a voxcmd)
  [ "$kind" = error ] || flags+=(--transient)
  notify-send "${flags[@]}" "$summary" "$body"
}

# The notification carries a Voice Help button. notify-send waits for the notification to close to report a
# clicked action, so a detached waiter holds it instead of voxcmd.
notify_no_match() {
  if [ "$dry_run" = 1 ] || ! command -v notify-send >/dev/null; then
    notify info "$1" "$2"
    return
  fi
  # shellcheck disable=SC2016 # expanded by the inner sh
  setsid sh -c '[ "$(notify-send -a voxcmd --transient --action=help="Voice Help" "$1" "$2")" = help ] && exec "$3" help' \
    sh "$1" "$2" "$voxcmd_self" </dev/null >/dev/null 2>&1 &
}

integration_files() {
  local file
  for file in "$config_dir"/integrations.d/*.sh; do
    if [ -f "$file" ]; then printf '%s\n' "$file"; fi
  done
}

# Runs "<function> <args...> <line>" for each non-empty line of stdin, all at once, and prints their outputs in the
# order of the lines. Integrations query live state (windows, audio devices, agents), so they run side by side rather
# than waiting on each other; each run writes its own file so the output keeps the order of the lines.
for_each_line_in_parallel() {
  local run_dir line run_count=0 run_index
  local -a run_pids=()
  run_dir=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/voxcmd-runs.XXXXXX")
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    "$@" "$line" >"$run_dir/$run_count" &
    run_pids+=("$!")
    run_count=$((run_count + 1))
  done
  # Only these runs: a bare wait would also wait on a caller's own background jobs.
  [ "${#run_pids[@]}" = 0 ] || wait "${run_pids[@]}" || true
  for ((run_index = 0; run_index < run_count; run_index++)); do cat "$run_dir/$run_index"; done
  rm -rf "$run_dir"
}

normalize() {
  local text="${1,,}"
  text="${text//\'/}"
  text=$(tr -c 'a-z0-9\n' ' ' <<<"$text" | tr -s ' ')
  text="${text#" "}"
  printf '%s' "${text%" "}"
}

apply_replacements() {
  local text=" $1 " file line spoken canonical
  for file in "$config_dir"/replacements.d/*; do
    [ -f "$file" ] || continue
    while IFS= read -r line || [ -n "$line" ]; do
      [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
      [[ "$line" == *=* ]] || continue
      spoken=$(normalize "${line%%=*}")
      canonical=$(normalize "${line#*=}")
      [ -n "$spoken" ] || continue
      text="${text// "$spoken" / "$canonical" }"
    done <"$file"
  done
  text="${text#" "}"
  printf '%s' "${text%" "}"
}

# Intents: the spoken forms of a verb that several integrations share, written {open}, {focus}, ... in a verb pattern.
# The verb only narrows what is meant and the noun after it decides, so one form may serve several intents ("start"
# opens an app, activates caffeine and starts a recording). intents.local appends forms of its own.
declare -A intents=(
  [open]="open|launch|start|bring up|pull up"
  [show]="show|display|open|bring up|pull up"
  [focus]="focus|go to|switch to|jump to|take me to"
  [activate]="activate|enter|turn on|switch on|enable|engage|start"
  [deactivate]="deactivate|exit|leave|turn off|switch off|disable|disengage|end"
  [close]="close|quit|kill"
  [set]="set|change|make|adjust"
  [start]="start|begin|kick off"
  [stop]="stop|end|finish"
)

# intents.local lines are "intent = form, form"; a name that is no intent yet declares one. Forms are normalized
# like the phrase, which also keeps regex syntax out of them.
load_local_intents() {
  local file="$config_dir/intents.local" line intent form
  [ -f "$file" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
    [[ "$line" == *=* ]] || continue
    intent=$(normalize "${line%%=*}")
    # Placeholders, not intents: an intent of that name would replace the placeholder.
    [[ "$intent" =~ ^[a-z0-9]+$ && "$intent" != target && "$intent" != number ]] || continue
    while IFS= read -r form; do
      form=$(normalize "$form")
      [ -z "$form" ] || intents[$intent]="${intents[$intent]:+${intents[$intent]}|}$form"
    done < <(tr ',' '\n' <<<"${line#*=}")
  done <"$file"
}

# The spoken forms of an intent, one per line, for integrations that rebuild phrases from them.
intent_forms() {
  local -a forms
  IFS='|' read -ra forms <<<"${intents[$1]-}"
  [ "${#forms[@]}" = 0 ] || printf '%s\n' "${forms[@]}"
}

# Turns a verb pattern into an anchored ERE and the capture group holding the target (0 when none).
# Bash ERE has no named or non-capturing groups, so the target group is found by counting the "(" before it. Intents
# expand first, each into one group of plain words, so that count includes theirs.
compile_pattern() {
  local pattern="^($1)\$" intent placeholder group_regex before opens
  for intent in "${!intents[@]}"; do
    pattern="${pattern//"{$intent}"/"(${intents[$intent]})"}"
  done
  for placeholder in '{target}' '{number}'; do
    [[ "$pattern" == *"$placeholder"* ]] || continue
    [ "$placeholder" = '{target}' ] && group_regex='(.+)' || group_regex='([0-9]+)'
    before="${pattern%%"$placeholder"*}"
    before="${before//\\(/}"
    opens="${before//[^(]/}"
    printf '%s\t%s\n' "${pattern/"$placeholder"/"$group_regex"}" "$((${#opens} + 1))"
    return
  done
  printf '%s\t0\n' "$pattern"
}

# Callers source each integration in its own subshell so their variables and functions never collide.
# A `declare` in a file sourced from a function is local to that function, so the arrays are copied out to globals.
load_integration() {
  unset -f candidates help_choices pick_box session_rewrite session_ended session_handle_turn session_control surface_open session_alive
  name="" confirm=0 fallback=0 silent=0 target_match=fuzzy help_action="" action_labels=1 pick_command="" private_labels=0
  # The mode settings load_mode_settings reads back, which shellcheck cannot see through ${!value}.
  # shellcheck disable=SC2034
  session_exit_phrases="" session_default_exits=1 session_allows_switches=0 session_exit_hint="" session_control_phrases=""
  # shellcheck disable=SC2034
  session_wake_at_end=0 session_private=0 session_open_ended=0 session_mode_idle_secs="" session_mode_max_secs=""
  # shellcheck disable=SC2034
  session_listen_silence_secs="" session_listen_max_secs="" session_listen_no_speech_secs=""
  local -a verbs=() examples=() confirm_labels=() match_ignore_words=() silent_actions=() force_prefixes=() session_miss_actions=() mode_actions=() free_text_actions=()
  local -A actions=() no_match_actions=() step_waits=()
  # shellcheck disable=SC1090
  source "$1"
  name="${name:-$(basename "$1" .sh)}"
  integration_verbs=("${verbs[@]}")
  integration_examples=("${examples[@]}")
  integration_confirm_labels=("${confirm_labels[@]}")
  integration_match_ignore_words=("${match_ignore_words[@]}")
  integration_silent_actions=("${silent_actions[@]}")
  integration_force_prefixes=("${force_prefixes[@]}")
  integration_session_miss_actions=("${session_miss_actions[@]}")
  # shellcheck disable=SC2034 # both read through a nameref in match_listed_actions
  integration_mode_actions=("${mode_actions[@]}") integration_free_text_actions=("${free_text_actions[@]}")
  declare -gA integration_actions=() integration_no_match_actions=() integration_step_waits=()
  local key
  for key in "${!actions[@]}"; do
    integration_actions[$key]="${actions[$key]}"
  done
  for key in "${!no_match_actions[@]}"; do
    integration_no_match_actions[$key]="${no_match_actions[$key]}"
  done
  for key in "${!step_waits[@]}"; do
    integration_step_waits[$key]="${step_waits[$key]}"
  done
}

# Prints the JSON match for the first verb of the loaded integration that matches the whole text, if any.
match_loaded_verbs() {
  local text="$1" file="$2" entry action pattern compiled regex group
  for entry in "${integration_verbs[@]}"; do
    read -r action pattern <<<"$entry"
    compiled=$(compile_pattern "$pattern")
    regex="${compiled%$'\t'*}"
    group="${compiled##*$'\t'}"
    if [[ "$text" =~ $regex ]]; then
      local target=""
      [ "$group" = 0 ] || target="${BASH_REMATCH[$group]}"
      jq -n -c --arg file "$file" --arg name "$name" --arg action "$action" --arg target "$target" \
        --argjson has_target "$([ "$group" = 0 ] && echo false || echo true)" \
        --argjson fallback "$([ "$fallback" = 1 ] && echo true || echo false)" \
        '{file: $file, name: $name, action: $action, target: $target, has_target: $has_target, fallback: $fallback}'
      return
    fi
  done
}

# Prints the JSON match for one integration, if it is of the tier ("normal" or "fallback") and a verb matches.
match_integration_verbs() {
  local text="$1" tier="$2" file="$3"
  (
    load_integration "$file"
    local integration_tier=normal
    [ "$fallback" != 1 ] || integration_tier=fallback
    [ "$integration_tier" = "$tier" ] || exit 0
    match_loaded_verbs "$text" "$file"
  )
}

# Prints one JSON match per integration of the tier.
match_verbs() {
  integration_files | for_each_line_in_parallel match_integration_verbs "$1" "$2"
}

# Prints "<file><TAB><rest of the text>" for the first integration whose force_prefixes starts the text.
forcing_integration() {
  local text="$1" file
  while IFS= read -r file; do
    (
      load_integration "$file"
      local prefix
      for prefix in "${integration_force_prefixes[@]}"; do
        prefix=$(normalize "$prefix")
        if [ -n "$prefix" ] && [[ "$text" == "$prefix "?* ]]; then
          printf '%s\t%s\n' "$file" "${text#"$prefix "}"
          exit 0
        fi
      done
      exit 1
    ) && return 0
  done < <(integration_files)
  return 1
}

# Prints the file of the first integration whose surface_open succeeds: a bar surface (the workspace overview) that is up
# and takes phrases before any other integration, so "close two" never reaches Apps. Only files that define one are loaded.
open_surface_file() {
  local file
  while IFS= read -r file; do
    if (
      load_integration "$file"
      surface_open
    ); then
      printf '%s\n' "$file"
      return 0
    fi
  done < <(grep -l '^surface_open()' "$config_dir"/integrations.d/*.sh 2>/dev/null || true)
  return 1
}

# Matches the text against one integration's verbs only, whatever its tier.
match_forced_verbs() {
  local text="$1" file="$2"
  (
    load_integration "$file"
    match_loaded_verbs "$text" "$file"
  )
}

# silent=1 covers every action of the integration, silent_actions only those listed.
action_is_silent() {
  [ "$silent" = 1 ] && return 0
  local silent_action
  for silent_action in "${integration_silent_actions[@]}"; do
    [ "$silent_action" = "$1" ] && return 0
  done
  return 1
}

# Expands one match into runnable options. A verb with a target placeholder whose integration prints candidates
# for the action (even an empty list) yields one option per candidate the target matches, possibly none,
# or, when it matches none and the integration maps the action in no_match_actions, that action with an empty id;
# otherwise the target text itself is the id.
resolve_match() {
  local match="$1" file action target has_target
  file=$(jq -r .file <<<"$match")
  action=$(jq -r .action <<<"$match")
  target=$(jq -r .target <<<"$match")
  has_target=$(jq -r .has_target <<<"$match")
  (
    load_integration "$file"
    local candidates_json="" options
    if [ "$has_target" = true ] && declare -F candidates >/dev/null; then
      candidates_json=$(candidates "$action" "$target" || true)
    fi
    if [ -z "$candidates_json" ]; then
      candidates_json="[]"
      options=$(jq -c -n --arg target "$target" '[{id: $target, label: $target}]')
    else
      candidates_json=$(jq -c 'map({id: (.id | tostring), label: (.label // .id | tostring)}
        + if .match_text then {match_text: (.match_text | tostring)} else {} end)' <<<"$candidates_json")
      if [ -z "$target" ]; then
        options="$candidates_json"
      elif [ "$target_match" = words ]; then
        options=$(word_match "$target" "$candidates_json" "${integration_match_ignore_words[@]}")
      else
        options=$(fuzzy_match "$target" "$candidates_json")
      fi
      # word_match prints nothing for a target of filler words only, which names nothing to report missing.
      if [ -n "$target" ] && [ -n "$options" ] && [ "$(jq length <<<"$options")" = 0 ] && [ -n "${integration_no_match_actions[$action]-}" ]; then
        action="${integration_no_match_actions[$action]}"
        options=$(jq -c -n --arg target "$target" '[{id: "", label: $target}]')
      fi
    fi
    runnable_options "$match" "$action" "$(jq length <<<"$candidates_json")" <<<"$options"
  )
}

# Prints one runnable option per {id, label} on stdin, as run_option takes it, for an action of the loaded
# integration; an entry's own .action overrides it.
runnable_options() {
  local match="$1" action="$2" candidate_count="$3" key commands
  local -a action_triples=()
  # One jq for all actions, passed as key, command, silent triples, rather than one per action: this runs for every
  # integration on every route and Voice Help.
  for key in "${!integration_actions[@]}"; do
    action_triples+=("$key" "${integration_actions[$key]}" "$(action_is_silent "$key" && echo true || echo false)")
  done
  commands=$(jq -n -c --args '$ARGS.positional as $triples
    | [range(0; $triples | length; 3) | {key: $triples[.], value: {command: $triples[. + 1], silent: ($triples[. + 2] == "true")}}]
    | from_entries' -- "${action_triples[@]}")
  jq -c --argjson match "$match" --arg action "$action" --argjson commands "$commands" --arg confirm "$confirm" \
    --argjson label_omits_action "$({ [ "${#integration_actions[@]}" = 1 ] || [ "$action_labels" = 0 ]; } && echo true || echo false)" \
    --argjson candidates "$candidate_count" --argjson private_labels "$([ "$private_labels" = 1 ] && echo true || echo false)" --args \
    '($ARGS.positional) as $confirm_labels | .[] | (.action // $action) as $action
      | $match + {action: $action, label_omits_action: $label_omits_action, id, label, command: ($commands[$action].command // ""),
          weak: (.weak // false), silent: ($commands[$action].silent // false), private_labels: $private_labels,
          confirm: ($confirm == "1" or (.label as $label | any($confirm_labels[]; . as $re | $label | test($re; "i")))),
          candidates: $candidates}' "${integration_confirm_labels[@]}"
}

# Candidates whose label (or match_text) is the target, else those containing it, else those fuzzy-matching it.
# Fuzzy matching alone lets a short target hit long labels by scattered letters, so substring matches win when
# there are any.
fuzzy_match() {
  local target="$1" candidates_json="$2" options fuzzy_mode
  options=$(jq -c --arg target "$target" 'map(select((.match_text // .label | ascii_downcase) == $target))' <<<"$candidates_json")
  for fuzzy_mode in --exact --no-exact; do
    [ "$(jq length <<<"$options")" = 0 ] || break
    options=$(jq -r 'to_entries[] | "\(.key)\t\(.value.match_text // .value.label)"' <<<"$candidates_json" |
      fzf --filter="$target" "$fuzzy_mode" --delimiter=$'\t' --nth=2.. |
      jq -R -s -c --argjson candidates "$candidates_json" 'split("\n") | map(select(. != "") | split("\t")[0] | tonumber | $candidates[.])')
  done
  printf '%s\n' "$options"
}

# Word matching for integrations with target_match=words, strict enough that stray speech matches nothing. Both
# sides drop filler and the integration's match_ignore_words, turn number words into digits and singularize. A
# target with the same words as a candidate (in any order, or the same letters run together, "full screen" for
# "fullscreen") is a strong match. Otherwise a target is a weak match when it covers at least half of a candidate's
# words with nothing left over, or holds all of them plus one more word; weak matches always go through the picker.
# A target with no words left after the filler and ignored words matches nothing, and prints nothing rather than [], so
# resolve_match can tell it from a target that matched nothing.
# With word_match_trace=1 (click-explain) it prints every candidate with its .verdict and whether it was .kept, instead
# of only the kept ones, from the same expressions the real match uses.
word_match() {
  local target="$1" candidates_json="$2"
  shift 2
  jq -c --arg target "$target" --argjson trace "${word_match_trace:-0}" --args '
    {"one": "1", "two": "2", "three": "3", "four": "4", "five": "5", "six": "6", "seven": "7", "eight": "8", "nine": "9", "ten": "10"} as $digits
    | ["the", "a", "an", "my", "this", "that", "please", "to", "of", "on", "in", "for", "it"] as $filler
    | def singular: if length > 3 and endswith("s") and (endswith("ss") | not) then .[:-1] else . end;
      ($filler + $ARGS.positional | map(ascii_downcase | singular)) as $ignored
    | def words: ascii_downcase | gsub("\u0027"; "") | [splits("[^a-z0-9]+") | select(. != "") | ($digits[.] // .) | singular]
        | map(select(IN($ignored[]) | not));
      # A spoken word names a candidate word when it is that word, or a long enough piece of a compound ("screen").
      def names($candidate_word): . as $spoken_word | $spoken_word == $candidate_word or ($spoken_word | length) >= 4 and ($candidate_word | contains($spoken_word));
      ($target | words) as $spoken
    | if $spoken == [] then empty else
        map(. as $candidate | ($candidate.match_text // $candidate.label | words) as $named
          | select($named != [])
          | ($spoken | map(select(. as $s | any($named[]; . as $n | $s | names($n))))) as $spoken_matched
          | ($named | map(select(. as $n | any($spoken[]; names($n))))) as $named_matched
          | (($spoken | unique) == ($named | unique) or ($spoken | join("")) == ($named | join(""))) as $strong
          | (($spoken_matched | length) == ($spoken | length) and ($named_matched | length) * 2 >= ($named | length)) as $covers_half
          | (all($named[]; IN($spoken[])) and ($spoken | length) - ($spoken_matched | length) <= 1) as $holds_all_plus_one
          | ($strong or $covers_half or $holds_all_plus_one) as $kept
          | $candidate + {weak: ($strong | not), kept: $kept,
              verdict: (if $strong then "strong: same words"
                elif $covers_half then "weak: the spoken words cover at least half of its \($named | length) word(s)"
                elif $holds_all_plus_one then "weak: holds every spoken word plus one more"
                elif ($spoken_matched | length) == 0 then "near miss only: no spoken word is in it"
                else "coverage under half: \($named_matched | length) of \($named | length) of its words are spoken" end),
              misses: (($named | length) - ($named_matched | length) + ($spoken | length) - ($spoken_matched | length))})
        | (map(select(.kept)) | any(.[]; .weak | not)) as $has_strong
        | if $trace == 1 then
            # The same ranking and cap as below, so the trace never calls a match kept that the real pick drops.
            (to_entries | map(select(.value.kept)) | sort_by(.value.misses, (.value.label | length)) | .[10:] | map(.key))
              as $past_cap
            | to_entries
            | map(.key as $index | .value
              | if .kept and .weak and $has_strong then .kept = false | .verdict = "dropped: a strong match exists"
                elif ($has_strong | not) and ($index | IN($past_cap[])) then
                  .kept = false | .verdict = "dropped: past the ten best weak matches"
                else . end
              | del(.misses))
          else
            map(select(.kept)) | if $has_strong then map(select(.weak | not)) else sort_by(.misses, (.label | length)) | .[:10] end
            | map(del(.misses, .kept, .verdict))
          end
      end' "$@" <<<"$candidates_json"
}

# Prints why "click <text>" would or would not click, by running click.sh's candidates() with tracing on. Read-only: it
# never routes, so nothing is clicked, moved, notified or logged, and the screen text only reaches this terminal.
click_explain() {
  local window_id="" file
  local -a words=()
  while [ $# -gt 0 ]; do
    case "$1" in
    --window)
      window_id="${2:-}"
      [ -n "$window_id" ] || {
        usage >&2
        exit 2
      }
      shift 2
      ;;
    *)
      words+=("$1")
      shift
      ;;
    esac
  done
  file="$config_dir/integrations.d/click.sh"
  if [ "${#words[@]}" = 0 ] || [ ! -f "$file" ]; then
    usage >&2
    exit 2
  fi
  (
    load_integration "$file"
    explain_click "${words[*]}" "$window_id"
  )
}

# ---- LLM hook (stub) -------------------------------------------------------------------------------------------
# Off unless VOXCMD_LLM_CMD is set; voxcmd itself never calls a model. When no normal integration has anything to
# run, the command gets JSON on stdin, {transcript, integrations: [{name, actions, verbs}]}, and must print
# {integration, action, target}. Its answer is resolved like a verb match, so candidates and confirmation still
# apply. Fallback integrations are tried only after it.
llm_match() {
  [ -n "${VOXCMD_LLM_CMD:-}" ] || return 0
  local transcript="$1" catalog file reply
  catalog=$(while IFS= read -r file; do
    (
      load_integration "$file"
      jq -n -c --arg file "$file" --arg name "$name" --args '{file: $file, name: $name, verbs: $ARGS.positional}' "${integration_verbs[@]}"
    )
  done < <(integration_files) | jq -s -c 'map({file, name, actions: [.verbs[] | split(" ")[0]], verbs: [.verbs[] | sub("^[^ ]+ +"; "")]})')
  reply=$(jq -n -c --arg transcript "$transcript" --argjson catalog "$catalog" \
    '{transcript: $transcript, integrations: [$catalog[] | {name, actions, verbs}]}' |
    sh -c "$VOXCMD_LLM_CMD") || return 0
  jq -c --argjson catalog "$catalog" \
    'first($catalog[] as $i | select($i.name == .integration and (.action | IN($i.actions[])))
      | {file: $i.file, name: $i.name, action, target: (.target // ""), has_target: ((.target // "") != "")}) // empty' <<<"$reply" 2>/dev/null || true
}
# ----------------------------------------------------------------------------------------------------------------

# An integration's only action says nothing the integration name doesn't ("Keybinds: run Terminal"), so the label
# shows just the candidate then ("Keybinds: Terminal"), as it does for an integration with action_labels=0, whose
# candidate labels already say what runs.
option_label() {
  jq -r 'if .label_omits_action and .label != "" then "\(.name): \(.label)"
    else "\(.name): \(.action | gsub("_"; " "))" + (if .label != "" and .label != .action then " \(.label)" else "" end) end' <<<"$1"
}

# The label without the integration's name, as a question: "Apps: close Slack window: Inbox" asks "Close Slack window:
# Inbox?". Its first word is the verb a spoken "close it" answers yes with.
confirm_question() {
  local option="$1" label="$2" name
  name=$(jq -r .name <<<"$option")
  label="${label#"$name: "}"
  printf '%s?' "${label^}"
}

run_option() {
  local option="$1" file command id target label output
  file=$(jq -r .file <<<"$option")
  command=$(jq -r .command <<<"$option")
  # shellcheck disable=SC2034 # id and target are read by the action's command
  id=$(jq -r .id <<<"$option")
  target=$(jq -r .target <<<"$option")
  label=$(option_label "$option")
  # Error toasts stay in the bar's history, and a private option's label (screen text) must not reach it, nor the debug log.
  local toast_label="$label"
  [ "$(jq -r .private_labels <<<"$option")" != true ] || toast_label=$(option_label "$(jq -c '.label = ""' <<<"$option")")
  step_label="$toast_label" step_detail=""
  if [ -z "$command" ]; then
    step_outcome=failed step_detail="has no command"
    [ "$in_sequence" = 1 ] || notify error "voxcmd error" "$toast_label has no command"
    return 1
  fi
  if [ "$(jq -r .confirm <<<"$option")" = true ]; then
    local question
    question=$(confirm_question "$option" "$label")
    local -a confirm_flags=(--verb "$(normalize "${question%% *}")")
    local listens=0
    ! reply_listen_wanted || listens=1
    [ "$listens" = 0 ] || confirm_flags+=(--listen)
    # Not the flags: --verb is the question's first word, which for a private label is screen text.
    debug "confirm asks: $(confirm_question "$option" "$toast_label")$([ "$listens" = 0 ] || echo ' (by voice)')"
    if ! "$voxcmd_confirm" "${confirm_flags[@]}" "$question"; then
      debug "confirm answered no: $toast_label not run"
      step_outcome=declined
      return 0
    fi
    debug "confirm answered yes: running $toast_label"
  fi
  if output=$(
    load_integration "$file"
    set +eu
    eval "$command" 2>&1
  ); then
    last_run_action=$(jq -r .action <<<"$option")
    last_step_option="$option"
    step_outcome=ran
    # A silent action's own effect (a bar popup it opens) is the feedback, which a toast would only cover.
    [ "$(jq -r .silent <<<"$option")" = true ] || notify info "voxcmd" "$label${output:+: $(tail -n 1 <<<"$output")}"
  else
    step_outcome=failed step_detail=$(tail -n 3 <<<"$output")
    [ "$in_sequence" = 1 ] || notify error "voxcmd failed" "$toast_label${output:+: $step_detail}"
    return 1
  fi
}

print_dry_run() {
  local transcript="$1" text="$2" options="$3" forced_file="${4:-}" count
  count=$(jq length <<<"$options")
  printf 'transcript:  %s\nnormalized:  %s\n' "$transcript" "$text"
  [ -z "$forced_file" ] || printf 'forced to:   %s\n' "$(basename "$forced_file")"
  if [ "$count" = 0 ]; then
    printf 'result:      no match\n'
  elif needs_pick "$options"; then
    printf 'result:      ask with the picker (%s options%s)\n' "$count" "$([ "$count" -gt 1 ] || echo ', weak match, listens for the reply when spoken')"
  else
    printf 'result:      run\n'
  fi
  jq -r 'to_entries[] | .key as $n | .value |
    "option \($n + 1):    \(.name) (\(.file | split("/") | last))\(if .fallback then " [fallback]" else "" end) action=\(.action) target=\(.target | @sh) id=\(.id | @sh) label=\(.label | @sh)",
    "             candidates offered: \(.candidates), weak: \(.weak), confirm: \(.confirm), silent: \(.silent)",
    "             command: \(.command)"' <<<"$options"
}

# Prints the picker command and the choices to give it, one per line, when every option comes from one integration that
# sets pick_command and its pick_box places each option on screen; else fails, and the text picker asks. pick_box prints
# "<left> <top> <width> <height>" in global logical pixels for an option id, and each choice gains it as `box`. More
# options than the picker has numbers for also fail, so the text picker lists them all.
integration_pick() {
  local options="$1" choices="$2" file max_options=10
  file=$(jq -r 'map(.file) | unique | if length == 1 then .[0] else empty end' <<<"$options")
  [ -n "$file" ] || return 1
  [ "$(jq length <<<"$options")" -le "$max_options" ] || return 1
  (
    load_integration "$file"
    [ -n "$pick_command" ] && declare -F pick_box >/dev/null || exit 1
    local command_path="$pick_command" boxes="" id box
    [[ "$command_path" == */* ]] || ! [ -x "$(dirname "$voxcmd_self")/$command_path" ] || command_path="$(dirname "$voxcmd_self")/$command_path"
    while IFS= read -r id; do
      box=$(pick_box "$id") || exit 1
      [[ "$box" != *$'\n'* ]] || exit 1
      boxes+="$box"$'\n'
    done < <(jq -r '.[].id' <<<"$options")
    printf '%s\n' "$command_path"
    # Fails on a box line that is not four numbers, or a line count that is not the choices', so no box shifts onto
    # another option.
    jq -c -R -s --argjson choices "$choices" '
      split("\n")[:-1] | map(split(" ") | map(tonumber)) as $boxes
      | if ($boxes | length) != ($choices | length) or any($boxes[]; length != 4) then error("bad boxes") else . end
      | [range(0; length) as $i | $choices[$i] + {box: $boxes[$i]}]' <<<"${boxes%$'\n'}"
  )
}

# A single option runs unless it is a weak match, which the user picks like any ambiguity.
needs_pick() {
  [ "$(jq 'length > 1 or any(.[]; .weak)' <<<"$1")" = true ]
}

resolve_matches() {
  for_each_line_in_parallel resolve_match <<<"$1" | jq -s -c .
}

# Phrases that open Voice Help before any integration is tried, so the keybinds fallback never takes them.
help_phrases='^(what can i say|voice help|show voice commands)$'

# Phrases that throw the command away silently, for a false start that still got recorded. A pending picker never
# sees them here: listen sends a recording made while it waits to reply, where "cancel" closes the picker.
discard_phrases='^(never ?mind|cancel|forget it|nothing)$'

# The wake word starts a command to the mode a voice session is in; outside a session it is only stripped, so "jarvis
# open firefox" is "open firefox". VOXCMD_WAKE_WORD is the one spelling voxtype's vocabulary teaches Whisper;
# VOXCMD_WAKE_ALIASES ("jarvas|jervis") adds the spellings it still produces. Whisper hears the default's "J" as "Ch"
# often enough that "charvis" is its alias unless the aliases are set.
wake_word="${VOXCMD_WAKE_WORD:-jarvis}"
if [ "$wake_word" = jarvis ]; then wake_aliases="${VOXCMD_WAKE_ALIASES-charvis}"; else wake_aliases="${VOXCMD_WAKE_ALIASES:-}"; fi
wake_regex=""
init_wake_regex() {
  [ -z "$wake_regex" ] || return 0
  local form
  while IFS= read -r form; do
    form=$(normalize "$form")
    [ -z "$form" ] || wake_regex+="${wake_regex:+|}$form"
  done < <(tr '|,' '\n' <<<"$wake_word|$wake_aliases")
  # A wake word that normalizes to nothing would match every transcript.
  [ -n "$wake_regex" ] || wake_regex="jarvis"
}

# split_leading_wake <normalized text>: succeeds when the text starts with the wake word, leaving the rest in wake_rest.
# An optional "hey" is dropped too: the wake listener starts a recording on "hey jarvis", and the phrase can reach the
# transcript when the recording opens before it ends.
wake_rest=""
split_leading_wake() {
  init_wake_regex
  [[ "$1" =~ ^(hey )?($wake_regex)( (.*))?$ ]] || return 1
  wake_rest="${BASH_REMATCH[4]}"
}

# split_trailing_wake <raw transcript>: succeeds when the transcript holds the wake word after something else, leaving
# what came before it as spoken in wake_before and what follows, normalized, in wake_rest. It takes the last one.
wake_before=""
split_trailing_wake() {
  init_wake_regex
  local transcript="$1" matched=1
  shopt -s nocasematch
  if [[ "$transcript" =~ ^(.*[^[:alnum:]])($wake_regex)[^[:alnum:]]+(.*)$ ]]; then
    wake_before="${BASH_REMATCH[1]}"
    wake_rest="${BASH_REMATCH[3]}"
    matched=0
  fi
  shopt -u nocasematch
  [ "$matched" = 0 ] || return 1
  wake_rest=$(normalize "$wake_rest")
  wake_before="${wake_before%"${wake_before##*[![:space:]]}"}"
  [ -n "$wake_before" ]
}

# A phrase starting with an integration's force prefix goes to that integration alone. Otherwise normal integrations
# go first, then the LLM hook, then fallback integrations, each only when the ones before it left nothing to run, so a
# catch-all fallback never competes with a real verb.
# Sets step_outcome. In a sequence it sends no no-match toast and does not open Voice Help: the sequence reports the
# step it stopped at.
route_step() {
  local transcript="$*" text options count choices picked forcing="" forced_file=""
  step_outcome=no_match
  # Global, not local: the integration contract promises it to candidates() and to every action.
  # shellcheck disable=SC2034 # read by integrations
  raw_transcript="$transcript"
  text=$(apply_replacements "$(normalize "$transcript")")
  if split_leading_wake "$text"; then
    text="$wake_rest"
    if [ -z "$text" ]; then
      if [ "$in_sequence" = 1 ]; then
        [ "$dry_run" != 1 ] || printf 'transcript:  %s\nnormalized:  %s\nresult:      no match, only the wake word\n' "$transcript" "$text"
      elif [ "$dry_run" != 1 ]; then
        notify info "voxcmd" "Say a command after \"$wake_word\""
      fi
      return 0
    fi
  fi
  if [[ "$text" =~ $help_phrases ]]; then
    if [ "$dry_run" = 1 ]; then
      if [ "$in_sequence" = 1 ]; then
        printf 'transcript:  %s\nnormalized:  %s\nresult:      no match, Voice Help is not opened inside a sequence\n' "$transcript" "$text"
      else
        printf 'transcript:  %s\nnormalized:  %s\nresult:      built-in, opens Voice Help\n' "$transcript" "$text"
        step_outcome=ran
      fi
    elif [ "$in_sequence" = 1 ]; then
      return 1
    else
      step_outcome=cancelled
      voice_help
    fi
    return
  fi
  if [[ "$text" =~ $discard_phrases ]]; then
    if [ "$dry_run" = 1 ]; then
      printf 'transcript:  %s\nnormalized:  %s\nresult:      built-in, discarded\n' "$transcript" "$text"
    fi
    step_outcome=discarded
    return 0
  fi
  if forcing=$(forcing_integration "$text"); then
    forced_file="${forcing%%$'\t'*}"
    options=$(resolve_matches "$(match_forced_verbs "${forcing#*$'\t'}" "$forced_file")")
  elif forced_file=$(open_surface_file) && options=$(resolve_matches "$(match_forced_verbs "$text" "$forced_file")") && [ "$(jq length <<<"$options")" != 0 ]; then
    : # the bar surface that is open took the phrase
  else
    forced_file=""
    options=$(resolve_matches "$(match_verbs "$text" normal)")
    [ "$(jq length <<<"$options")" != 0 ] || options=$(resolve_matches "$(llm_match "$text")")
    [ "$(jq length <<<"$options")" != 0 ] || options=$(resolve_matches "$(match_verbs "$text" fallback)")
  fi
  count=$(jq length <<<"$options")

  if [ "$dry_run" = 1 ]; then
    dry_run_options="$options"
    print_dry_run "$transcript" "$text" "$options" "$forced_file"
    [ "$count" = 0 ] || step_outcome=ran
    return 0
  fi
  if [ "$count" = 0 ]; then
    [ "$in_sequence" = 1 ] || notify_no_match "voxcmd: no match" "\"$transcript\""
    return 1
  elif ! needs_pick "$options"; then
    run_option "$(jq -c '.[0]' <<<"$options")"
  else
    choices=$(while IFS= read -r option; do
      jq -n -c --arg id "$(jq -r .index <<<"$option")" --arg label "$(option_label "$option")" '{id: $id, label: $label}'
    done < <(jq -c 'to_entries[] | .value + {index: .key}' <<<"$options") | jq -s -c .)
    # A single weak match asks only "this one?", so a spoken command gets its answer by voice too, as a confirmation does.
    # An integration's own picker (on-screen numbers) is always answered by voice, since the user is looking at it.
    local -a pick_flags=()
    local pick_command_path="$voxcmd_pick" pick_label="Which command?" hook
    if hook=$(integration_pick "$options" "$choices"); then
      pick_command_path="${hook%%$'\n'*}"
      choices="${hook#*$'\n'}"
      pick_label="Which one?"
      ! reply_listen_wanted || pick_flags+=(--listen)
    else
      # A turn of a voice session is answered by voice whatever the number of options, since nobody is at the keyboard.
      { [ "$count" != 1 ] && [ "$in_session_turn" != 1 ]; } || ! reply_listen_wanted || pick_flags+=(--listen)
    fi
    picked=$("$pick_command_path" "${pick_flags[@]}" "$pick_label" "$choices") || {
      step_outcome=cancelled
      return 0
    }
    run_option "$(jq -c --argjson i "$picked" '.[$i]' <<<"$options")"
  fi
}

# ---- Sequences: several steps in one phrase ---------------------------------------------------------------------

# "and then", or a comma before "then" (never a bare "then": "then" alone is ordinary speech). Matched in the raw
# transcript, where the comma still is. The edges are one non-word character or the string's end.
split_regex='((^|[^[:alnum:]])and[[:space:]]+then|,[[:space:]]*then)([^[:alnum:]]|$)'

# Whether the text holds a separator, in any case ("And then" opens a sentence), leaving it in BASH_REMATCH[0] as spoken.
has_split_separator() {
  local found=1
  shopt -s nocasematch
  if [[ "$1" =~ $split_regex ]]; then found=0; fi
  shopt -u nocasematch
  return "$found"
}

# Prints the text without the whitespace and the , ; . around it that the split leaves.
trim_step() {
  local text="$1"
  text="${text#"${text%%[![:space:],;.]*}"}"
  printf '%s' "${text%"${text##*[![:space:],;.]}"}"
}

# Prints the raw transcript without its leading wake word, else it unchanged.
strip_leading_wake_raw() {
  init_wake_regex
  local transcript="$1" stripped=""
  shopt -s nocasematch
  if [[ "$transcript" =~ ^[^[:alnum:]]*($wake_regex)([^[:alnum:]].*)?$ ]]; then
    stripped=$(trim_step "${BASH_REMATCH[2]}")
  fi
  shopt -u nocasematch
  printf '%s' "${stripped:-$transcript}"
}

# match_listed_actions <mode|free_text> <text> <integration file>: prints the match when the whole text is one of the
# integration's mode_actions or free_text_actions (verb only), nothing otherwise.
match_listed_actions() {
  local kind="$1" text="$2" file="$3" entry action allowed
  (
    load_integration "$file"
    local -n listed="integration_${kind}_actions"
    [ "${#listed[@]}" != 0 ] || exit 0
    local -a kept=()
    for entry in "${integration_verbs[@]}"; do
      read -r action _ <<<"$entry"
      for allowed in "${listed[@]}"; do
        [ "$action" != "$allowed" ] || kept+=("$entry")
      done
    done
    # shellcheck disable=SC2030 # match_loaded_verbs reads it in this subshell
    integration_verbs=("${kept[@]}")
    match_loaded_verbs "$text" "$file"
  )
}

# match_mode_action <text> <integration file>: prints the match when the whole text is one of the integration's
# mode_actions (its entries and exits), nothing otherwise.
match_mode_action() { match_listed_actions mode "$1" "$2"; }

match_free_text_action() { match_listed_actions free_text "$1" "$2"; }

# The normalized, replaced text of a step, without a leading wake word.
step_text() {
  local text
  text=$(apply_replacements "$(normalize "$1")")
  if split_leading_wake "$text"; then text="$wake_rest"; fi
  printf '%s' "$text"
}

# Whether the raw phrase is, from its start, an action that takes free text to the end (a timer's "remind me to ...",
# a calendar event's title), whose words may hold "and then".
phrase_starts_free_text_action() {
  [ -n "$(integration_files | for_each_line_in_parallel match_free_text_action "$(step_text "$1")")" ]
}

# split_phrase <raw transcript>: sets phrase_steps to the raw text of each step, phrase_free_text_step to the 1-based
# step that took the rest of the phrase as free text (0 when none). Reading stops one step past sequence_max_steps,
# which is enough to refuse the phrase. A phrase with no "and then" is one step, unchanged.
phrase_steps=() phrase_free_text_step=0
split_phrase() {
  local transcript="$1" rest step after separator
  phrase_steps=() phrase_free_text_step=0
  has_split_separator "$transcript" || {
    phrase_steps=("$transcript")
    return
  }
  rest=$(strip_leading_wake_raw "$transcript")
  while :; do
    [ "${#phrase_steps[@]}" -le "$sequence_max_steps" ] || break
    if ! has_split_separator "$rest"; then
      rest=$(trim_step "$rest")
      [ -z "$rest" ] || phrase_steps+=("$rest")
      break
    fi
    separator="${BASH_REMATCH[0]}"
    step=$(trim_step "${rest%%"$separator"*}")
    after="${rest#*"$separator"}"
    if [ -z "$(trim_step "$after")" ]; then
      [ -z "$step" ] || phrase_steps+=("$step")
      break
    fi
    if [ -n "$step" ] && phrase_starts_free_text_action "$rest"; then
      phrase_steps+=("$(trim_step "$rest")")
      phrase_free_text_step="${#phrase_steps[@]}"
      break
    fi
    [ -z "$step" ] || phrase_steps+=("$step")
    rest="$after"
  done
  [ "${#phrase_steps[@]}" != 0 ] || phrase_steps=("$transcript")
}

# Prints why the steps (as they will be routed) cannot run, nothing when they can. Checked before any runs.
sequence_refusal() {
  local total=$# index=0 step
  if [ "$total" -gt "$sequence_max_steps" ]; then
    echo "a phrase can have at most $sequence_max_steps steps"
    return
  fi
  for step; do
    index=$((index + 1))
    [ "$index" -lt "$total" ] || break
    if [ -n "$(integration_files | for_each_line_in_parallel match_mode_action "$(step_text "$step")")" ]; then
      echo "a mode switch can only be the last step (step $index of $total)"
      return
    fi
  done
}

# Bounded, because step waits poll it and poll_until cannot interrupt a condition that hangs on a stalled compositor.
active_window_address() {
  timeout 2 hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty' || true
}

# The overlay's and the popup's states in overlay_state and popup_state. A bar that does not answer reads as closed.
ui_read_state() {
  overlay_state=$(timeout 2 "$qs_ipc" call clickhints state 2>/dev/null) || overlay_state=closed
  popup_state=$(timeout 2 "$qs_ipc" call popup state 2>/dev/null) || popup_state=closed
}

# Nothing animates and no overlay waits on the user. A popup that stays open is not busy, unlike ui_is_busy.
ui_settled() {
  ui_read_state
  [ "$overlay_state" != open ] && ! [[ "$popup_state" =~ ^(opening|closing)( |$) ]]
}

# The named popup is fully drawn. No bar to ask counts as done: there is nothing to wait for.
popup_is_open() {
  local state
  state=$(timeout 2 "$qs_ipc" call popup state 2>/dev/null) || return 0
  [ "$state" = "open $1" ]
}

# Whether Stop Voice has flagged the running sequence.
sequence_stopped() {
  [ "$in_sequence" = 1 ] && [ -e "$(discard_flag_of $$)" ]
}

# The start time of a process, from /proc/<pid>/stat's 22nd field (past the command name, which may hold spaces).
process_start_time() {
  sed -e 's/^.*) //' "/proc/$1/stat" 2>/dev/null | cut -d' ' -f20
}

# Prints the PID of each sequence running now. A file whose process is gone, or is another one with a recycled PID (its
# start time differs), is stale and removed.
running_sequence_pids() {
  local file pid start
  for file in "$sequence_dir"/*.json; do
    [ -e "$file" ] || continue
    read -r pid start < <(jq -r '"\(.pid // "") \(.start // "")"' "$file" 2>/dev/null) || true
    if [ -n "${pid:-}" ] && [ "$(process_start_time "$pid")" = "${start:-}" ]; then
      printf '%s\n' "$pid"
    else
      rm -f "$file"
    fi
  done
}

# Waits for the step just run: the condition its action declares in step_waits, else the bar settling and a moment for
# the app. Fails with 1 on timeout and 2 when Stop Voice flagged the sequence.
wait_for_step() {
  [ -n "$last_step_option" ] || return 0
  local option="$last_step_option" status=0
  (
    load_integration "$(jq -r .file <<<"$option")"
    # shellcheck disable=SC2034 # read by the wait condition
    id=$(jq -r .id <<<"$option") target=$(jq -r .target <<<"$option")
    condition="${integration_step_waits[$(jq -r .action <<<"$option")]-}"
    if [ -n "$condition" ]; then
      set +eu
      poll_until "$step_timeout_secs" eval "$condition"
    else
      poll_until "$step_timeout_secs" ui_settled && sleep "$app_settle_secs"
    fi
  ) || status=$?
  return "$status"
}

# What the wait after the option would be, for the dry run.
describe_wait() {
  local option="$1" condition
  (
    load_integration "$(jq -r .file <<<"$option")"
    condition="${integration_step_waits[$(jq -r .action <<<"$option")]-}"
    if [ -n "$condition" ]; then
      printf '%s' "$condition"
    else
      printf 'no popup opening or closing and no click overlay, then %ss' "$app_settle_secs"
    fi
  )
}

# Tells why the sequence stopped at step <index> of <total>. Silent after Stop Voice, which is its own answer.
report_sequence_stop() {
  local index="$1" total="$2" step="$3" left=$(($2 - $1)) more=""
  local summary="voxcmd: stopped at step $index of $total"
  [ "$left" = 0 ] || more=$'\n'"$left more step$([ "$left" = 1 ] || echo s) not run"
  if sequence_stopped || [ "$step_outcome" = discarded ]; then
    debug "sequence: ended without a toast at step $index of $total (stop or discard)"
    return
  fi
  debug "sequence: step $index of $total $step_outcome"
  case "$step_outcome" in
  no_match)
    if [ "$phrase_free_text_step" = "$index" ]; then
      notify_no_match "$summary" "no match$more"
    else
      notify_no_match "$summary" "no match for \"$step\"$more"
    fi
    ;;
  declined) notify info "voxcmd" "Stopped at step $index of $total: not confirmed$more" ;;
  cancelled) notify info "voxcmd" "Stopped at step $index of $total: cancelled$more" ;;
  timed_out) notify error "$summary" "${step_label:-step $index}: timed out after ${step_timeout_secs}s$more" ;;
  *) notify error "$summary" "${step_label:-step $index}${step_detail:+: $step_detail}$more" ;;
  esac
}

# Runs the steps in order, each routed only after the one before finished and what it started has settled. The first
# step that does not run stops the rest. Fails when no step ran.
run_sequence() {
  local total=$# index=0 step ran=0 wait_status
  in_sequence=1
  local own_file="$sequence_dir/$$.json"
  mkdir -p "$sequence_dir"
  jq -n -c --argjson pid "$$" --arg start "$(process_start_time $$)" '{pid: $pid, start: $start}' >"$own_file"
  # A watcher has an exit trap of its own, which runs this function to its end anyway. The path is expanded now: the
  # trap runs after this function has returned, when own_file is out of scope and unbound under set -u.
  # shellcheck disable=SC2064
  [ -n "$(trap -p EXIT)" ] || trap "rm -f '$own_file'" EXIT
  for step; do
    index=$((index + 1))
    if sequence_stopped; then
      step_outcome=discarded
      break
    fi
    debug "sequence: step $index of $total"
    # shellcheck disable=SC2034 # read by step_waits conditions
    active_before=$(active_window_address)
    last_step_option="" step_label="" step_detail=""
    route_step "$step" || true
    [ "$step_outcome" = ran ] || break
    ran=$((ran + 1))
    if [ "$index" -lt "$total" ]; then
      wait_status=0
      wait_for_step || wait_status=$?
      if [ "$wait_status" = 1 ]; then
        step_outcome=timed_out
        break
      elif [ "$wait_status" != 0 ]; then
        step_outcome=discarded
        break
      fi
    fi
  done
  if [ "$step_outcome" != ran ]; then report_sequence_stop "$index" "$total" "$step"; fi
  in_sequence=0
  rm -f "$own_file"
  # A watcher's flag also discards its recording, and its exit removes it.
  [ "$in_watcher" = 1 ] || rm -f "$(discard_flag_of $$)"
  [ "$ran" -gt 0 ]
}

# The dry run of a sequence: each step's route, what it would wait for, and where a free-text action took the rest.
dry_run_sequence() {
  local total=$# index=0 step
  printf 'sequence:    %s steps\n' "$total"
  # As in a real run, so a Voice Help step and a wake word alone are no match.
  in_sequence=1
  for step; do
    index=$((index + 1))
    printf 'step %s of %s\n' "$index" "$total"
    dry_run_options="[]"
    route_step "$step"
    if [ "$phrase_free_text_step" = "$index" ]; then
      printf 'note:        a free-text action takes the rest of the phrase\n'
    fi
    [ "$step_outcome" = ran ] || break
    if [ "$index" = "$total" ]; then
      printf 'waits for:   nothing, it is the last step\n'
    elif [ "$(jq length <<<"$dry_run_options")" = 0 ]; then
      printf 'waits for:   nothing, the step does not match\n'
    elif needs_pick "$dry_run_options"; then
      printf 'waits for:   whatever the picked option waits for\n'
    else
      printf 'waits for:   %s\n' "$(describe_wait "$(jq -c '.[0]' <<<"$dry_run_options")")"
    fi
  done
  in_sequence=0
}

# route_steps <phrase...>: routes each as a step of one sequence, in order. The steps are raw phrases, or what a
# mode's session_rewrite made of them.
route_steps() {
  local refusal count="$#"
  refusal=$(sequence_refusal "$@")
  if [ -n "$refusal" ]; then
    [ "$count" -le "$sequence_max_steps" ] || count="more than $sequence_max_steps"
    if [ "$dry_run" = 1 ]; then
      printf 'sequence:    %s steps\nresult:      refused, %s\n' "$count" "$refusal"
    else
      notify info "voxcmd" "Nothing ran: $refusal"
    fi
    step_outcome=no_match
    [ "$dry_run" != 1 ] || return 0
    return 1
  fi
  if [ "$dry_run" = 1 ]; then
    dry_run_sequence "$@"
  else
    run_sequence "$@"
  fi
}

# One spoken phrase: one command, or several steps joined by "and then" (or a comma and "then") run in order. Every
# caller routes through here; route_step takes one step.
route() {
  split_phrase "$*"
  if [ "${#phrase_steps[@]}" = 1 ]; then
    route_step "${phrase_steps[0]}"
  else
    route_steps "${phrase_steps[@]}"
  fi
}

# ----------------------------------------------------------------------------------------------------------------

# The replacements are quoted because bash 5.2 reads an unquoted & there as the matched text.
markup_escape() {
  local text="${1//&/"&amp;"}"
  text="${text//</"&lt;"}"
  printf '%s' "${text//>/"&gt;"}"
}

# Prints one integration's Voice Help group: its examples and what Tab lists for it.
help_group() {
  local file="$1"
  (
    load_integration "$file"
    # On stdin: a keybinds list is too long for an argument.
    help_runnables "$file" | jq -c --arg file "$file" --arg name "$name" \
      --argjson fallback "$([ "$fallback" = 1 ] && echo true || echo false)" --args \
      '{key: ($file | split("/") | last | rtrimstr(".sh")), name: $name, fallback: $fallback, examples: $ARGS.positional, runnables: .}' \
      "${integration_examples[@]}"
  )
}

# Every integration's example phrases in the picker, grouped by integration with the fallbacks last. A phrase
# without placeholders runs as if spoken; one with a <placeholder> cannot be completed from a click, so it is
# shown as a notification to say instead. Tab on an integration that lists its help choices shows them, and picking
# one runs it like a spoken match would. Picked ids are "say:<phrase>" or "run:<index into the runnable options>".
example_placeholder='<[^>]+>'
voice_help() {
  local groups choices expansions runnables picked
  groups=$(integration_files | for_each_line_in_parallel help_group |
    jq -s -c 'sort_by(.fallback) | map(select(.examples != [] or .runnables != []))')
  if [ "$(jq 'map(.examples[]) | length' <<<"$groups")" = 0 ]; then
    notify info "voxcmd" "No integration declares examples"
    return 1
  fi
  runnables=$(jq -c 'map(.runnables[])' <<<"$groups")
  choices=$(jq -c 'map(. as $group | .examples[]
    | {id: "say:\(.)", label: "\($group.name): \(.)"} + if $group.runnables != [] then {expand: $group.key} else {} end)' <<<"$groups")
  # A run: id indexes $runnables, every group's runnables in group order, so each group's ids start past the ones before.
  expansions=$(jq -c '(map(.runnables | length) | [foreach .[] as $count (0; . + $count)] | [0] + .) as $first_run_index
    | to_entries | map(select(.value.runnables != []) | .key as $group_index | .value
      | {key, value: {title: .name, choices: (.runnables | to_entries | map({id: "run:\(.key + $first_run_index[$group_index])", label: .value.label}))}})
    | from_entries' <<<"$groups")
  picked=$("$voxcmd_pick" "Voice Help" "$choices" "$expansions") || return 0
  case "$picked" in
  run:*) run_option "$(jq -c --argjson i "${picked#run:}" '.[$i]' <<<"$runnables")" ;;
  *)
    picked="${picked#say:}"
    if [[ "$picked" =~ $example_placeholder ]]; then
      # Notification bodies are markup, which would swallow the placeholder as a tag.
      notify info "voxcmd" "Say: $(markup_escape "$picked")"
    else
      route "$picked"
    fi
    ;;
  esac
}

# Prints the runnable options Tab shows in Voice Help for the loaded integration, [] when it lists none:
# help_choices, else the candidates of help_action. An entry's own action overrides help_action. The target is the
# label, what saying the entry would have captured, for actions that read it.
help_runnables() {
  local file="$1" listed=""
  if declare -F help_choices >/dev/null; then
    listed=$(help_choices || true)
  elif [ -n "$help_action" ] && declare -F candidates >/dev/null; then
    listed=$(candidates "$help_action" "" || true)
  fi
  listed=$(jq -c --arg action "$help_action" 'if type == "array" then . else [] end
    | map({id: (.id | tostring), label: (.label // .id | tostring), action: (.action // $action)} | select(.action != ""))' \
    <<<"${listed:-[]}" 2>/dev/null) || listed='[]'
  runnable_options "$(jq -n -c --arg file "$file" --arg name "$name" '{file: $file, name: $name, fallback: false, has_target: true}')" \
    "$help_action" "$(jq length <<<"$listed")" <<<"$listed" | jq -s -c 'map(. + {target: .label})'
}

# ---- Voice replies to an open picker ----------------------------------------------------------------------------

# Whether a picker or card opened now should record the user's reply: the command was spoken, and Stop has not
# discarded this watcher's turn since (an action already routing still finishes, but nothing it opens listens).
reply_listen_wanted() {
  [ "$came_by_voice" = 1 ] && [ ! -e "$(discard_flag_of $$)" ]
}

# Prints the pending pick's state while its voxcmd-pick, voxcmd-confirm or voxcmd-hints still waits on its FIFO. A stale file is
# left alone: a new pick may be about to replace it.
pending_pick() {
  local state pid fifo
  state=$(cat "$pending_pick_file" 2>/dev/null) || return 1
  pid=$(jq -r '.pid // empty' <<<"$state" 2>/dev/null) || return 1
  fifo=$(jq -r '.fifo // empty' <<<"$state" 2>/dev/null) || return 1
  [ -n "$pid" ] && [ -p "$fifo" ] && grep -qsE 'voxcmd-(pick|confirm|hints)' "/proc/$pid/cmdline" || return 1
  printf '%s' "$state"
}

# Whether the pick in $1 (a pending_pick's state) is still the one waiting: Stop may have cancelled it since.
pick_still_pending() {
  local now
  now=$(pending_pick) || return 1
  [ "$(jq -r '[.pid, .fifo] | @tsv' <<<"$now")" = "$(jq -r '[.pid, .fifo] | @tsv' <<<"$1")" ]
}

# Prints the 1-based position an ordinal reply names ("two", "the second one", "number 3", "last"), else nothing.
ordinal_position() {
  local text="$1" count="$2" word
  [[ "$text" =~ ^((pick|choose|select|take|use|go with|the|number|option|choice|item|entry) )*([a-z0-9]+)( one)?$ ]] || return 0
  word="${BASH_REMATCH[3]}"
  case "$word" in
  one | first | 1st) echo 1 ;;
  two | second | 2nd) echo 2 ;;
  three | third | 3rd) echo 3 ;;
  four | fourth) echo 4 ;;
  five | fifth) echo 5 ;;
  six | sixth) echo 6 ;;
  seven | seventh) echo 7 ;;
  eight | eighth) echo 8 ;;
  nine | ninth) echo 9 ;;
  ten | tenth) echo 10 ;;
  last) echo "$count" ;;
  *) if [[ "$word" =~ ^([0-9]+)(st|nd|rd|th)?$ ]]; then echo "$((10#${BASH_REMATCH[1]}))"; fi ;;
  esac
}

# Prints the lines of spoken_labels ("<displayed label><TAB><normalized label>") whose label shares the most words
# with the reply, none when it shares none. Words are compared by stem, so "locked" names "Lock" and "closing" names
# "Close", and the reply's other words do not count against a label: a reply to "Lock (System)" may say "lock
# computer" or "lock it", and needs no "system".
labels_sharing_most_words() {
  local text="$1" spoken_labels="$2"
  jq -R -s -r --arg text "$text" '
    ["the", "a", "an", "my", "this", "that", "it", "one", "please", "to", "of", "on", "in", "for",
      "pick", "choose", "select", "take", "use", "go", "with", "do", "run"] as $filler
    | def stem: if length > 5 and endswith("ing") then .[:-3]
        elif length > 4 and (endswith("ed") or endswith("es")) then .[:-2]
        elif length > 3 and endswith("s") and (endswith("ss") | not) then .[:-1]
        else . end
        | if length > 3 and endswith("e") then .[:-1] else . end;
      def stems: [splits(" ") | select(. != "" and (IN($filler[]) | not)) | stem] | unique;
      ($text | stems) as $spoken
    | [split("\n")[] | select(. != "") | . as $line | split("\t")[1]
        | {line: $line, shared: (stems | map(select(IN($spoken[]))) | length)}]
    | (map(.shared) | max // 0) as $most
    | if $most == 0 then empty else .[] | select(.shared == $most) | .line end' <<<"$spoken_labels"
}

# Replies that take or turn down the only choice without naming it: a picker with one choice (a weak match's) only
# asks whether that is the one meant.
single_choice_yes='^(yes|yeah|yep|yup|sure|okay|ok|do it|go ahead|(that|this)( one)?|thats it|thats the one)( please)?$'
single_choice_no='^(no|nope|nah|dont|do not)( thanks| thank you)?$'

# Prints the 1-based position of the choice a direction reply names ("the top one", "leftmost"), by the choices' boxes
# ([left, top, width, height]); nothing when the text names no direction or a choice has no box. The extreme is of the
# box's edge, so items in a column or row line up however wide or tall they are; edges within half the smallest box
# height of the extreme tie, and a vertical tie goes to the leftmost, a horizontal one to the topmost.
direction_position() {
  local text="$1" choices="$2" direction
  [[ "$text" =~ ^((pick|choose|select|take|use|go with|the) )*(top|upper|bottom|lower|left|right)(most)?( one)?$ ]] || return 0
  case "${BASH_REMATCH[3]}" in
  top | upper) direction=top ;;
  bottom | lower) direction=bottom ;;
  *) direction="${BASH_REMATCH[3]}" ;;
  esac
  jq -r --arg direction "$direction" '
    if all(.[]; .box | type == "array" and length == 4) | not then empty else
      to_entries | map({n: (.key + 1), left: .value.box[0], top: .value.box[1], right: (.value.box[0] + .value.box[2]), bottom: (.value.box[1] + .value.box[3]), height: .value.box[3]}) as $boxes
      | (($boxes | map(.height) | min) / 2) as $tolerance
      | ({top: "top", bottom: "bottom", left: "left", right: "right"}[$direction]) as $edge
      | (if $direction == "top" or $direction == "left" then (-1) else 1 end) as $sign
      | ($boxes | map(.[$edge] * $sign) | max) as $extreme
      | $boxes | map(select(.[$edge] * $sign >= $extreme - $tolerance))
      | sort_by(if $direction == "top" or $direction == "bottom" then [.left, .top] else [.top, .left] end)
      | .[0].n
    end' <<<"$choices"
}

# Prints "cancel", "pick<TAB><displayed label>", or "unclear<TAB><why>" for a normalized reply. Labels match like
# candidate targets: exact, then by the words they share with the reply, then substring, then fuzzy, and only a
# single hit counts. Shared words that tie are left for the substring and fuzzy passes to settle.
match_reply() {
  local text="$1" choices="$2" count position spoken_labels hits word_hits="" fuzzy_mode
  count=$(jq length <<<"$choices")
  if [[ "$text" =~ ^(cancel|never ?mind|none( of (them|these|those))?|nothing|forget it)$ ]] ||
    { [ "$count" = 1 ] && [[ "$text" =~ $single_choice_no ]]; }; then
    echo cancel
    return
  fi
  position=$(ordinal_position "$text" "$count")
  [ -n "$position" ] || position=$(direction_position "$text" "$choices")
  if [ -n "$position" ]; then
    if [ "$position" -ge 1 ] && [ "$position" -le "$count" ]; then
      printf 'pick\t%s\n' "$(jq -r --argjson i "$((position - 1))" '.[$i].label' <<<"$choices")"
    else
      printf 'unclear\tthere are only %s choices\n' "$count"
    fi
    return
  fi
  # displayed label <TAB> label without its number, normalized like the reply
  spoken_labels=$(jq -r '.[].label' <<<"$choices" | while IFS= read -r label; do
    printf '%s\t%s\n' "$label" "$(normalize "${label#*. }")"
  done)
  hits=$(awk -F'\t' -v text="$text" '$2 == text' <<<"$spoken_labels")
  if [ -z "$hits" ] && [ "$count" = 1 ] && [[ "$text" =~ $single_choice_yes ]]; then hits="$spoken_labels"; fi
  if [ -z "$hits" ]; then
    word_hits=$(labels_sharing_most_words "$text" "$spoken_labels")
    [ "$(grep -c . <<<"$word_hits")" != 1 ] || hits="$word_hits"
  fi
  for fuzzy_mode in --exact --no-exact; do
    [ -z "$hits" ] || break
    hits=$(fzf --filter="$text" "$fuzzy_mode" --delimiter=$'\t' --nth=2 <<<"$spoken_labels" || true)
  done
  [ -n "$hits" ] || hits="$word_hits"
  case "$(grep -c . <<<"$hits")" in
  0) printf 'unclear\tno choice matches\n' ;;
  1) printf 'pick\t%s\n' "${hits%%$'\t'*}" ;;
  *) printf 'unclear\t%s choices match\n' "$(grep -c . <<<"$hits")" ;;
  esac
}

# Prints "yes", "no" or "unclear<TAB><why>" for a normalized reply to a yes/no question, given the question's verb.
# A no word anywhere wins, so a mixed "yeah never mind" is the safe answer. Otherwise a reply leading with a yes word
# or the verb ("close it", "close slack") is a yes. Normalizing drops the apostrophe, so "don't" arrives as "dont".
confirm_no_words='(^| )(no|nope|nah|dont|do not|cancel|never ?mind|stop|forget it|leave it)( |$)'
confirm_yes_words='^(yes|yeah|yep|yup|sure|okay|ok|confirm|do it|go ahead)( |$)'
match_confirm_reply() {
  local text="$1" verb="${2:-}"
  if [[ "$text" =~ $confirm_no_words ]]; then
    echo no
  elif [[ "$text" =~ $confirm_yes_words ]] || { [ -n "$verb" ] && [[ "$text" =~ ^"$verb"( |$) ]]; }; then
    echo yes
  else
    printf 'unclear\tnot a yes or no\n'
  fi
}

# Answers the open voxcmd-pick or voxcmd-hints as if the choice had been picked in it, or the open voxcmd-confirm; each
# then closes its picker or card. voxcmd-hints reads the displayed label's number.
reply() {
  local transcript="$*" text state verdict shown_list_key shown_list
  text=$(apply_replacements "$(normalize "$transcript")")
  if ! state=$(pending_pick); then
    notify info "voxcmd" "No picker is waiting for a reply"
    return 1
  fi
  if [ "$(jq -r '.kind // empty' <<<"$state")" = confirm ]; then
    reply_confirm "$transcript" "$text" "$state"
    return
  fi
  # The list on screen: the top level, or the expansion Tab opened, whose picks go back prefixed with its key.
  shown_list_key=$(cat "$(jq -r '.view // empty' <<<"$state")" 2>/dev/null) || shown_list_key=""
  shown_list_key=$(jq -r --arg key "$shown_list_key" 'if $key != "" and (.expansions // {})[$key] then $key else "" end' <<<"$state")
  shown_list=$(jq -c --arg key "$shown_list_key" 'if $key != "" then .expansions[$key] else {title: "", choices} end' <<<"$state")
  verdict=$(match_reply "$text" "$(jq -c .choices <<<"$shown_list")")
  if [ "$dry_run" = 1 ]; then
    printf 'transcript:  %s\nnormalized:  %s\npicker:      %s\nresult:      %s\n' \
      "$transcript" "$text" "$(jq -r .label <<<"$state")${shown_list_key:+ > $(jq -r .title <<<"$shown_list")}" "${verdict/$'\t'/: }"
    return 0
  fi
  case "$verdict" in
  unclear*)
    # Only a picker that listens for its reply (voxcmd-hints) leaves a listen_again file; one rm of it succeeds, so
    # one unclear reply gets the extra listen.
    local listen_again
    listen_again=$(jq -r '.listen_again // empty' <<<"$state")
    if [ -n "$listen_again" ] && rm "$listen_again" 2>/dev/null; then
      notify info "voxcmd: which one?" "\"$transcript\": ${verdict#*$'\t'}. Listening again."
      ! pick_still_pending "$state" || listen --start-only
    else
      notify info "voxcmd: which one?" "\"$transcript\": ${verdict#*$'\t'}. Say a choice, a number, or cancel."
    fi
    return 1
    ;;
  esac
  local answer=""
  [ "$verdict" = cancel ] || answer="${shown_list_key:+$shown_list_key$'\t'}${verdict#*$'\t'}"
  write_pick_answer "$answer" "$(jq -r .fifo <<<"$state")"
}

# An empty answer reads as a cancel, like Esc. The timeout covers a voxcmd-pick, -confirm or -hints that exits between
# the check for it and this write.
write_pick_answer() {
  # shellcheck disable=SC2016 # expanded by the inner sh
  timeout 2 sh -c 'printf "%s\n" "$1" >"$2"' sh "$1" "$2"
}

# An unclear reply leaves the card open and, while voxcmd-confirm left a listen_again file, listens once more.
reply_confirm() {
  local transcript="$1" text="$2" state="$3" verdict listen_again
  verdict=$(match_confirm_reply "$text" "$(jq -r '.verb // empty' <<<"$state")")
  debug "confirm reply \"$transcript\" ($text): ${verdict%%$'\t'*}"
  if [ "$dry_run" = 1 ]; then
    printf 'transcript:  %s\nnormalized:  %s\nconfirm:     %s\nresult:      %s\n' \
      "$transcript" "$text" "$(jq -r .label <<<"$state")" "${verdict/$'\t'/: }"
    return 0
  fi
  case "$verdict" in
  unclear*)
    listen_again=$(jq -r '.listen_again // empty' <<<"$state")
    # Only one rm of the file succeeds, so only one unclear reply gets the extra listen.
    if [ -n "$listen_again" ] && rm "$listen_again" 2>/dev/null; then
      notify info "voxcmd: yes or no?" "\"$transcript\": listening again"
      ! pick_still_pending "$state" || listen --start-only
    else
      notify info "voxcmd: yes or no?" "\"$transcript\": say yes or no, or press y or n."
    fi
    return 1
    ;;
  esac
  # voxcmd-confirm reads anything but "yes" as a no.
  if write_pick_answer "$verdict" "$(jq -r .fifo <<<"$state")"; then
    debug "confirm reply written: $verdict"
  else
    debug "confirm reply not written: nobody read the FIFO"
  fi
}
# ----------------------------------------------------------------------------------------------------------------

# ---- Voice sessions ---------------------------------------------------------------------------------------------
# A session keeps the microphone re-opening for one more spoken turn after each one, so a run of related commands
# (click mode's targets, rapid mode's commands, type mode's dictation) needs no repeated verb. The session is a stack of
# modes: the integration that opens one supplies session_rewrite, which turns a turn's words into the phrase to route (or
# session_handle_turn, which takes the words itself), and a mode opened inside another returns to it when it ends. Every
# way out clears the state the bar's indicator reads: an exit word, a listen that hears nothing, a few unusable turns in a
# row, the turn and time caps, a failed listen, and a watcher that dies mid-session.
#
# The watcher hearing a turn, a voice key pressed meanwhile and `end-session` all change the state, so every change
# holds session_lock_file. The owner is the watcher that hears the next turn; a listen started by the voice key during a
# turn takes it over, and the turn's watcher then leaves the session to it.

# Only phrases nobody would click: "cancel", "exit", "stop" and "never mind" are button labels, so they are targets. The
# open mode's integration adds its own as session_exit_phrases.
session_exit_words='^(done|im done|thats all)$'
# After the wake word, "stop" ends the whole session as the Stop Voice key does.
session_stop_words='^(stop|stop listening|stop everything|end session|end the session)$'
# A turn is a whole thought and the user is reading the screen first, so longer than a command's default.
session_no_speech_secs="${VOXCMD_SESSION_NO_SPEECH_SECS:-10}"
# A session listens unprompted, mostly to the room, so it wants more speech and a longer pause than a command before it
# stops: a few knocks or a breath otherwise end a turn whose noise the transcriber then turns into words.
session_min_speech_secs="${VOXCMD_SESSION_MIN_SPEECH_SECS:-0.4}"
session_silence_secs="${VOXCMD_SESSION_SILENCE_SECS:-1.5}"
# A reply to a picker or confirm card is often one short word ("yes", "two", "cancel"), and the user is looking at the
# question, so a little speech then the usual pause is an answer.
reply_min_speech_secs="${VOXCMD_REPLY_MIN_SPEECH_SECS:-0.1}"
# Whisper's stock output for silence and noise, normalized (before replacements). A session turn that hears only one of these heard nothing,
# so it listens again without counting toward the unclear cap; the turn and time caps still bound it.
# voxtype-daemon puts "Voice commands start with <wake word>." in Whisper's prompt, and Whisper can echo it on silence.
session_noise_transcripts="^(|you|bye|the end|thank you|thank you for watching|thanks for watching|blank audio|$(normalize "Voice commands start with $wake_word"))\$"
session_unclear_cap=3
# Turns that keep doing something never trip the unclear cap, so a session also ends after this long or this many.
session_max_secs="${VOXCMD_SESSION_MAX_SECS:-300}"
session_max_turns="${VOXCMD_SESSION_MAX_TURNS:-40}"
ui_settle_max_secs="${VOXCMD_UI_SETTLE_MAX_SECS:-2}"
app_settle_secs="${VOXCMD_APP_SETTLE_SECS:-0.3}"
ui_settle_poll_secs=$(scaled_secs 0.1)
session_lock_file="$runtime_dir/session.lock"
# Set by run_option, so a session can tell what its turn ran.
last_run_action=""
# What the watcher's recording was heard in (session_mode_token) and whether that mode keeps its words private.
heard_mode=""
heard_private=0

# session_locked <command...>: runs it holding the session lock, in a subshell, so its variable changes do not survive.
# Inside, a nested call runs directly: flock on a second descriptor of the same file would wait for itself. Anything
# long-lived started in there must close fd 9, or it keeps the lock.
session_locked() {
  if [ "${session_lock_held:-0}" = 1 ]; then
    "$@"
    return
  fi
  mkdir -p "$runtime_dir"
  (
    flock 9
    session_lock_held=1
    "$@"
  ) 9>"$session_lock_file"
}

# Prints field 22 of /proc/<pid>/stat, the start time in clock ticks since boot. With the PID it names one process
# even after the PID is reused. Fields are counted after the last ")", since the command name may hold spaces.
process_start_time() {
  local stat
  local -a fields
  stat=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
  read -ra fields <<<"${stat##*) }"
  printf '%s' "${fields[19]}"
}

# Prints the open session's state; fails (and clears the file) when none is open or its owner has died.
session_state() { session_locked session_state_locked; }
session_state_locked() {
  local state owner owner_start
  state=$(cat "$session_file" 2>/dev/null) || return 1
  read -r owner owner_start < <(jq -r '"\(.owner // "") \(.owner_start // "")"' <<<"$state" 2>/dev/null)
  if [ -n "$owner_start" ] && [ "$(process_start_time "$owner")" = "$owner_start" ]; then
    printf '%s' "$state"
    return 0
  fi
  debug "session: owner ${owner:-none} is gone, clearing"
  rm -f "$session_file"
  return 1
}

# Succeeds while this process owns the session: it hears the next turn.
session_is_mine() {
  [ "$(jq -r .owner <<<"$1")" = $$ ]
}

# session_update <jq filter> [jq args]: edits the open session in place. Under the lock, so it never recreates one that
# ended meanwhile.
session_update() { session_locked session_update_locked "$@"; }
session_update_locked() {
  local filter="$1" tmp="$session_file.$$"
  shift
  [ -e "$session_file" ] || return 0
  if jq -c "$@" "$filter" "$session_file" >"$tmp" 2>/dev/null; then
    mv -f "$tmp" "$session_file"
  else
    debug "session: could not update the state"
    rm -f "$tmp"
  fi
}

# session_set_owner <pid>: the watcher with this PID hears the next turn.
session_set_owner() {
  # shellcheck disable=SC2016 # a jq filter
  session_update '.owner = $owner | .owner_start = $owner_start' \
    --argjson owner "$1" --arg owner_start "$(process_start_time "$1")"
}

# The settings of the mode whose integration file is $1, in mode_setting: the session_* variables load_integration
# resets, without their session_ prefix, and has_handler.
declare -A mode_setting=()
load_mode_settings() {
  local key value
  mode_setting=()
  [ -f "${1:-}" ] || return 0
  while IFS='=' read -r key value; do
    mode_setting[$key]="$value"
  done < <(
    load_integration "$1"
    for key in default_exits allows_switches exit_hint exit_phrases control_phrases wake_at_end private open_ended \
      mode_idle_secs mode_max_secs listen_silence_secs listen_max_secs listen_no_speech_secs; do
      value="session_$key"
      printf '%s=%s\n' "$key" "${!value}"
    done
    if declare -F session_handle_turn >/dev/null; then echo has_handler=1; else echo has_handler=0; fi
  )
}

# The modes of a session, bottom first, each {kind, integration, label, exit_hint, unclear, mode_started,
# open_ended, frame_id, active_secs, resumes}: frame_id names the mode for as long as it is open, mode_started is when
# its current stretch as the current mode began, active_secs the stretches before that and resumes how many times it has
# become the current mode again; the session's current mode is the top-level fields beside .stack, which holds the ones underneath. An
# open-ended mode (type mode) lasts by its own bounds, so the time spent in it is not counted against the session's.
# shellcheck disable=SC2016 # jq
session_frames_jq='def frame: {kind, integration, label, exit_hint, unclear, mode_started, open_ended, frame_id, active_secs, resumes};
  def frames: (.stack // []) + [frame];'

session_new_frame_id() { printf '%s-%s%s' "$EPOCHSECONDS" "$RANDOM" "$RANDOM"; }

# Prints what a recording is heard in: how many modes are open and the one on top. A transcript that arrives under
# another is not for the mode the session is in by then.
session_mode_token() { jq -r '"\((.stack // []) | length + 1):\(.kind):\(.frame_id // "")"' <<<"$1"; }

# session_frame_index <state> <kind>: prints the position (from the bottom, 0 first) of the topmost mode of that kind.
session_frame_index() {
  jq -r --arg kind "$2" '[(.stack // [])[].kind, .kind] | to_entries | map(select(.value == $kind) | .key) | last // empty' <<<"$1"
}

# session_begin <kind> <integration file> <label>: opens a mode and, when no session is open, the session, which
# listens for its first turn.
# Called from the turn of the open session, it enters the mode on top of the current one (or returns to it when it is
# already open underneath, and does nothing when it is the current one); the turn's own continue listens. Anything else
# (a terminal, a key) leaves an open session as it is. Auto-stop's silence timeout is the only way an idle mode ends, so
# without it there is none.
session_begin() {
  local kind="$1" file="$2" label="$3" why state
  if state=$(session_state); then
    if session_is_mine "$state"; then
      session_locked session_enter_locked "$kind" "$file" "$label"
    else
      notify info "voxcmd: $label" "A voice session is already open"
    fi
    return 0
  fi
  if [ ! -x "$voxcmd_autostop" ]; then
    why="voxcmd-autostop is missing"
  elif why=$("$voxcmd_autostop" --check 2>&1); then
    why=""
  fi
  if [ -n "$why" ]; then
    notify info "voxcmd: $label needs auto-stop" "$why"
    return 0
  fi
  session_locked session_create "$kind" "$file" "$label" || return 0
  debug "session: $kind begins"
  session_listen
}
session_create() {
  local kind="$1" file="$2" label="$3" hint open_ended=false
  ! session_state_locked >/dev/null || return 1
  load_mode_settings "$file"
  hint="${mode_setting[exit_hint]:-say done to stop}"
  [ "${mode_setting[open_ended]:-0}" != 1 ] || open_ended=true
  jq -n -c --arg kind "$kind" --arg integration "$file" --arg label "$label" --arg hint "$hint" \
    --argjson open_ended "$open_ended" --arg frame_id "$(session_new_frame_id)" --argjson started "$EPOCHSECONDS" --argjson owner $$ --arg owner_start "$(process_start_time $$)" \
    '{kind: $kind, integration: $integration, label: $label, exit_hint: $hint, started: $started, owner: $owner,
      owner_start: $owner_start, unclear: 0, turns: 0, mode_started: $started, last_heard: $started,
      frame_id: $frame_id, active_secs: 0, resumes: 0, open_ended: $open_ended, stack: []}' >"$session_file.$$"
  mv -f "$session_file.$$" "$session_file"
}

session_enter_locked() {
  local kind="$1" file="$2" label="$3" state index count
  state=$(session_state_locked) && session_is_mine "$state" || return 0
  index=$(session_frame_index "$state" "$kind")
  count=$(jq -r '(.stack // []) | length + 1' <<<"$state")
  if [ -z "$index" ]; then
    session_push_locked "$kind" "$file" "$label"
  elif [ "$index" -lt $((count - 1)) ]; then
    debug "session: back to $kind"
    session_truncate_locked $((index + 1))
  fi
}

# Opens a mode over the current one; the unclear count starts again. An open-ended mode underneath has its time so far
# credited to the session's start now, since it is not counted against the session's cap; it is not counted twice when
# it is the current mode again (session_truncate_locked restarts its clock).
session_push_locked() {
  local kind="$1" file="$2" label="$3" hint open_ended=false
  load_mode_settings "$file"
  hint="${mode_setting[exit_hint]:-say done to stop}"
  [ "${mode_setting[open_ended]:-0}" != 1 ] || open_ended=true
  debug "session: $kind opens over the current mode"
  # shellcheck disable=SC2016 # a jq filter
  session_update_locked "$session_frames_jq"'
    frame as $under
    | {kind: $kind, integration: $integration, label: $label, exit_hint: ($hint + " (back to " + $under.label + ")"),
        unclear: 0, mode_started: $now, open_ended: $open_ended, last_heard: $now,
        frame_id: $frame_id, active_secs: 0, resumes: 0,
        owner, owner_start, turns,
        stack: ((.stack // []) + [$under + {active_secs: (($under.active_secs // 0) + $now - ($under.mode_started // $now))}]),
        started: (.started + (if $under.open_ended == true then $now - ($under.mode_started // $now) else 0 end))}' \
    --arg kind "$kind" --arg integration "$file" --arg label "$label" --arg hint "$hint" \
    --arg frame_id "$(session_new_frame_id)" --argjson open_ended "$open_ended" --argjson now "$EPOCHSECONDS"
}

# session_truncate_locked <modes to keep> [reason]: keeps that many modes from the bottom, popping the rest and running
# each one's ended hook; none ends the session. A reason is shown in a toast named for the lowest mode popped.
session_truncate_locked() {
  local keep="$1" reason="${2:-}" state popped label owner file frame_id
  state=$(session_state_locked) || return 1
  popped=$(jq -c --argjson keep "$keep" "$session_frames_jq"' frames[$keep:] | reverse' <<<"$state")
  label=$(jq -r --argjson keep "$keep" "$session_frames_jq"' frames[$keep].label // "Voice session"' <<<"$state")
  if [ "$keep" -le 0 ]; then
    rm -f "$session_file"
    owner=$(jq -r .owner <<<"$state")
    [ "$owner" = $$ ] || touch "$(discard_flag_of "$owner")"
    debug "session ended: $reason"
  else
    # shellcheck disable=SC2016 # a jq filter
    session_update_locked "$session_frames_jq"'
      frames as $all | $all[:$keep] as $kept
      | $kept[-1] + {owner, owner_start, turns, last_heard: $now,
          started: (.started + (if $all[-1].open_ended == true then $now - ($all[-1].mode_started // $now) else 0 end)),
          stack: $kept[:-1]}
      | .mode_started = $now | .resumes = ((.resumes // 0) + 1)' --argjson keep "$keep" --argjson now "$EPOCHSECONDS"
    debug "session: left $(jq -r 'map(.kind) | join(", ")' <<<"$popped")${reason:+ ($reason)}"
  fi
  # A bar that hangs must not keep the ended hooks from running.
  [ -z "$reason" ] || notify info "voxcmd: $label ended" "$reason" || true
  while IFS=$'\t' read -r file frame_id; do
    session_run_ended_hook "$file" "$reason" "$frame_id" "$([ "$keep" -gt 0 ] && echo 1 || echo 0)"
  done < <(jq -r '.[] | [.integration, .frame_id // ""] | @tsv' <<<"$popped")
}

# session_leave <kind> [reason]: leaves that mode and every mode opened over it, back to the one underneath; leaving the
# bottom one ends the session. Fails when the kind is not open.
session_leave() { session_locked session_leave_locked "$@"; }
session_leave_locked() {
  local kind="$1" reason="${2:-}" state index
  state=$(session_state_locked) || return 1
  index=$(session_frame_index "$state" "$kind")
  [ -n "$index" ] || return 1
  session_truncate_locked "$index" "$reason"
}

# Leaves the current mode.
session_end() { session_locked session_end_top_locked "$@"; }
session_end_top_locked() {
  local state
  state=$(session_state_locked) || return 0
  session_leave_locked "$(jq -r .kind <<<"$state")" "$@"
}

# Ends the session, every mode in it, saying why; the watcher whose recording is still open stops hearing for it.
session_end_all() { session_locked session_end_all_locked "$@"; }
session_end_all_locked() { session_truncate_locked 0 "$@" || return 0; }

# An integration's session_ended, if it has one, tidies what the mode left behind (type mode's held mark). In the
# background and without the lock: it may type for a second, and nothing in the session waits on it. It gets the reason,
# "done" when the owner left the mode on purpose. Its second argument is the popped mode's frame_id, its third 1 when
# the session goes on in the mode underneath (so a Stop that lands later is told apart from the session never having
# ended).
session_run_ended_hook() {
  (
    # fd 9 is closed here, so the lock the caller holds is not this subshell's to assume.
    session_lock_held=0
    load_integration "$1"
    declare -F session_ended >/dev/null || exit 0
    session_ended "$2" "${3:-}" "${4:-0}"
  ) 9>&- >/dev/null 2>&1 &
}

# session_end_if_mine <reason>: ends the session this process owns, as a watcher that dies without handing over leaves it.
# A session another listen took over is left to that one.
session_end_if_mine() { session_locked session_end_if_mine_locked "$@"; }
session_end_if_mine_locked() {
  local state
  state=$(session_state_locked) && session_is_mine "$state" || return 0
  session_end_all_locked "$1"
}

# A listen that heard no speech. A mode with its own bounds (type mode) listens again until they are reached; any other
# ends, back to the mode under it, which listens on.
session_silence() { session_locked session_silence_locked; }
session_silence_locked() {
  local state reason=""
  state=$(session_state_locked) && session_is_mine "$state" || return 0
  if [ "$(jq -r '.open_ended // false' <<<"$state")" = true ]; then
    reason=$(session_mode_limit_reason "$state")
    [ -z "$reason" ] || session_leave_locked "$(jq -r .kind <<<"$state")" "$reason"
  else
    session_leave_locked "$(jq -r .kind <<<"$state")" "nothing was said"
  fi
  session_listen_locked
}

# Prints why an open-ended mode is over: its hard cap, or too long without speech. Nothing while it may go on.
session_mode_limit_reason() {
  local state="$1" mode_active_secs last_heard now="$EPOCHSECONDS"
  load_mode_settings "$(jq -r .integration <<<"$state")"
  read -r mode_active_secs last_heard < <(jq -r --argjson now "$now" '"\((.active_secs // 0) + $now - (.mode_started // $now)) \(.last_heard // $now)"' <<<"$state")
  if [ -n "${mode_setting[mode_max_secs]:-}" ] && [ "$mode_active_secs" -ge "${mode_setting[mode_max_secs]}" ]; then
    echo "it reached its time limit ($(duration_words "${mode_setting[mode_max_secs]}"))"
  elif [ -n "${mode_setting[mode_idle_secs]:-}" ] && [ $((now - last_heard)) -ge "${mode_setting[mode_idle_secs]}" ]; then
    echo "nothing was said for $(duration_words "${mode_setting[mode_idle_secs]}")"
  fi
}

# Whether the mode on top is still wanted: its integration's session_alive, when it has one, says its screen is still up.
session_mode_alive() {
  (
    load_integration "$1"
    ! declare -F session_alive >/dev/null || session_alive
  )
}

# Leaves the modes whose screen is gone (the overview closed by key), so a mode never outlives what it drives.
session_drop_dead_modes_locked() {
  local state
  while state=$(session_state_locked) && ! session_mode_alive "$(jq -r .integration <<<"$state")"; do
    session_leave_locked "$(jq -r .kind <<<"$state")" "its screen closed" || return 0
  done
}

# Opens the microphone for the next turn, unless the session ended or another listen took it over. Holding the lock
# while it starts, a failed start cannot be a listen of ours, so voxtype is busy with something else.
session_listen() { session_locked session_listen_locked; }
session_listen_locked() {
  local state
  state=$(session_state_locked) || return 0
  session_drop_dead_modes_locked
  state=$(session_state_locked) || return 0
  if ! session_is_mine "$state"; then
    debug "session: another listen took over"
    return 0
  fi
  listen --start-only || session_end_all_locked "the microphone could not be opened"
}

epoch_micros() {
  local now="$EPOCHREALTIME"
  printf '%s' "${now//[.,]/}"
}

# poll_until <max_secs> <command...>: runs the command every ui_settle_poll_secs until it succeeds. Fails with 1 after
# max_secs and with 2 when Stop Voice has flagged the running sequence. Both are checked only between runs, so a
# command must bound its own calls (timeout on hyprctl) to keep the cap and Stop working.
poll_until() {
  local max_secs="$1" deadline_micros
  shift
  deadline_micros=$(($(epoch_micros) + $(awk -v secs="$max_secs" 'BEGIN { printf "%d", secs * 1000000 }')))
  until "$@"; do
    if sequence_stopped; then return 2; fi
    if [ "$(epoch_micros)" -ge "$deadline_micros" ]; then return 1; fi
    sleep "$ui_settle_poll_secs"
  done
}

# Waits, up to ui_settle_max_secs, until neither the click overlay nor a popup is open or animating, then gives the app
# the user acted on a moment to draw its result, so the next turn's screen read sees it. A bar that does not answer
# counts as settled.
wait_until_ui_settled() {
  local timed_out=0
  if [ -x "$qs_ipc" ]; then
    poll_until "$ui_settle_max_secs" ui_is_idle || timed_out=1
  fi
  sleep "$app_settle_secs"
  [ "$timed_out" = 0 ]
}

ui_is_busy() {
  ui_read_state
  [ "$overlay_state" = open ] || [[ "$popup_state" =~ ^(opening|open|closing)( |$) ]]
}

ui_is_idle() { ! ui_is_busy; }

# session_continue <outcome>: after a turn that did something (ran), did nothing (missed) or heard nothing (unheard),
# counts it, ends the session when a cap is reached, else waits for the screen to settle and listens again. An open-ended
# mode (type mode) listens again at once, as nothing it does needs the screen to settle.
session_continue() {
  local state
  session_locked session_count_turn "$1" || return 0
  state=$(session_state) || return 0
  if [ "$(jq -r '.open_ended // false' <<<"$state")" != true ]; then
    wait_until_ui_settled || debug "session: the screen had not settled after ${ui_settle_max_secs}s"
  fi
  session_listen
}

# session_count_turn <outcome>: records the turn; fails when the session is over or another listen took it over.
session_count_turn() {
  local outcome="$1" state unclear turns started why=""
  state=$(session_state_locked) || return 1
  if ! session_is_mine "$state"; then
    debug "session: another listen took over"
    return 1
  fi
  # An open-ended mode counts no turns: it is bounded by its own limits instead.
  if [ "$(jq -r '.open_ended // false' <<<"$state")" = true ]; then
    why=$(session_mode_limit_reason "$state")
    [ -z "$why" ] || session_leave_locked "$(jq -r .kind <<<"$state")" "$why"
    return 0
  fi
  read -r unclear turns started < <(jq -r '"\(.unclear) \(.turns) \(.started)"' <<<"$state")
  case "$outcome" in
  missed) unclear=$((unclear + 1)) ;;
  ran) unclear=0 ;;
  esac
  turns=$((turns + 1))
  if [ "$unclear" -ge "$session_unclear_cap" ]; then
    why="nothing understood $session_unclear_cap times in a row"
  elif [ "$turns" -ge "$session_max_turns" ]; then
    why="it reached $session_max_turns turns"
  elif [ $((EPOCHSECONDS - started)) -ge "$session_max_secs" ]; then
    why="it reached its time limit ($(duration_words "$session_max_secs"))"
  fi
  if [ -n "$why" ]; then
    session_end_all_locked "$why"
    return 1
  fi
  # shellcheck disable=SC2016 # a jq filter
  session_update_locked '.unclear = $unclear | .turns = $turns' --argjson unclear "$unclear" --argjson turns "$turns"
}

duration_words() {
  if [ $(($1 % 60)) = 0 ] && [ "$1" -ge 60 ]; then echo "$(($1 / 60)) min"; else echo "$1 s"; fi
}

# A turn is unusable when its words match nothing, or when its action says it found nothing to act on.
turn_was_a_miss() {
  local file="$1" action
  (
    load_integration "$file"
    for action in "${integration_session_miss_actions[@]}"; do
      [ "$action" != "$last_run_action" ] || exit 0
    done
    exit 1
  )
}

# Whether the normalized text is a way out of the mode loaded in mode_setting: the exit words, or its own phrases.
session_text_is_exit() {
  [[ "$1" =~ $session_exit_words ]] && return 0
  [ -n "${mode_setting[exit_phrases]:-}" ] && [[ "$1" =~ ^(${mode_setting[exit_phrases]})$ ]]
}

# Prints the runnable options (a JSON array) that the whole text asks of the modes: entering one or leaving one.
session_mode_options() {
  local matches
  matches=$(integration_files | for_each_line_in_parallel match_mode_action "$1")
  if [ -z "$matches" ]; then
    echo '[]'
    return
  fi
  resolve_matches "$matches"
}

# session_classify_wake_command <command>: what a command after the wake word is, in wake_kind: exit (leave the mode),
# control (the mode's own, like scratch that), stop (end the session), switch (enter or leave another mode, its option
# in wake_options) or none. Uses the mode loaded in mode_setting.
wake_kind=none
wake_options='[]'
session_classify_wake_command() {
  local command="$1"
  wake_kind=none wake_options='[]'
  if session_text_is_exit "$command"; then
    wake_kind='exit'
  elif [ -n "${mode_setting[control_phrases]:-}" ] && [[ "$command" =~ ^(${mode_setting[control_phrases]})$ ]]; then
    wake_kind=control
  elif [[ "$command" =~ $session_stop_words ]]; then
    wake_kind=stop
  else
    wake_options=$(session_mode_options "$command")
    [ "$(jq length <<<"$wake_options")" != 1 ] || wake_kind=switch
  fi
}

# Runs the command classified in wake_kind and sets turn_outcome. Unknown commands are told so and nothing else happens.
turn_outcome=ran
session_run_wake_command() {
  local state="$1" command="$2"
  turn_outcome=ran
  case "$wake_kind" in
  exit) session_leave "$(jq -r .kind <<<"$state")" "done" || true ;;
  control)
    (
      load_integration "$(jq -r .integration <<<"$state")"
      session_control "$command"
    ) || true
    ;;
  stop) session_end_all "stopped" ;;
  switch)
    last_run_action=""
    run_option "$(jq -c '.[0]' <<<"$wake_options")" || turn_outcome=missed
    [ "$step_outcome" = ran ] || turn_outcome=missed
    ;;
  *)
    if [ "${mode_setting[private]:-0}" = 1 ]; then
      # Dictated words are never routed: a stray one could run a command.
      notify info "voxcmd: $wake_word" "Not a mode command"
      turn_outcome=unheard
    else
      last_run_action=""
      if ! route "$command" || [ -z "$last_run_action" ] || turn_was_a_miss "$(jq -r .integration <<<"$state")"; then
        turn_outcome=missed
      fi
    fi
    ;;
  esac
}

# Sets session_steps to what each step of phrase_steps routes as in the mode on top (integration <file>): the step
# rewritten by the mode's session_rewrite, or unchanged when it has none. A step that is exactly a mode switch the
# mode allows is left as spoken, as a whole turn would be. Fails when a step names nothing to route.
session_steps=()
session_sequence_steps() {
  local file="$1" allows_switches="${mode_setting[allows_switches]:-0}" step
  session_steps=()
  while IFS= read -r step; do
    [ -n "$step" ] || return 1
    session_steps+=("$step")
  done < <(
    load_integration "$file"
    for step in "${phrase_steps[@]}"; do
      step="${step//$'\n'/ }"
      text=$(apply_replacements "$(normalize "$step")")
      if ! declare -F session_rewrite >/dev/null; then
        printf '%s\n' "$step"
      elif [ "$allows_switches" = 1 ] && [ -n "$(integration_files | for_each_line_in_parallel match_mode_action "$text")" ]; then
        printf '%s\n' "$text"
      else
        printf '%s\n' "$(session_rewrite "$text")"
      fi
    done
  )
  [ "${#session_steps[@]}" = "${#phrase_steps[@]}" ]
}

# The transcript handler while a session is open. A session that ended while the recording ran hands it to route, unless
# a mode that keeps its words private heard it: those are never routed.
session_turn() {
  local transcript="$*" state text norm file kind rewritten chunk control="" options outcome=ran
  in_session_turn=1
  # Stop landed after the watcher's own check: nothing from this turn may run or open the microphone.
  if [ -e "$(discard_flag_of $$)" ]; then
    if [ "$heard_private" = 1 ]; then debug "session: a turn was discarded, stop was pressed"; else debug "session: turn \"$transcript\" discarded, stop was pressed"; fi
    return 0
  fi
  if ! state=$(session_state); then
    if [ "$heard_private" = 1 ]; then
      debug "session: a turn heard in a private mode outlived its session, discarded"
      return 0
    fi
    route "$transcript"
    return
  fi
  file=$(jq -r .integration <<<"$state")
  kind=$(jq -r .kind <<<"$state")
  load_mode_settings "$file"
  if ! session_mode_alive "$file"; then
    # What was said was heard for a mode whose screen has closed: it goes where it would without the mode.
    debug "session: $kind's screen is gone"
    session_leave "$kind" "its screen closed" || true
    route "$transcript" || true
    session_continue unheard
    return
  fi
  if [ -n "$heard_mode" ] && [ "$heard_mode" != "$(session_mode_token "$state")" ]; then
    debug "session: heard in $heard_mode but the session is in $(session_mode_token "$state"), not routed"
    notify info "voxcmd" "The mode changed, say it again"
    session_continue unheard
    return
  fi
  norm=$(normalize "$transcript")
  if [[ "$norm" =~ $session_noise_transcripts ]]; then
    debug "session: the transcriber's guess at noise, listening again"
    session_continue unheard
    return
  fi
  text=$(apply_replacements "$norm")
  # shellcheck disable=SC2016 # a jq filter
  session_update '.last_heard = $now' --argjson now "$EPOCHSECONDS"
  if split_leading_wake "$norm"; then
    text=$(apply_replacements "$wake_rest")
    if [ -z "$text" ]; then
      notify info "voxcmd" "Say a command after \"$wake_word\""
      turn_outcome=unheard
    else
      session_classify_wake_command "$text"
      session_run_wake_command "$state" "$text"
    fi
    session_continue "$turn_outcome"
    return
  fi
  chunk="$transcript"
  if [ "${mode_setting[wake_at_end]:-0}" = 1 ] && split_trailing_wake "$transcript"; then
    # A wake word that opens no command ("...ask Jarvis about it") stays part of the chunk.
    control=$(apply_replacements "$wake_rest")
    session_classify_wake_command "$control"
    if [ "$wake_kind" = none ]; then control=""; else chunk="$wake_before"; fi
  fi
  if [ -z "$control" ]; then
    if [ "${mode_setting[default_exits]:-1}" = 1 ] && session_text_is_exit "$text"; then
      session_leave "$kind" "done" || true
      session_continue ran
      return 0
    fi
    if [ "${mode_setting[allows_switches]:-0}" = 1 ]; then
      options=$(session_mode_options "$text")
      if [ "$(jq length <<<"$options")" = 1 ]; then
        last_run_action=""
        run_option "$(jq -c '.[0]' <<<"$options")" || outcome=missed
        [ "$step_outcome" = ran ] || outcome=missed
        session_continue "$outcome"
        return
      fi
    fi
  fi
  last_run_action=""
  if [ "${mode_setting[has_handler]:-0}" = 1 ]; then
    # The mode takes the words itself (type mode types them), and its own bounds replace the unusable-turn count.
    (
      load_integration "$file"
      session_handle_turn "$chunk"
    ) || true
    outcome=typed
  else
    split_phrase "$transcript"
    # A last step that is the mode's exit phrase leaves the mode after the steps before it, not a word to act on.
    leave_after=0
    if [ "${#phrase_steps[@]}" -gt 1 ] && [ "${mode_setting[default_exits]:-1}" = 1 ] &&
      session_text_is_exit "$(apply_replacements "$(normalize "${phrase_steps[-1]}")")"; then
      unset 'phrase_steps[-1]'
      leave_after=1
    fi
    if [ "${#phrase_steps[@]}" -gt 1 ]; then
      if ! session_sequence_steps "$file"; then
        notify info "voxcmd" "Not understood: \"$transcript\""
        outcome=missed
      elif ! route_steps "${session_steps[@]}" || [ -z "$last_run_action" ] || turn_was_a_miss "$file"; then
        outcome=missed
      fi
    else
      text=$(apply_replacements "$(normalize "${phrase_steps[0]}")")
      rewritten=$(
        load_integration "$file"
        if declare -F session_rewrite >/dev/null; then session_rewrite "$text"; else printf '%s' "$text"; fi
      )
      if [ -z "$rewritten" ]; then
        notify info "voxcmd" "Not understood: \"$transcript\""
        outcome=missed
      # Nothing ran when a picker or overlay was cancelled or timed out, though route succeeds.
      elif ! route_step "$rewritten" || [ -z "$last_run_action" ] || turn_was_a_miss "$file"; then
        outcome=missed
      fi
    fi
    if [ "$leave_after" = 1 ] && [ "$step_outcome" = ran ]; then session_leave "$kind" "done" || true; fi
  fi
  if [ -n "$control" ]; then
    session_run_wake_command "$state" "$control"
    outcome="$turn_outcome"
  fi
  session_continue "$outcome"
}
# ----------------------------------------------------------------------------------------------------------------

voxtype_state() { cat "$voxtype_state_file" 2>/dev/null || echo idle; }
# voxtype rewrites its state file in place on every transition and only then, so a new mtime means a new transition.
# Read before the state, a write landing in between makes the marker look older than the state, never newer.
voxtype_state_write_marker() { stat -c %.9Y "$voxtype_state_file" 2>/dev/null || echo none; }

# A watcher polls, so it can miss voxtype going idle when a dictation starts within one poll. That shows as a new
# write with the same state, or as recording after transcribing, since voxtype passes through idle for either.
recording_ended_unseen() {
  local last_state="$1" last_write_marker="$2" state="$3" write_marker="$4"
  [ "$write_marker" != "$last_write_marker" ] || return 1
  [ "$state" = "$last_state" ] || { [ "$last_state" = transcribing ] && [ "$state" = recording ]; }
}

# While voxtype records, whoever started it (voxcmd or Speech to Text), this only stops it, and the recording's
# owner handles the transcript. Otherwise it starts a recording into a file and leaves a watcher to route the
# transcript, or to reply with it when a voxcmd picker was open as the recording started.
# --start-only never stops anything and fails unless voxtype is idle: a recording voxcmd starts on its own (a confirm
# card's) must not end one the user is making.
# Under the session lock, so a voice key pressed during a session turn and that turn's own next listen never both start.
listen() { session_locked listen_locked "$@"; }
listen_locked() {
  local transcript_handler=route state start_only=0 session_json mode_token=- mode_private=0
  [ "${1:-}" != --start-only ] || start_only=1
  state=$(voxtype_state)
  debug "listen: voxtype $state${recording_owner_file:+, for a reply}$([ "$start_only" = 0 ] || echo ', start only')"
  if [ "$start_only" = 1 ] && [ "$state" != idle ]; then return 1; fi
  case "$state" in
  recording)
    voxtype record stop
    return
    ;;
  # The transcript is already on its way to its owner.
  transcribing) return 0 ;;
  idle) ;;
  *)
    notify error "voxcmd" "voxtype is not ready ($state)"
    return 1
    ;;
  esac
  mkdir -p "$runtime_dir"
  if session_json=$(session_state); then
    load_mode_settings "$(jq -r .integration <<<"$session_json")"
    # A mode that takes the words itself or keeps them private (type mode) never has its dictation read as a reply to a
    # picker, which would log the words and could answer a card with them.
    if pending_pick >/dev/null && [ "${mode_setting[private]:-0}" != 1 ] && [ "${mode_setting[has_handler]:-0}" != 1 ]; then
      transcript_handler=reply
    else
      transcript_handler=session_turn
      mode_token=$(session_mode_token "$session_json")
      mode_private="${mode_setting[private]:-0}"
    fi
  elif pending_pick >/dev/null; then
    transcript_handler=reply
  fi
  rm -f "$transcript_file"
  if ! voxtype record start --file="$transcript_file" 9>&-; then
    notify error "voxcmd error" "voxtype record start failed"
    return 1
  fi
  setsid "$0" _watch "$transcript_handler" "$mode_token" "$mode_private" </dev/null >/dev/null 2>&1 9>&- &
  debug "listen: recording started, watcher $! will $transcript_handler"
  [ "$transcript_handler" != session_turn ] || session_set_owner "$!"
}

# voxcmd-autostop's VERDICT_* exit codes; any other exit leaves the recording alone.
autostop_verdict_silence=0
autostop_verdict_no_speech=3

# Ends the recording once voxcmd-autostop hears speech and then a pause, or cancels it when nothing was said. The
# detector exits by itself when the recording ends some other way; the TERM trap covers the watcher ending first.
autostop_recording() {
  local discard_flag="$1" transcript_handler="$2" detector_pid verdict=0 session_json=""
  local -a detector_env=()
  [ -x "$voxcmd_autostop" ] || return 0
  # An overlay or confirm asked during a session turn is a reply, not the session's own listen.
  case "$transcript_handler" in
  session_turn)
    session_json=$(session_state) || session_json="{}"
    load_mode_settings "$(jq -r '.integration // empty' <<<"$session_json")"
    detector_env=(
      "VOXCMD_AUTOSTOP_NO_SPEECH_SECS=${mode_setting[listen_no_speech_secs]:-$session_no_speech_secs}"
      "VOXCMD_AUTOSTOP_MIN_SPEECH_SECS=$session_min_speech_secs"
      "VOXCMD_AUTOSTOP_SILENCE_SECS=${mode_setting[listen_silence_secs]:-$session_silence_secs}"
    )
    # A mode that records in chunks cuts a long speech into them.
    [ -z "${mode_setting[listen_max_secs]:-}" ] || detector_env+=("VOXCMD_AUTOSTOP_MAX_SECS=${mode_setting[listen_max_secs]}")
    ;;
  reply) detector_env=("VOXCMD_AUTOSTOP_MIN_SPEECH_SECS=$reply_min_speech_secs") ;;
  esac
  env "${detector_env[@]}" "$voxcmd_autostop" &
  detector_pid=$!
  trap 'kill "$detector_pid" 2>/dev/null; exit 0' TERM
  wait "$detector_pid" || verdict=$?
  # A voice key may have stopped it in the meantime.
  [ "$(voxtype_state)" = recording ] || return 0
  case "$verdict" in
  "$autostop_verdict_silence")
    debug "autostop: speech then quiet, stopping"
    voxtype record stop
    ;;
  "$autostop_verdict_no_speech")
    debug "autostop: no speech, cancelling"
    touch "$discard_flag"
    voxtype record cancel
    ;;
  *) debug "autostop: verdict $verdict, recording left alone" ;;
  esac
}

# Polled every 0.2s. Recording plus transcription can outlast voxtype's max_duration_secs; 10 minutes covers both.
watch_poll_interval=$(scaled_secs 0.2)
watch_max_polls=3000
watch_start_grace_polls=50
watch_file_grace_polls=10

# The discard flag of the watcher with this PID: present, its transcript is thrown away.
discard_flag_of() { printf '%s/discard.%s' "$runtime_dir" "$1"; }

watch_recording() {
  local transcript_handler="$1" recording_seen=0 polls=0 state last_state="" autostop_pid discard_flag
  local write_marker last_write_marker="" cancel_sent=0 transcript
  # A voxtype that ignores the cancel could still write a transcript.
  discard_flag=$(discard_flag_of $$)
  autostop_recording "$discard_flag" "$transcript_handler" &
  autostop_pid=$!
  # The kill fails once auto-stop is done, and under errexit that would end the trap before the cleanup after it.
  # shellcheck disable=SC2064 # expanded now: the PID and paths are fixed
  trap "kill $autostop_pid 2>/dev/null || true; rm -f '$discard_flag'; release_recording_ownership; [ '$transcript_handler' != session_turn ] || session_end_if_mine 'the listener stopped unexpectedly'" EXIT
  # listen only starts a watcher for a recording it started from idle, so the recording is this watcher's from the
  # start. The owner may already be gone, its file with it.
  if [ -n "$recording_owner_file" ]; then echo $$ 2>/dev/null >"$recording_owner_file" || true; fi
  while [ "$polls" -lt "$watch_max_polls" ]; do
    polls=$((polls + 1))
    write_marker=$(voxtype_state_write_marker)
    state=$(voxtype_state)
    # voxtype truncates the file before writing the new state.
    if [ -z "$state" ]; then
      sleep "$watch_poll_interval"
      continue
    fi
    [ "$state" = "$last_state" ] || debug "watch: voxtype $state"
    # Ended as surely as by an idle, and the recording now running is someone else's.
    if [ "$recording_seen" = 1 ] && recording_ended_unseen "$last_state" "$last_write_marker" "$state" "$write_marker"; then
      debug "watch: voxtype went idle and started another recording between polls"
      break
    fi
    last_state="$state" last_write_marker="$write_marker"
    if [ "$state" != idle ]; then
      recording_seen=1
      # Transcribing: the microphone is no longer needed.
      [ "$state" = recording ] || kill "$autostop_pid" 2>/dev/null || true
      # Checked against a fresh marker so the cancel never reaches a recording this poll has not seen.
      if [ -e "$discard_flag" ] && [ "$cancel_sent" = 0 ] &&
        [ "$(voxtype_state_write_marker)" = "$write_marker" ]; then
        debug "watch: discarded while voxtype is $state, cancelling"
        cancel_sent=1
        voxtype record cancel || true
      fi
    elif [ "$recording_seen" = 1 ] || [ "$polls" -gt "$watch_start_grace_polls" ]; then
      break
    fi
    sleep "$watch_poll_interval"
  done
  release_recording_ownership
  kill "$autostop_pid" 2>/dev/null || true
  if [ -e "$discard_flag" ]; then
    debug "watch: recording discarded"
    # Autostop's no-speech cancel: the mode that heard nothing is over, unless it has bounds of its own.
    [ "$transcript_handler" != session_turn ] || session_silence
    exit 0
  fi
  # voxtype may write the file a moment after it reports idle.
  for ((polls = 0; polls < watch_file_grace_polls; polls++)); do
    [ -s "$transcript_file" ] && break
    sleep "$watch_poll_interval"
  done
  # Checked again: a key can answer the confirm this reply was for while voxtype finishes writing it.
  if [ ! -s "$transcript_file" ] || [ -e "$discard_flag" ]; then
    debug "watch: no transcript"
    if [ "$transcript_handler" = session_turn ]; then session_continue unheard; fi
    exit 0
  fi
  came_by_voice=1
  transcript=$(cat "$transcript_file")
  # Dictation must not outlive its turn on disk; the next listen starts from a fresh file anyway.
  rm -f "$transcript_file"
  if [ "$heard_private" = 1 ]; then
    debug "watch: a transcript of ${#transcript} characters goes to $transcript_handler"
  else
    debug "watch: transcript \"$transcript\" goes to $transcript_handler"
  fi
  "$transcript_handler" "$transcript"
}

# Once voxtype is idle the recording is over, and anything it does next belongs to someone else.
release_recording_ownership() {
  if [ -n "$recording_owner_file" ] && [ "$(cat "$recording_owner_file" 2>/dev/null)" = $$ ]; then
    rm -f "$recording_owner_file"
  fi
}

# For voxcmd-confirm and voxcmd-pick once a key, click or timeout answers them: discards whatever transcript their
# reply recording still brings, and has the watcher cancel that recording on its next poll. Only the watcher can tell its recording
# from a dictation that started since: voxtype has no recording ids, and its state reads "recording" for both.
cancel_owned_recording() {
  local owner_file="$1" watcher_pid
  watcher_pid=$(cat "$owner_file" 2>/dev/null) || return 0
  [ -n "$watcher_pid" ] && kill -0 "$watcher_pid" 2>/dev/null || return 0
  debug "answered without voice: discarding watcher $watcher_pid's recording"
  touch "$(discard_flag_of "$watcher_pid")"
}

# The one key for any voice activity that will not end by itself. The session goes first, so its watcher cannot open
# the microphone again: ending it flags the watcher's recording as discarded, whatever the watcher is doing (hearing,
# transcribing or routing), and its next listen finds no session. A turn already routing still finishes its action,
# but a picker or card it opens does not listen (reply_listen_wanted). The picker's own exit cancels the reply recording it
# started, and the cancel at the end covers every other recording, a plain command or Speech to Text.
stop_voice() {
  local picker sequence_pid
  session_end_all "stopped" || true
  # Before the picker is cancelled, so the sequence it was asking for reads that answer as Stop Voice's.
  while IFS= read -r sequence_pid; do touch "$(discard_flag_of "$sequence_pid")"; done < <(running_sequence_pids)
  if picker=$(pending_pick); then
    write_pick_answer "" "$(jq -r .fifo <<<"$picker")" || true
  fi
  case "$(voxtype_state)" in
  recording | transcribing)
    debug "stop: cancelling the $(voxtype_state) voxtype"
    voxtype record cancel || true
    ;;
  esac
}

# The bar keeps only voxcmd's errors in its history (see notify), so this lists the failures behind recent commands.
print_errors() {
  local count="${1:-10}" json
  if ! [[ $count =~ ^[0-9]+$ ]]; then
    usage >&2
    exit 2
  fi
  if ! json=$("${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/qs-ipc" call notifications history "$count" voxcmd 2>/dev/null) ||
    ! jq -e 'type == "array"' <<<"$json" >/dev/null 2>&1; then
    echo "voxcmd: bar not running" >&2
    exit 1
  fi
  # shellcheck source-path=SCRIPTDIR/../share/voxcmd source=spoken-time.sh
  source "$voxcmd_share_dir/spoken-time.sh"
  jq -r --arg time_format "%F $(clock_time_format)" \
    '.[] | "\(.time | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601 | strflocaltime($time_format))  \(.summary): \(.body | gsub("\n"; " "))"' <<<"$json"
}

load_local_intents

case "${1:-}" in
"" | -h | --help) usage ;;
--dry-run)
  shift
  dry_run=1
  if [ "${1:-}" = --reply ]; then
    shift
    reply "$@"
  else
    route "$@"
  fi
  ;;
--reply)
  shift
  reply "$@"
  ;;
listen) listen "${2:-}" ;;
help) voice_help ;;
errors) print_errors "${2:-}" ;;
rapid) route "rapid mode" ;;
end-session) session_end_all "ended by request" ;;
stop) stop_voice ;;
wake) exec "$(dirname "$voxcmd_self")/voxcmd-wake-switch" "${@:2}" ;;
click-explain)
  shift
  click_explain "$@"
  ;;
_settle) wait_until_ui_settled ;;
_watch)
  heard_mode="${3:-}" heard_private="${4:-0}" in_watcher=1
  watch_recording "$2"
  ;;
_cancel_owned_recording) cancel_owned_recording "$2" ;;
list)
  while IFS= read -r file; do
    (
      load_integration "$file"
      printf '%s (%s)%s\n' "$name" "$file" "$([ "$fallback" != 1 ] || echo ' [fallback]')"
      # shellcheck disable=SC2031 # set by load_integration in this subshell
      printf '  %s\n' "${integration_verbs[@]}"
    )
  done < <(integration_files)
  ;;
*) route "$@" ;;
esac
