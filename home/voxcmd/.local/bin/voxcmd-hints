#!/usr/bin/env bash
# voxcmd-hints: blocking picker that numbers boxes on screen, for shell callers.
# Usage: voxcmd-hints [--listen] <label> <choices-json>
# Choices are a JSON array of {id, label, box: [left, top, width, height]} (global logical pixels). Prints
# the picked id and exits 0; exits 1 on cancel. Uses the Quickshell click-hints overlay when the bar is running, answered
# by number key, click or `voxcmd --reply` through the pending-pick state file; any choice without a box, or a bar
# that does not take the overlay, hands the whole pick to voxcmd-pick instead.
# --listen starts the voice reply's recording just before the overlay shows, listening once more after an unclear reply.
set -euo pipefail

usage='usage: voxcmd-hints [--listen] <label> <choices-json>'
listen=0
if [ "${1:-}" = --listen ]; then
  listen=1
  shift
fi
label="${1:?$usage}"
choices_json="${2:?$usage}"
# The overlay times itself out after 10s (waiting while voice is heard); this only covers a bar that dies mid-pick.
bar_timeout="${VOXCMD_HINTS_TIMEOUT:-120}"
max_choices=10
runtime_dir="${XDG_RUNTIME_DIR:-/tmp}/voxcmd"
pending_pick_file="$runtime_dir/pending-pick.json"
voxtype_state_file="${XDG_RUNTIME_DIR:-/tmp}/voxtype/state"
hypr_scripts="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts"
voxcmd="$(dirname "$(readlink -f "$0")")/voxcmd"
voxcmd_pick="$(dirname "$(readlink -f "$0")")/voxcmd-pick"

# The text picker numbers its labels itself.
text_choices=$(jq -c 'map({id: (.id | tostring), label: "\(.label // .id)"})' <<<"$choices_json")
# Numbered like voxcmd-pick's labels, so a spoken ordinal or a number key means the same box.
choices=$(jq -c --argjson text "$text_choices" \
  '[to_entries[] | $text[.key] + {box: .value.box, label: "\(.key + 1). \($text[.key].label)"}]' <<<"$choices_json")

# A text picker asks instead: no bar to draw on, a choice with no place on screen, or more choices than numbers.
if [ ! -x "$hypr_scripts/qs-ipc" ] ||
  ! jq -e --argjson max "$max_choices" 'length <= $max and all(.box | type == "array" and length == 4 and all(type == "number"))' <<<"$choices" >/dev/null; then
  pick_flags=()
  [ "$listen" = 0 ] || pick_flags+=(--listen)
  exec "$voxcmd_pick" "${pick_flags[@]}" "$label" "$text_choices"
fi

work_dir=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/voxcmd-hints.XXXXXX")
reader_pid=""
child_pid=""
# Set once the bar has the overlay up, so whatever ends this process takes it down again.
overlay_open=0
# Holds the PID of the watcher whose recording --listen started, while voxtype records or transcribes it.
recording_owner_file="$work_dir/recording-owner"
cleanup() {
  # A newer pick may have replaced the state file; only remove our own.
  if [ "$(jq -r .pid "$pending_pick_file" 2>/dev/null)" = "$$" ]; then rm -f "$pending_pick_file"; fi
  if [ -n "$reader_pid" ]; then kill "$reader_pid" 2>/dev/null || true; fi
  # Picked by key, click or timeout while its reply recording still runs: the microphone goes off and the transcript is
  # dropped, as in voxcmd-confirm. A no-op once a voice reply has answered.
  if [ -e "$recording_owner_file" ]; then "$voxcmd" _cancel_owned_recording "$recording_owner_file" || true; fi
  rm -rf "$work_dir"
  # Removed before dismissing, so nothing the bar writes afterwards can block on the FIFO. A no-op unless a voice
  # reply, the timeout or a signal ended the pick while the overlay was still open.
  if [ "$overlay_open" = 1 ]; then
    overlay_open=0
    "$hypr_scripts/qs-ipc" call clickhints dismiss "$result_fifo" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT
trap 'exit 1' INT TERM HUP
result_fifo="$work_dir/result"
spec="$work_dir/spec.json"
# Present while one more listen is left after an unclear reply; voxcmd removes it when it listens again.
listen_again_file="$work_dir/listen-again"
mkfifo "$result_fifo"

jq -n --arg label "$label" --arg result_path "$result_fifo" --argjson choices "$choices" \
  '{label: $label, result_path: $result_path,
    choices: $choices | map({label, x: .box[0], y: .box[1], w: .box[2], h: .box[3]})}' >"$spec"

# Written before the overlay shows, so a reply recording started now or by the voice key goes to this pick.
mkdir -p "$runtime_dir"
jq -n --argjson pid $$ --arg fifo "$result_fifo" --arg label "$label" --argjson choices "$choices" \
  --arg listen_again "$([ "$listen" = 0 ] || echo "$listen_again_file")" \
  '{pid: $pid, fifo: $fifo, label: $label, kind: "hints", choices: $choices | map({id, label, box}), expansions: {}, listen_again: $listen_again}' \
  >"$work_dir/pending-pick.json"
mv -f "$work_dir/pending-pick.json" "$pending_pick_file"

# Only from idle, never stopping a recording someone else started, and before the overlay shows so the microphone is
# live when the numbers appear: an answer said the moment they show is otherwise half lost. Up to 2s for voxtype to
# report it.
if [ "$listen" = 1 ]; then
  : >"$listen_again_file"
  if VOXCMD_RECORDING_OWNER_FILE="$recording_owner_file" "$voxcmd" listen --start-only; then
    for ((polls = 0; polls < 40; polls++)); do
      if [ "$(cat "$voxtype_state_file" 2>/dev/null)" = recording ] && [ -s "$recording_owner_file" ]; then break; fi
      sleep 0.05
    done
  fi
fi

# A bar that does not take the overlay hands the pick to the text picker, which takes over the pending-pick file and, for
# the reply recording started above, the same recording owner.
if [ "$("$hypr_scripts/qs-ipc" call clickhints open "$spec" 2>/dev/null)" != ok ]; then
  "$voxcmd_pick" "$label" "$text_choices" &
  child_pid=$!
  trap 'kill "$child_pid" 2>/dev/null || true; exit 1' INT TERM HUP
  wait "$child_pid"
  exit
fi
overlay_open=1

# The overlay and a number key write the box number, a voice reply the displayed label: "3" or "3. Next - top right".
timeout "$bar_timeout" head -n 1 "$result_fifo" >"$work_dir/answer" &
reader_pid=$!
wait "$reader_pid" || true
reader_pid=""
answer=$(cat "$work_dir/answer")
cleanup

number="${answer%%.*}"
[[ "$number" =~ ^[1-9][0-9]*$ ]] || exit 1
jq -r --argjson n "$number" '.[$n - 1].id // empty' <<<"$choices" | grep . || exit 1
