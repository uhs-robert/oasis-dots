#!/usr/bin/env python3
"""voxcmd-wake: listen for "Cortana" and start a voice command, with no key.

Run by voxcmd-wake.service (`voxcmd wake on`). Reads the default source through pw-record (16 kHz mono s16) into
openWakeWord with the cortana model kept in voxcmd's share folder. A trigger is only a candidate: the last 2 s of
audio go to `voxcmd _wake-confirm`, which has Whisper transcribe them, and only when that hears the wake word does it
run `voxcmd listen --start-only`, as the voice key does. The audio stays in memory (an anonymous memfd for the
confirmation). The only log is scores, verdicts and timestamps, in voxcmd's debug log while it is on.

  voxcmd-wake                run the listener
  voxcmd-wake --fetch-models download the models on first use (the unit's ExecStartPre)
  voxcmd-wake --check        exit 0 when the packages and models are in place, else 1 and say what is missing

Settings (environment, else the file Settings > Voice writes; voxcmd README "Wake word"):
  VOXCMD_WAKE_SENSITIVITY     strict, balanced or relaxed: a named threshold and frame count for the model (strict)
  VOXCMD_WAKE_THRESHOLD       score a frame needs to count; overrides the level's (strict: 0.8)
  VOXCMD_WAKE_FRAMES          consecutive 80 ms frames at or above it before a trigger is pending; overrides the level's (3)
  VOXCMD_WAKE_PAUSE_FOR_MEDIA 1 pauses while a player plays; 0 keeps listening, so a song can say the phrase (0)
  VOXCMD_WAKE_PAUSE_FOR_MIC   1 pauses while another app records from a microphone; 0 keeps listening (1)
  VOXCMD_WAKE_COOLDOWN_SECS   quiet time after a trigger (3)
  VOXCMD_WAKE_MODEL_DIR       where the downloaded feature models live (~/.local/share/voxcmd-wake/models)
"""

import os
import re

# Set before onnxruntime loads: one thread is plenty for an 80 ms frame and keeps the idle cost low.
os.environ.setdefault("OMP_NUM_THREADS", "1")

import collections
import hashlib
import io
import json
import select
import signal
import subprocess
import sys
import tempfile
import threading
import time
import urllib.request
import wave

EXIT_OK = 0
EXIT_ERROR = 1
# systemd.exec: sysexits EX_CONFIG. The unit lists it in RestartPreventExitStatus, since restarting cannot install a package.
EXIT_MISSING_SETUP = 78

SAMPLE_RATE = 16000
# openWakeWord scores audio in multiples of 80 ms.
FRAME_SAMPLES = 1280
FRAME_BYTES = FRAME_SAMPLES * 2

# Named sensitivity per wake model: level -> (threshold, frames). A model added later gets a row of its own here.
# cortana's are from 20 recorded takes at 3 frames: all 20 trigger from 0.5 to 0.75, 19 at 0.8, 18 at 0.9.
# Whisper confirms every trigger, so a false one costs a transcription rather than a command, and strict keeps those
# down (74 in 3.2 h of everyday audio at 0.8); balanced and relaxed sit inside the band where every take triggered.
SENSITIVITY_LEVELS = {
    "cortana.onnx": {"strict": (0.8, 3), "balanced": (0.7, 3), "relaxed": (0.6, 3)},
}
DEFAULT_SENSITIVITY = "strict"
DEFAULT_COOLDOWN_SECS = 3.0
DEFAULT_PAUSE_FOR_MEDIA = False
DEFAULT_PAUSE_FOR_MIC = True

# Every recording voxcmd makes of its own (this listener's, voxcmd-autostop's) carries this stream property, so the mic
# check can tell it from another app's. The value names the recorder.
VOICE_STREAM_TAG = "voxcmd.tag"
WAKE_STREAM_TAG_VALUE = "wake"

# After a trigger, how long voxtype gets to report that it is recording before the "ready" cue is given up, and how
# often its state is looked at meanwhile.
READY_WAIT_SECS = 5.0
READY_POLL_SECS = 0.1

# How often media and voxtype are looked at, and how long the loop sleeps while paused.
PAUSE_CHECK_SECS = 0.5
MEDIA_CHECK_SECS = 1.0
PAUSED_SLEEP_SECS = 0.5
READ_TIMEOUT_SECS = 0.5

# pw-record that dies is restarted after a wait that doubles up to the cap, and resets after a run this long.
BACKOFF_FIRST_SECS = 1.0
BACKOFF_CAP_SECS = 30.0
STABLE_STREAM_SECS = 10.0

# Scores below this are not worth a debug line at 12 a second.
LOG_SCORE_FLOOR = 0.2

# The audio a confirmation transcribes: the frames read up to the trigger, which fires near the end of the word.
CONFIRM_AUDIO_SECS = 2.0
CONFIRM_AUDIO_FRAMES = round(CONFIRM_AUDIO_SECS * SAMPLE_RATE / FRAME_SAMPLES)
# How long `voxtype transcribe` may take (passed to voxcmd, which enforces it), and how much longer voxcmd-wake waits
# before it kills the whole confirmation.
CONFIRM_TIMEOUT_SECS = 6
CONFIRM_KILL_GRACE_SECS = 2
CONFIRMED = "confirmed"
REJECTED = "rejected"
CONFIRM_FAILED = "failed"

# The wake model is trained for this repo on openWakeWord v0.5.1's features and tracked in voxcmd's share folder,
# found through this file's real path so a stowed and a checked-out voxcmd-wake each read their own copy.
WAKE_MODEL = "cortana.onnx"
WAKE_MODEL_SHA256 = "4c8ef56a302ed1b2863dabeaf5c84bb473dcdaf3a9ae65191608bf17ac8b1fe9"
SHARE_DIR = os.path.normpath(os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "share", "voxcmd"))

# The feature models every openWakeWord model runs on, not packaged and fetched on first use. Pinned to the v0.5.1
# release files: a download that differs is refused, and a file already in place is checked too.
MODEL_RELEASE_URL = "https://github.com/dscripka/openWakeWord/releases/download/v0.5.1/"
MODEL_SHA256 = {
    "melspectrogram.onnx": "ba2b0e0f8b7b875369a2c89cb13360ff53bac436f2895cced9f479fa65eb176f",
    "embedding_model.onnx": "70d164290c1d095d1d4ee149bc5e00543250a7316b59f31d056cff7bd3075c1f",
}
MODEL_FILES = tuple(MODEL_SHA256)


class ModelHashMismatch(Exception):
    """A model file is not the pinned release file."""


class SourceEnded(Exception):
    """The audio source closed: pw-record died or was killed."""


def runtime_dir():
    return os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "voxcmd")


def wake_model_path():
    return os.path.join(SHARE_DIR, WAKE_MODEL)


def default_model_dir():
    # Not ~/.local/share/voxcmd, which stow folds into the repo.
    data_home = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    return os.path.join(data_home, "voxcmd-wake", "models")


# Settings > Voice's file, outside the stow-folded ~/.config/voxcmd. Read as data: only KEY=NUMBER lines count.
VOICE_ENV_LINE = re.compile(r"^(VOXCMD_[A-Z_]+)=([0-9]+(?:\.[0-9]+)?|[a-z]+)$")


def voice_env_path(env):
    """The voice.env path; reads HOME from env, not the process, so a test's empty env never finds a real file."""
    override = env.get("VOXCMD_VOICE_ENV_FILE")
    if override:
        return override
    state_home = env.get("XDG_STATE_HOME") or os.path.join(env.get("HOME") or "/nonexistent", ".local", "state")
    return os.path.join(state_home, "voxcmd", "voice.env")


def read_voice_env(env):
    """KEY -> value text for the valid lines of voice.env; a missing or unreadable file is empty. The last line wins."""
    try:
        with open(voice_env_path(env), encoding="utf-8", errors="replace") as f:
            lines = f.read().splitlines()
    except OSError:
        return {}
    return {m.group(1): m.group(2) for m in map(VOICE_ENV_LINE.match, lines) if m}


class Settings:
    def __init__(self, environ=None):
        env = os.environ if environ is None else environ
        saved = read_voice_env(env)
        # An environment value that is bad refuses to start, as it always has. The file's must not: a unit that
        # exits on it would crash-loop, so a bad file value falls back to the default.
        levels = SENSITIVITY_LEVELS[WAKE_MODEL]
        level = env.get("VOXCMD_WAKE_SENSITIVITY") or saved.get("VOXCMD_WAKE_SENSITIVITY")
        if level not in levels:
            if env.get("VOXCMD_WAKE_SENSITIVITY"):
                raise ValueError("VOXCMD_WAKE_SENSITIVITY must be " + ", ".join(levels))
            level = DEFAULT_SENSITIVITY
        level_threshold, level_frames = levels[level]
        self.threshold = float(env.get("VOXCMD_WAKE_THRESHOLD") or level_threshold)
        self.frames = int(env.get("VOXCMD_WAKE_FRAMES") or level_frames)
        self.pause_for_media = self.flag(env, saved, "VOXCMD_WAKE_PAUSE_FOR_MEDIA", DEFAULT_PAUSE_FOR_MEDIA)
        self.pause_for_mic = self.flag(env, saved, "VOXCMD_WAKE_PAUSE_FOR_MIC", DEFAULT_PAUSE_FOR_MIC)
        self.cooldown_secs = float(env.get("VOXCMD_WAKE_COOLDOWN_SECS") or DEFAULT_COOLDOWN_SECS)
        self.model_dir = env.get("VOXCMD_WAKE_MODEL_DIR") or default_model_dir()
        if not 0 < self.threshold <= 1 or self.frames < 1 or self.cooldown_secs < 0:
            raise ValueError("VOXCMD_WAKE_THRESHOLD must be in (0, 1], _FRAMES at least 1, _COOLDOWN_SECS not negative")

    @staticmethod
    def flag(env, saved, key, default):
        """0 or 1 only. An environment value that is neither refuses to start; a file's falls back to the default."""
        if env.get(key):
            if env[key] not in ("0", "1"):
                raise ValueError(f"{key} must be 0 or 1")
            return env[key] == "1"
        return {"0": False, "1": True}.get(saved.get(key), default)


class TriggerDecider:
    """Turns a stream of frame scores into triggers: held high for enough frames, then a cooldown.

    It triggers on the frame that completes the hold, which the cortana model reaches near the end of the word; the
    Listener then has the trigger confirmed before anything starts."""

    def __init__(self, threshold, frames, cooldown_secs):
        self.threshold = threshold
        self.frames = frames
        self.cooldown_secs = cooldown_secs
        self.run = 0
        self.cooldown_until = 0.0

    def reset(self):
        """Forgets a phrase under way (the stream closed); the cooldown stays."""
        self.run = 0

    def update(self, score, now):
        """True once, on the frame that completes the hold."""
        if now < self.cooldown_until:
            return False
        self.run = self.run + 1 if score >= self.threshold else 0
        if self.run < self.frames:
            return False
        self.reset()
        self.cooldown_until = now + self.cooldown_secs
        return True


PAUSE = "pause"
LISTEN = "listen"


class PauseGate:
    """Whether the microphone should be left alone, decided by an ordered list of checks. A check returns PAUSE, LISTEN
    or None (no opinion); the first that has one decides, and with none the listener listens. Today's checks are
    voxtype recording, a voice session open, then, when asked to, media playing and another app recording. A rule
    that must win over the rest goes earlier in `checks`; `reason` names the check that last paused. Media and
    microphone are looked at once a second, and a check that is switched off is not in the list, so never runs."""

    def __init__(
        self,
        clock,
        voxtype_state_file,
        run_playerctl,
        session_file=None,
        proc_dir="/proc",
        pause_for_media=True,
        other_app_recording=None,
    ):
        self.clock = clock
        self.voxtype_state_file = voxtype_state_file
        self.session_file = session_file
        self.proc_dir = proc_dir
        self.reason = None
        self.checks = [
            ("voxtype_recording", lambda: PAUSE if self.voxtype_recording() else None),
            ("session_open", lambda: PAUSE if self.session_open() else None),
        ]
        if pause_for_media:
            self.checks.append(("media_playing", self.once_a_second(lambda: PAUSE if run_playerctl() else None)))
        if other_app_recording is not None:
            self.checks.append(("mic_in_use", self.once_a_second(lambda: PAUSE if other_app_recording() else None)))

    def once_a_second(self, check):
        """The check's last verdict, asked again only when MEDIA_CHECK_SECS have passed."""
        state = {"verdict": None, "next_at": 0.0}

        def cached():
            now = self.clock()
            if now >= state["next_at"]:
                state["verdict"] = check()
                state["next_at"] = now + MEDIA_CHECK_SECS
            return state["verdict"]

        return cached

    def voxtype_recording(self):
        try:
            with open(self.voxtype_state_file) as state_file:
                return state_file.read().strip() == "recording"
        except OSError:
            return False

    def process_start_time(self, pid):
        """Field 22 of /proc/<pid>/stat, counted after the last ")" as voxcmd's process_start_time does."""
        try:
            with open(os.path.join(self.proc_dir, str(pid), "stat")) as stat_file:
                fields = stat_file.read().rpartition(")")[2].split()
            return fields[19]
        except (OSError, IndexError):
            return None

    def session_open(self):
        """A session is open while its file names an owner that is alive: the same pid and start time voxcmd checks."""
        if not self.session_file:
            return False
        try:
            with open(self.session_file) as session_file:
                state = json.load(session_file)
            owner, owner_start = state["owner"], str(state["owner_start"])
        except (OSError, ValueError, KeyError, TypeError):
            return False
        return bool(owner_start) and self.process_start_time(owner) == owner_start

    def paused(self):
        for name, check in self.checks:
            verdict = check()
            if verdict is not None:
                self.reason = name if verdict == PAUSE else None
                return verdict == PAUSE
        self.reason = None
        return False


def pactl_json(*args):
    """The parsed `pactl -f json <args>` list, or None when pactl is missing, fails, times out or prints no JSON."""
    try:
        result = subprocess.run(
            ["pactl", "-f", "json", *args],
            capture_output=True,
            text=True,
            timeout=3,
            stdin=subprocess.DEVNULL,
        )
        parsed = json.loads(result.stdout) if result.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return None
    return parsed if isinstance(parsed, list) else None


class MicActivity:
    """Whether some other app holds a capture stream on a real microphone (a call, a recorder), through PipeWire's Pulse
    interface. A stream does not count when it carries voxcmd's own tag (VOICE_STREAM_TAG, set on the listener's and
    voxcmd-autostop's pw-record, so another program using pw-record still counts), is voxtype's recording, is on a
    monitor of an output, or is corked (paused, so nothing is captured). A call muted in its app keeps its stream and
    counts. Anything that cannot be read means not active, silently."""

    def __init__(self, run_pactl=pactl_json):
        self.run_pactl = run_pactl

    def other_app_recording(self):
        try:
            return self.find_other_app_recording()
        except (KeyError, TypeError, AttributeError):
            return False

    def find_other_app_recording(self):
        streams = [stream for stream in self.run_pactl("list", "source-outputs") or [] if not stream.get("corked")]
        if not streams:
            return False
        clients = {str(client["index"]): client.get("properties") or {} for client in self.run_pactl("list", "clients") or []}
        monitors = {source["index"] for source in self.run_pactl("list", "sources") or [] if self.is_monitor(source)}
        for stream in streams:
            properties = {**clients.get(str(stream.get("client")), {}), **(stream.get("properties") or {})}
            if stream.get("source") in monitors or self.is_voxtype(properties) or VOICE_STREAM_TAG in properties:
                continue
            return True
        return False

    @staticmethod
    def is_monitor(source):
        return source["name"].endswith(".monitor") or (source.get("properties") or {}).get("device.class") == "monitor"

    @staticmethod
    def is_voxtype(properties):
        names = (properties.get("application.process.binary"), properties.get("application.name"))
        return any("voxtype" in (name or "").lower() for name in names)


def playerctl_playing():
    # Every player: without --all-players playerctl reports only the first it finds, which may be a paused browser
    # while another player plays.
    try:
        result = subprocess.run(
            ["playerctl", "--all-players", "status"],
            capture_output=True,
            text=True,
            timeout=3,
            stdin=subprocess.DEVNULL,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return "Playing" in (line.strip() for line in result.stdout.splitlines())


def wav_bytes(frames):
    """The frames as a 16 kHz mono s16 WAV file's content."""
    out = io.BytesIO()
    with wave.open(out, "wb") as wav:
        wav.setnchannels(1)
        wav.setsampwidth(2)
        wav.setframerate(SAMPLE_RATE)
        wav.writeframes(b"".join(frames))
    return out.getvalue()


def start_daemon_thread(work):
    threading.Thread(target=work, daemon=True).start()


class Confirmation:
    """Runs confirm(wav) -> CONFIRMED, REJECTED or CONFIRM_FAILED off the audio loop, one at a time, so frames keep being
    read while Whisper works. The loop collects the verdict with take_verdict; busy holds until it has."""

    def __init__(self, confirm, spawn=start_daemon_thread):
        self.confirm = confirm
        self.spawn = spawn
        self.lock = threading.Lock()
        self.running = False
        self.verdict = None

    def busy(self):
        with self.lock:
            return self.running or self.verdict is not None

    def start(self, wav):
        with self.lock:
            self.running = True
        self.spawn(lambda: self.finish(wav))

    def finish(self, wav):
        try:
            verdict = self.confirm(wav)
        except Exception:  # a worker that raised must still free the next trigger
            verdict = CONFIRM_FAILED
        with self.lock:
            self.verdict = verdict
            self.running = False

    def take_verdict(self):
        with self.lock:
            verdict, self.verdict = self.verdict, None
            return verdict


class Listener:
    """One loop step at a time, so the decisions can be driven with fake audio and time."""

    def __init__(self, settings, scorer, open_source, gate, run_listen, confirmation, publish_state, clock, sleep, log):
        self.settings = settings
        self.scorer = scorer
        self.open_source = open_source
        self.gate = gate
        self.run_listen = run_listen
        self.confirmation = confirmation
        self.publish_state = publish_state
        self.clock = clock
        self.sleep = sleep
        self.log = log
        self.decider = TriggerDecider(settings.threshold, settings.frames, settings.cooldown_secs)
        # The frames read since the stream opened, up to CONFIRM_AUDIO_SECS: the audio a trigger sends to be confirmed.
        self.recent_frames = collections.deque(maxlen=CONFIRM_AUDIO_FRAMES)
        self.source = None
        self.opened_at = 0.0
        self.backoff_secs = BACKOFF_FIRST_SECS
        self.retry_at = 0.0
        self.stopping = False
        # Set at a trigger until the recording it started has ended: the bar is told "ready" while voxtype records.
        self.ready_deadline = None
        self.ready_seen = False

    def close_stream(self):
        if self.source is not None:
            self.source.close()
            self.source = None
        self.decider.reset()
        self.scorer.reset()
        self.recent_frames.clear()

    def fail_stream(self, reason):
        self.close_stream()
        self.log(f"stream: {reason}, retry in {self.backoff_secs:g}s")
        self.retry_at = self.clock() + self.backoff_secs
        self.backoff_secs = min(self.backoff_secs * 2, BACKOFF_CAP_SECS)
        self.publish_state("paused", None)

    def paused_state(self):
        """"ready" while the recording a wake trigger started is under way, else "paused"."""
        if self.ready_deadline is None:
            return "paused"
        if self.gate.voxtype_recording():
            self.ready_seen = True
            return "ready"
        if self.ready_seen or self.clock() >= self.ready_deadline:
            self.ready_deadline = None
            self.ready_seen = False
        return "paused"

    def act_on_verdict(self, verdict):
        if verdict == CONFIRMED:
            self.log("confirmed")
            self.ready_deadline = self.clock() + READY_WAIT_SECS
            self.ready_seen = False
            self.run_listen()
        elif verdict == REJECTED:
            self.log("rejected")
        else:
            self.log("confirm failed, not listening")

    def step(self):
        verdict = self.confirmation.take_verdict()
        if self.gate.paused():
            if verdict is not None:
                # What paused it (the voice key, a session, a call) has the microphone now.
                self.log(f"{verdict} while paused, dropped")
            if self.source is not None:
                self.log("paused")
                self.close_stream()
            state = self.paused_state()
            self.publish_state(state, self.gate.reason if state == "paused" else None)
            self.sleep(READY_POLL_SECS if self.ready_deadline is not None else PAUSED_SLEEP_SECS)
            return
        if verdict is not None:
            self.act_on_verdict(verdict)
        if self.ready_deadline is not None and (self.ready_seen or self.clock() >= self.ready_deadline):
            self.ready_deadline = None
            self.ready_seen = False
        if self.source is None:
            wait = self.retry_at - self.clock()
            if wait > 0:
                self.sleep(min(wait, PAUSED_SLEEP_SECS))
                return
            try:
                self.source = self.open_source()
            except OSError as error:
                self.fail_stream(f"cannot start pw-record ({error})")
                return
            self.opened_at = self.clock()
            self.log("armed")
            self.publish_state("armed", None)
        try:
            frame = self.source.read_frame(READ_TIMEOUT_SECS)
        except SourceEnded:
            self.fail_stream("pw-record ended")
            return
        if frame is None:
            return
        self.recent_frames.append(frame)
        now = self.clock()
        if now - self.opened_at >= STABLE_STREAM_SECS:
            self.backoff_secs = BACKOFF_FIRST_SECS
        score = self.scorer.score(frame)
        if score >= LOG_SCORE_FLOOR:
            self.log(f"score {score:.2f}")
        if self.decider.update(score, now):
            if self.confirmation.busy():
                self.log(f"trigger score {score:.2f} skipped, still confirming")
                return
            self.log(f"trigger score {score:.2f}, confirming")
            self.confirmation.start(wav_bytes(self.recent_frames))

    def run(self):
        while not self.stopping:
            self.step()
        self.close_stream()


class PwRecordSource:
    """pw-record's raw output cut into 80 ms frames."""

    def __init__(self):
        self.pending = b""
        self.process = subprocess.Popen(
            [
                "pw-record",
                "-P",
                f'{{ {VOICE_STREAM_TAG} = "{WAKE_STREAM_TAG_VALUE}" }}',
                "--rate",
                str(SAMPLE_RATE),
                "--channels",
                "1",
                "--format",
                "s16",
                "--raw",
                "-",
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            preexec_fn=die_with_parent,
        )
        self.fd = self.process.stdout.fileno()

    def read_frame(self, timeout):
        """A full frame, or None when none is ready within the timeout. Raises SourceEnded at the end of the audio."""
        while len(self.pending) < FRAME_BYTES:
            ready, _, _ = select.select([self.fd], [], [], timeout)
            if not ready:
                return None
            chunk = os.read(self.fd, 65536)
            if not chunk:
                raise SourceEnded()
            self.pending += chunk
        frame, self.pending = self.pending[:FRAME_BYTES], self.pending[FRAME_BYTES:]
        return frame

    def close(self):
        self.process.terminate()
        try:
            self.process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            self.process.kill()
            self.process.wait()
        self.process.stdout.close()


def die_with_parent():
    # PR_SET_PDEATHSIG: pw-record goes too if this process is killed without running its cleanup.
    import ctypes

    try:
        ctypes.CDLL(None, use_errno=True).prctl(1, signal.SIGKILL)
    except (OSError, AttributeError):
        pass


class ModelScorer:
    """The cortana model on openWakeWord's onnxruntime pipeline."""

    def __init__(self, model_dir):
        import numpy
        from openwakeword.model import Model

        self.numpy = numpy
        self.model = Model(
            wakeword_models=[wake_model_path()],
            inference_framework="onnx",
            melspec_model_path=os.path.join(model_dir, "melspectrogram.onnx"),
            embedding_model_path=os.path.join(model_dir, "embedding_model.onnx"),
        )

    def score(self, frame):
        scores = self.model.predict(self.numpy.frombuffer(frame, dtype=self.numpy.int16))
        return float(max(scores.values()))

    def reset(self):
        self.model.reset()


def load_scorer(settings):
    return ModelScorer(settings.model_dir)


def missing_setup(settings):
    """What stops the listener from starting, as a sentence, or None."""
    try:
        import numpy  # noqa: F401
        import openwakeword  # noqa: F401
    except ImportError as error:
        return f"python-openwakeword is not installed ({error})"
    if not os.path.exists(wake_model_path()):
        return f"{WAKE_MODEL} is not in {SHARE_DIR}"
    if file_sha256(wake_model_path()) != WAKE_MODEL_SHA256:
        return f"{WAKE_MODEL} in {SHARE_DIR} is not the tracked model"
    for name in MODEL_FILES:
        path = os.path.join(settings.model_dir, name)
        if not os.path.exists(path):
            return f"{name} is not in {settings.model_dir}"
        if file_sha256(path) != MODEL_SHA256[name]:
            return f"{name} in {settings.model_dir} is not the pinned release file"
    return None


def file_sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as model_file:
        for block in iter(lambda: model_file.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def fetch_models(settings, notify):
    """Makes every model file present and pinned. A file in place that differs is deleted and fetched again; a download
    that differs is deleted and raises ModelHashMismatch."""
    os.makedirs(settings.model_dir, exist_ok=True)
    for name in MODEL_FILES:
        target = os.path.join(settings.model_dir, name)
        if os.path.exists(target):
            if file_sha256(target) == MODEL_SHA256[name]:
                continue
            notify("Wake word", f"{name} does not match the release, fetching it again")
            os.unlink(target)
        notify("Wake word", f"Downloading {name}")
        partial = target + ".part"
        digest = hashlib.sha256()
        with urllib.request.urlopen(MODEL_RELEASE_URL + name, timeout=60) as response, open(partial, "wb") as out:
            while True:
                block = response.read(1 << 16)
                if not block:
                    break
                digest.update(block)
                out.write(block)
        if digest.hexdigest() != MODEL_SHA256[name]:
            os.unlink(partial)
            raise ModelHashMismatch(f"{name} downloaded with sha256 {digest.hexdigest()}, expected {MODEL_SHA256[name]}")
        os.replace(partial, target)


def notify_error(summary, body):
    try:
        subprocess.run(["notify-send", "-a", "voxcmd", summary, body], timeout=5, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        pass


def notify_info(summary, body):
    try:
        subprocess.run(
            ["notify-send", "-a", "voxcmd", "--transient", summary, body], timeout=5, stdin=subprocess.DEVNULL
        )
    except (OSError, subprocess.TimeoutExpired):
        pass


def make_logger():
    path = os.path.join(runtime_dir(), "debug.log")
    enabled = bool(os.environ.get("VOXCMD_DEBUG")) or os.path.exists(path)

    def log(message):
        if not enabled:
            return
        try:
            os.makedirs(runtime_dir(), exist_ok=True)
            stamp = time.strftime("%H:%M:%S") + f".{int(time.time() * 1000) % 1000:03d}"
            with open(path, "a") as log_file:
                log_file.write(f"{stamp} voxcmd-wake[{os.getpid()}] {message}\n")
        except OSError:
            pass

    return log


class StateFile:
    """wake.json under voxcmd's runtime dir, which the bar watches: {"state": "armed" | "ready" | "paused"}.

    ready is the recording a trigger started, the cue to speak. A paused state also carries "reason", the name of the
    PauseGate check that paused (absent when the stream failed rather than a check paused). The file is rewritten only
    when the state or reason changes."""

    def __init__(self):
        self.path = os.path.join(runtime_dir(), "wake.json")
        self.last = None

    def publish(self, state, reason=None):
        if (state, reason) == self.last:
            return
        self.last = (state, reason)
        os.makedirs(runtime_dir(), exist_ok=True)
        partial = self.path + ".tmp"
        with open(partial, "w") as state_file:
            json.dump({"state": state, "pid": os.getpid(), **({"reason": reason} if reason else {})}, state_file)
        os.replace(partial, self.path)

    def remove(self):
        try:
            os.unlink(self.path)
        except OSError:
            pass


def voxcmd_command():
    override = os.environ.get("VOXCMD_WAKE_VOXCMD")
    return override or os.path.join(os.path.dirname(os.path.realpath(__file__)), "voxcmd")


def make_run_listen(log):
    def run_listen():
        try:
            result = subprocess.run(
                [voxcmd_command(), "listen", "--start-only"],
                timeout=15,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            log(f"listen exit {result.returncode}")
        except (OSError, subprocess.TimeoutExpired) as error:
            log(f"listen failed ({error})")

    return run_listen


def private_audio_file(content):
    """content in an anonymous memfd (a file in an unlinked tmpfs inode where that is missing), read from the start.
    It has no path another process can open and is gone when closed."""
    try:
        audio = os.fdopen(os.memfd_create("voxcmd-wake-audio"), "w+b")
    except (AttributeError, OSError):
        audio = tempfile.TemporaryFile(dir=os.environ.get("XDG_RUNTIME_DIR") or None)
    audio.write(content)
    audio.seek(0)
    return audio


def make_run_confirm(log):
    """The real confirm: `voxcmd _wake-confirm /dev/stdin` with the WAV as its stdin, so the wake word and its spellings
    are matched where voxcmd keeps them. Exit 0 is the wake word, 1 is not; anything else, a timeout included, is a
    failure. Its output, which holds what was heard, is never read."""

    def run_confirm(wav):
        try:
            with private_audio_file(wav) as audio:
                process = subprocess.Popen(
                    [voxcmd_command(), "_wake-confirm", "/dev/stdin"],
                    stdin=audio,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    env={**os.environ, "VOXCMD_WAKE_CONFIRM_TIMEOUT_SECS": str(CONFIRM_TIMEOUT_SECS)},
                    # Its own process group, so a hung voxtype under voxcmd goes with it.
                    start_new_session=True,
                )
                try:
                    code = process.wait(timeout=CONFIRM_TIMEOUT_SECS + CONFIRM_KILL_GRACE_SECS)
                except subprocess.TimeoutExpired:
                    try:
                        os.killpg(process.pid, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
                    process.wait()
                    log("confirm timed out")
                    return CONFIRM_FAILED
        except OSError as error:
            log(f"confirm could not run ({error})")
            return CONFIRM_FAILED
        if code in (0, 1):
            return CONFIRMED if code == 0 else REJECTED
        log(f"confirm exit {code}")
        return CONFIRM_FAILED

    return run_confirm


def main(argv):
    try:
        settings = Settings()
    except ValueError as error:
        print(f"voxcmd-wake: {error}", file=sys.stderr)
        return EXIT_MISSING_SETUP
    if argv[:1] == ["--fetch-models"]:
        try:
            fetch_models(settings, notify_info)
        except (OSError, ModelHashMismatch) as error:
            notify_error("Wake word", "Could not fetch the models")
            print(f"voxcmd-wake: model download failed: {error}", file=sys.stderr)
            return EXIT_ERROR
        return EXIT_OK
    if argv[:1] == ["--check"]:
        problem = missing_setup(settings)
        if problem:
            print(problem)
        return EXIT_ERROR if problem else EXIT_OK
    if argv:
        print(__doc__, file=sys.stderr)
        return EXIT_ERROR

    problem = missing_setup(settings)
    if problem:
        notify_error("Wake word", problem)
        print(f"voxcmd-wake: {problem}", file=sys.stderr)
        return EXIT_MISSING_SETUP
    state_file = StateFile()
    mic_activity = MicActivity()
    log = make_logger()
    listener = Listener(
        settings,
        load_scorer(settings),
        PwRecordSource,
        PauseGate(
            time.monotonic,
            os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "voxtype", "state"),
            playerctl_playing,
            os.path.join(runtime_dir(), "session.json"),
            pause_for_media=settings.pause_for_media,
            other_app_recording=mic_activity.other_app_recording if settings.pause_for_mic else None,
        ),
        make_run_listen(log),
        Confirmation(make_run_confirm(log)),
        state_file.publish,
        time.monotonic,
        time.sleep,
        log,
    )

    def stop(*_):
        listener.stopping = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        listener.run()
    finally:
        state_file.remove()
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
