#!/usr/bin/env python3
"""Native-messaging host between voxcmd's Firefox extension and voxcmd's firefox-tab.

Firefox starts it when the extension connects, and the extension speaks on stdin/stdout: a 4-byte native-endian length,
then UTF-8 JSON. The host listens on $XDG_RUNTIME_DIR/voxcmd/firefox.sock, where each client sends one JSON line
{"cmd": ..., ...} and gets one JSON line back: {"ok": true, "result": ...} or {"ok": false, "error": "..."}.
A request is forwarded to the extension under a fresh id and answered by the reply carrying that id.

The host owns the tab thumbnails, one JPEG per URL in $XDG_CACHE_HOME/voxcmd/firefox-thumbs/<sha256(url)>.jpg, so a tab
that is not loaded (after a restart, say) still finds the last image of its page. `tabs` replies gain each tab's
`thumbnail` path and `thumbnail_at` (ms epoch) from it, and `capture` is served here: the host asks the extension for
one tab's image at a time, so one failure leaves the rest alone and no message grows with the number of tabs.
The host ends when Firefox closes stdin, and touches nothing besides stdin, stdout, its socket and that cache.
"""
import base64
import fcntl
import hashlib
import json
import os
import socket
import struct
import sys
import tempfile
import threading
import time

REPLY_TIMEOUT = 2.0
# Rendering one tab, a heavy background one included, takes longer than answering from the tab list.
CAPTURE_TIMEOUT = 5.0
# Only images of no open tab are pruned, and only once this old, so a tab closed by mistake and reopened keeps its image.
THUMBNAIL_KEEP_SECS = 7 * 24 * 3600
JPEG_DATA_URL_PREFIX = "data:image/jpeg;base64,"
# A host starting while its predecessor exits (an extension reload, a Firefox restart) waits this long for the lock.
LOCK_WAIT = 3.0
# A client that connects and sends nothing is dropped after this long.
CLIENT_TIMEOUT = 5.0
MAX_REQUEST_BYTES = 64 * 1024


class Extension:
    """The extension's end of the pipe: sends requests and matches replies to them by id."""

    def __init__(self, stdin, stdout):
        self.stdin = stdin
        self.stdout = stdout
        self.write_lock = threading.Lock()
        self.pending_lock = threading.Lock()
        self.pending = {}
        self.next_id = 0

    def send(self, message):
        data = json.dumps(message).encode()
        with self.write_lock:
            self.stdout.write(struct.pack("=I", len(data)) + data)
            self.stdout.flush()

    def read_message(self):
        header = self.stdin.read(4)
        if len(header) < 4:
            return None
        data = self.stdin.read(struct.unpack("=I", header)[0])
        return json.loads(data)

    def request(self, fields, timeout=REPLY_TIMEOUT):
        with self.pending_lock:
            self.next_id += 1
            request_id = self.next_id
            slot = {"event": threading.Event(), "reply": None}
            self.pending[request_id] = slot
        try:
            self.send({**fields, "id": request_id})
            if not slot["event"].wait(timeout):
                return {"ok": False, "error": "the extension did not answer in time"}
            return slot["reply"]
        except OSError as error:
            return {"ok": False, "error": f"the extension is gone: {error}"}
        finally:
            with self.pending_lock:
                self.pending.pop(request_id, None)

    def pump(self):
        """Delivers replies until stdin closes, then fails whatever still waits."""
        try:
            while True:
                try:
                    message = self.read_message()
                except ValueError:
                    continue
                if message is None:
                    return
                if not isinstance(message, dict):
                    continue
                with self.pending_lock:
                    slot = self.pending.get(message.get("id"))
                if slot:
                    slot["reply"] = {key: value for key, value in message.items() if key != "id"}
                    slot["event"].set()
        finally:
            with self.pending_lock:
                for slot in self.pending.values():
                    slot["reply"] = {"ok": False, "error": "the extension disconnected"}
                    slot["event"].set()


def thumbnail_dir():
    # A relative XDG_CACHE_HOME is invalid by the XDG spec and ignored.
    cache_home = os.environ.get("XDG_CACHE_HOME", "")
    if not os.path.isabs(cache_home):
        cache_home = os.path.join(os.path.expanduser("~"), ".cache")
    return os.path.join(cache_home, "voxcmd", "firefox-thumbs")


def thumbnail_path(url):
    return os.path.join(thumbnail_dir(), hashlib.sha256(url.encode()).hexdigest() + ".jpg")


def thumbnail_fields(url):
    path = thumbnail_path(url)
    try:
        return {"thumbnail": path, "thumbnail_at": os.stat(path).st_mtime_ns // 1_000_000}
    except OSError:
        return {"thumbnail": "", "thumbnail_at": 0}


def write_thumbnail(url, data_url):
    """Writes the image under a temporary name and renames it, so a reader never sees half of one."""
    if not isinstance(data_url, str) or not data_url.startswith(JPEG_DATA_URL_PREFIX):
        raise ValueError("the extension sent no JPEG")
    image = base64.b64decode(data_url[len(JPEG_DATA_URL_PREFIX):], validate=True)
    if not image.startswith(b"\xff\xd8"):
        raise ValueError("the extension sent no JPEG")
    path = thumbnail_path(url)
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".", suffix=".tmp")
    try:
        with os.fdopen(descriptor, "wb") as file:
            file.write(image)
        os.replace(temporary, path)
    except BaseException:
        os.unlink(temporary)
        raise
    return thumbnail_fields(url)


def prune_thumbnails(open_urls):
    keep = {os.path.basename(thumbnail_path(url)) for url in open_urls}
    cutoff = time.time() - THUMBNAIL_KEEP_SECS
    try:
        names = os.listdir(thumbnail_dir())
    except OSError:
        return
    for name in names:
        if name in keep:
            continue
        path = os.path.join(thumbnail_dir(), name)
        try:
            if os.stat(path).st_mtime < cutoff:
                os.unlink(path)
        except OSError:
            pass


def with_thumbnails(reply):
    if reply.get("ok") and isinstance(reply.get("result"), list):
        for tab in reply["result"]:
            if isinstance(tab, dict) and isinstance(tab.get("url"), str):
                tab.update(thumbnail_fields(tab["url"]))
    return reply


def capture_one(extension, tab_id):
    reply = extension.request({"cmd": "capture_tab", "tab_id": tab_id}, CAPTURE_TIMEOUT)
    if not reply.get("ok"):
        return {"tab_id": tab_id, "ok": False, "thumbnail": "", "thumbnail_at": 0, "error": str(reply.get("error"))}
    result = reply.get("result")
    url = result.get("url") if isinstance(result, dict) else None
    if not isinstance(url, str) or not url:
        return {"tab_id": tab_id, "ok": False, "thumbnail": "", "thumbnail_at": 0, "error": "the extension sent no URL"}
    try:
        return {"tab_id": tab_id, "ok": True, **write_thumbnail(url, result.get("data_url"))}
    except (ValueError, OSError) as error:
        return {"tab_id": tab_id, "ok": False, **thumbnail_fields(url), "error": str(error)}


def capture(extension, request):
    """Captures the asked tabs, or every loaded one, one at a time; the full tab list also says which images to keep."""
    tab_ids = request.get("tab_ids")
    if tab_ids is not None and (not isinstance(tab_ids, list) or not all(type(tab_id) is int for tab_id in tab_ids)):
        return {"ok": False, "error": "tab_ids is a list of integer tab ids"}
    listed = extension.request({"cmd": "tabs"})
    if not listed.get("ok") or not isinstance(listed.get("result"), list):
        return listed if not listed.get("ok") else {"ok": False, "error": "the extension sent no tab list"}
    tabs = [tab for tab in listed["result"] if isinstance(tab, dict)]
    # The cache outlives a private session and is keyed by URL, so a private tab's image would leak to a normal tab of
    # the same page. Private tabs reach the extension only when the owner allows it in private windows.
    private_ids = {tab.get("tab_id") for tab in tabs if tab.get("incognito")}
    if tab_ids is None:
        tab_ids = [tab["tab_id"] for tab in tabs if type(tab.get("tab_id")) is int and not tab.get("discarded")]
        tab_ids = [tab_id for tab_id in tab_ids if tab_id not in private_ids]
    results = [
        {"tab_id": tab_id, "ok": False, "thumbnail": "", "thumbnail_at": 0, "error": "private tabs are never captured"}
        if tab_id in private_ids else capture_one(extension, tab_id)
        for tab_id in tab_ids
    ]
    prune_thumbnails(tab["url"] for tab in tabs if isinstance(tab.get("url"), str))
    return {"ok": True, "result": results}


def answer(extension, request):
    fields = {key: value for key, value in request.items() if key != "id"}
    if fields["cmd"] == "capture":
        return capture(extension, fields)
    reply = extension.request(fields)
    return with_thumbnails(reply) if fields["cmd"] == "tabs" else reply


def read_line(connection):
    data = b""
    while b"\n" not in data and len(data) < MAX_REQUEST_BYTES:
        chunk = connection.recv(4096)
        if not chunk:
            break
        data += chunk
    return data.split(b"\n", 1)[0]


def serve_client(connection, extension):
    with connection:
        connection.settimeout(CLIENT_TIMEOUT)
        try:
            try:
                request = json.loads(read_line(connection))
            except ValueError:
                request = None
            if not isinstance(request, dict) or not isinstance(request.get("cmd"), str):
                reply = {"ok": False, "error": "a request is a JSON object with a cmd"}
            else:
                reply = answer(extension, request)
            connection.sendall(json.dumps(reply).encode() + b"\n")
        except OSError:
            pass


def accept_clients(listener, extension, clients):
    while True:
        try:
            connection, _ = listener.accept()
        except OSError:
            return
        client = threading.Thread(target=serve_client, args=(connection, extension), daemon=True)
        client.start()
        clients[:] = [other for other in clients if other.is_alive()]
        clients.append(client)


def take_lock(path):
    """Holds the lock file for the host's life. Whoever holds it owns the socket path: binds it, and unlinks it on exit.
    A flock goes with the process, so a crashed host leaves no stale owner, and a socket probe cannot race the way
    check-then-unlink would when two hosts start together."""
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    lock = os.open(path + ".lock", os.O_CREAT | os.O_RDWR, 0o600)
    deadline = time.monotonic() + LOCK_WAIT
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return lock
        except OSError:
            if time.monotonic() >= deadline:
                raise SystemExit("another voxcmd Firefox host holds " + path)
            time.sleep(0.05)


def bind_socket(path):
    """Binds the path, which only the lock holder calls, so whatever is there is left by a host that has gone."""
    if os.path.lexists(path):
        os.unlink(path)
    listener = socket.socket(socket.AF_UNIX)
    old_umask = os.umask(0o177)
    try:
        listener.bind(path)
    finally:
        os.umask(old_umask)
    listener.listen(8)
    return listener


def main():
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime_dir:
        raise SystemExit("XDG_RUNTIME_DIR is not set")
    path = os.path.join(runtime_dir, "voxcmd", "firefox.sock")
    lock = take_lock(path)
    listener = bind_socket(path)
    bound = os.stat(path).st_ino
    extension = Extension(sys.stdin.buffer, sys.stdout.buffer)
    clients = []
    threading.Thread(target=accept_clients, args=(listener, extension, clients), daemon=True).start()
    try:
        extension.pump()
    finally:
        listener.close()
        # Only the socket this host bound: the path is never another host's while the lock is held, but a check costs nothing.
        try:
            if os.stat(path).st_ino == bound:
                os.unlink(path)
        except OSError:
            pass
        # A client still waiting was just failed by pump; give it a moment to be told.
        for client in list(clients):
            client.join(1.0)
        os.close(lock)


if __name__ == "__main__":
    main()
