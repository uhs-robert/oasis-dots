#!/usr/bin/env python3
"""Native-messaging host between voxcmd's Firefox extension and voxcmd's firefox-tab.

Firefox starts it when the extension connects, and the extension speaks on stdin/stdout: a 4-byte native-endian length,
then UTF-8 JSON. The host listens on $XDG_RUNTIME_DIR/voxcmd/firefox.sock, where each client sends one JSON line
{"cmd": ..., ...} and gets one JSON line back: {"ok": true, "result": ...} or {"ok": false, "error": "..."}.
A request is forwarded to the extension under a fresh id and answered by the reply carrying that id.
The host ends when Firefox closes stdin, and touches nothing besides stdin, stdout and its socket.
"""
import json
import os
import socket
import struct
import sys
import threading

REPLY_TIMEOUT = 2.0
# A client that connects and sends nothing is dropped after this long.
CLIENT_TIMEOUT = 5.0
MAX_REQUEST_BYTES = 64 * 1024


class Extension:
    """The extension's end of the pipe: sends requests and matches replies to them by id."""

    def __init__(self, stdin, stdout):
        self.stdin = stdin
        self.stdout = stdout
        self.write_lock = threading.Lock()
        self.pending_lock = threading.Lock()
        self.pending = {}
        self.next_id = 0

    def send(self, message):
        data = json.dumps(message).encode()
        with self.write_lock:
            self.stdout.write(struct.pack("=I", len(data)) + data)
            self.stdout.flush()

    def read_message(self):
        header = self.stdin.read(4)
        if len(header) < 4:
            return None
        data = self.stdin.read(struct.unpack("=I", header)[0])
        return json.loads(data)

    def request(self, fields):
        with self.pending_lock:
            self.next_id += 1
            request_id = self.next_id
            slot = {"event": threading.Event(), "reply": None}
            self.pending[request_id] = slot
        try:
            self.send({**fields, "id": request_id})
            if not slot["event"].wait(REPLY_TIMEOUT):
                return {"ok": False, "error": "the extension did not answer in time"}
            return slot["reply"]
        except OSError as error:
            return {"ok": False, "error": f"the extension is gone: {error}"}
        finally:
            with self.pending_lock:
                self.pending.pop(request_id, None)

    def pump(self):
        """Delivers replies until stdin closes, then fails whatever still waits."""
        try:
            while True:
                try:
                    message = self.read_message()
                except ValueError:
                    continue
                if message is None:
                    return
                if not isinstance(message, dict):
                    continue
                with self.pending_lock:
                    slot = self.pending.get(message.get("id"))
                if slot:
                    slot["reply"] = {key: value for key, value in message.items() if key != "id"}
                    slot["event"].set()
        finally:
            with self.pending_lock:
                for slot in self.pending.values():
                    slot["reply"] = {"ok": False, "error": "the extension disconnected"}
                    slot["event"].set()


def read_line(connection):
    data = b""
    while b"\n" not in data and len(data) < MAX_REQUEST_BYTES:
        chunk = connection.recv(4096)
        if not chunk:
            break
        data += chunk
    return data.split(b"\n", 1)[0]


def serve_client(connection, extension):
    with connection:
        connection.settimeout(CLIENT_TIMEOUT)
        try:
            try:
                request = json.loads(read_line(connection))
            except ValueError:
                request = None
            if not isinstance(request, dict) or not isinstance(request.get("cmd"), str):
                reply = {"ok": False, "error": "a request is a JSON object with a cmd"}
            else:
                reply = extension.request({key: value for key, value in request.items() if key != "id"})
            connection.sendall(json.dumps(reply).encode() + b"\n")
        except OSError:
            pass


def accept_clients(listener, extension, clients):
    while True:
        try:
            connection, _ = listener.accept()
        except OSError:
            return
        client = threading.Thread(target=serve_client, args=(connection, extension), daemon=True)
        client.start()
        clients[:] = [other for other in clients if other.is_alive()]
        clients.append(client)


def socket_is_live(path):
    probe = socket.socket(socket.AF_UNIX)
    probe.settimeout(1.0)
    try:
        probe.connect(path)
        return True
    except OSError:
        return False
    finally:
        probe.close()


def bind_socket(path):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    if os.path.exists(path):
        if socket_is_live(path):
            raise SystemExit("another voxcmd Firefox host holds " + path)
        os.unlink(path)
    listener = socket.socket(socket.AF_UNIX)
    old_umask = os.umask(0o177)
    try:
        listener.bind(path)
    finally:
        os.umask(old_umask)
    listener.listen(8)
    return listener


def main():
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime_dir:
        raise SystemExit("XDG_RUNTIME_DIR is not set")
    path = os.path.join(runtime_dir, "voxcmd", "firefox.sock")
    listener = bind_socket(path)
    extension = Extension(sys.stdin.buffer, sys.stdout.buffer)
    clients = []
    threading.Thread(target=accept_clients, args=(listener, extension, clients), daemon=True).start()
    try:
        extension.pump()
    finally:
        listener.close()
        # A client still waiting was just failed by pump; give it a moment to be told.
        for client in list(clients):
            client.join(1.0)
        try:
            os.unlink(path)
        except OSError:
            pass


if __name__ == "__main__":
    main()
