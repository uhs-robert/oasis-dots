#!/usr/bin/env python3
"""Tests firefox-host with a fake extension on its stdin/stdout pipes and a temporary XDG_RUNTIME_DIR."""
import json
import os
import socket
import stat
import struct
import subprocess
import sys
import tempfile
import threading
import time
import unittest

HOST = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", ".local", "share", "voxcmd", "firefox-host")
# The tests wait for events, not for time; this bound only ends a wait for one that never comes, as in lib.sh.
WAIT_SECS = float(os.environ.get("VOXCMD_TEST_WAIT_SECS", "120"))


def wait_until(condition):
    deadline = time.monotonic() + WAIT_SECS
    while not condition():
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.02)
    return True


class FakeExtension:
    """The extension's side of the native-messaging pipes."""

    def __init__(self, runtime_dir, wait_for_socket=True):
        env = {**os.environ, "XDG_RUNTIME_DIR": runtime_dir}
        self.process = subprocess.Popen([sys.executable, HOST], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
        self.path = os.path.join(runtime_dir, "voxcmd", "firefox.sock")
        if wait_for_socket:
            wait_until(lambda: self.accepts() or self.process.poll() is not None)

    def waits_for_the_lock(self):
        """Has the lock file open: while another host holds the lock, that means this one waits for it."""
        fd_dir = f"/proc/{self.process.pid}/fd"
        try:
            return any(os.readlink(os.path.join(fd_dir, fd)) == self.path + ".lock" for fd in os.listdir(fd_dir))
        except OSError:
            return False

    def accepts(self):
        with socket.socket(socket.AF_UNIX) as probe:
            try:
                probe.connect(self.path)
                return True
            except OSError:
                return False

    def read_request(self):
        length = struct.unpack("=I", self.process.stdout.read(4))[0]
        return json.loads(self.process.stdout.read(length))

    def reply(self, message):
        data = json.dumps(message).encode()
        self.process.stdin.write(struct.pack("=I", len(data)) + data)
        self.process.stdin.flush()

    def close(self):
        self.process.stdin.close()
        return self.process.wait(timeout=WAIT_SECS)


def ask(path, line):
    """A socket client: one line out, one line back."""
    with socket.socket(socket.AF_UNIX) as client:
        client.settimeout(WAIT_SECS)
        client.connect(path)
        client.sendall(line if isinstance(line, bytes) else json.dumps(line).encode() + b"\n")
        data = b""
        while not data.endswith(b"\n"):
            chunk = client.recv(4096)
            if not chunk:
                break
            data += chunk
        return json.loads(data)


class HostTest(unittest.TestCase):
    def setUp(self):
        self.runtime_dir = tempfile.mkdtemp(prefix="vxh")
        self.addCleanup(subprocess.run, ["rm", "-rf", self.runtime_dir])
        self.extension = FakeExtension(self.runtime_dir)
        self.addCleanup(self.stop)

    def stop(self):
        if self.extension.process.poll() is None:
            self.extension.process.kill()
            self.extension.process.wait()
        for stream in (self.extension.process.stdin, self.extension.process.stdout, self.extension.process.stderr):
            stream.close()

    def ask_in_thread(self, line, results, key):
        thread = threading.Thread(target=lambda: results.__setitem__(key, ask(self.extension.path, line)))
        thread.start()
        return thread

    def test_request_is_framed_with_a_fresh_id_and_the_reply_matched(self):
        results = {}
        thread = self.ask_in_thread({"cmd": "activate", "tab_id": 5, "id": "client-chosen"}, results, "a")
        request = self.extension.read_request()
        self.assertEqual({key: request[key] for key in ("cmd", "tab_id")}, {"cmd": "activate", "tab_id": 5})
        self.assertNotEqual(request["id"], "client-chosen")
        self.extension.reply({"id": request["id"], "ok": True, "result": {"title": "T — café"}})
        thread.join(WAIT_SECS)
        self.assertEqual(results["a"], {"ok": True, "result": {"title": "T — café"}})

    def test_replies_out_of_order_reach_their_own_clients(self):
        results = {}
        first = self.ask_in_thread({"cmd": "tabs"}, results, "first")
        request_one = self.extension.read_request()
        second = self.ask_in_thread({"cmd": "activate", "tab_id": 2}, results, "second")
        request_two = self.extension.read_request()
        self.assertNotEqual(request_one["id"], request_two["id"])
        self.extension.reply({"id": request_two["id"], "ok": True, "result": "two"})
        self.extension.reply({"id": request_one["id"], "ok": False, "error": "one failed"})
        first.join(WAIT_SECS)
        second.join(WAIT_SECS)
        self.assertEqual(results["first"], {"ok": False, "error": "one failed"})
        self.assertEqual(results["second"], {"ok": True, "result": "two"})

    def test_an_unknown_reply_id_is_ignored(self):
        results = {}
        thread = self.ask_in_thread({"cmd": "tabs"}, results, "a")
        request = self.extension.read_request()
        self.extension.reply({"id": 999, "ok": True, "result": "stray"})
        self.extension.reply({"id": request["id"], "ok": True, "result": []})
        thread.join(WAIT_SECS)
        self.assertEqual(results["a"], {"ok": True, "result": []})

    def test_no_answer_times_out_after_about_two_seconds(self):
        started = time.monotonic()
        reply = ask(self.extension.path, {"cmd": "tabs"})
        self.assertFalse(reply["ok"])
        self.assertIn("in time", reply["error"])
        self.assertGreater(time.monotonic() - started, 1.8)

    def test_bad_requests_are_answered_with_an_error_and_not_forwarded(self):
        for line in (b"not json\n", b"[1]\n", b'{"tab_id": 1}\n'):
            self.assertFalse(ask(self.extension.path, line)["ok"])
        results = {}
        thread = self.ask_in_thread({"cmd": "tabs"}, results, "a")
        request = self.extension.read_request()
        self.assertEqual(request["cmd"], "tabs")
        self.extension.reply({"id": request["id"], "ok": True, "result": 1})
        thread.join(WAIT_SECS)

    def test_socket_and_directory_are_private(self):
        self.assertEqual(stat.S_IMODE(os.stat(self.extension.path).st_mode), 0o600)
        self.assertEqual(stat.S_IMODE(os.stat(os.path.dirname(self.extension.path)).st_mode), 0o700)

    def test_a_second_host_refuses_while_the_first_lives(self):
        second = subprocess.run([sys.executable, HOST], stdin=subprocess.PIPE, capture_output=True, env={**os.environ, "XDG_RUNTIME_DIR": self.runtime_dir}, timeout=WAIT_SECS)
        self.assertNotEqual(second.returncode, 0)
        self.assertIn(b"another voxcmd Firefox host", second.stderr)
        results = {}
        thread = self.ask_in_thread({"cmd": "tabs"}, results, "a")
        request = self.extension.read_request()
        self.extension.reply({"id": request["id"], "ok": True, "result": "still first"})
        thread.join(WAIT_SECS)
        self.assertEqual(results["a"]["result"], "still first")

    def test_a_host_starting_as_the_first_exits_takes_over_and_keeps_its_socket(self):
        second = FakeExtension(self.runtime_dir, wait_for_socket=False)
        self.addCleanup(lambda: [second.process.poll() is None and second.process.kill(), second.process.wait(), second.process.stdin.close(), second.process.stdout.close(), second.process.stderr.close()])
        self.assertTrue(wait_until(second.waits_for_the_lock))
        self.extension.close()
        wait_until(second.accepts)
        results = {}
        thread = threading.Thread(target=lambda: results.update(a=ask(second.path, {"cmd": "tabs"})))
        thread.start()
        request = second.read_request()
        second.reply({"id": request["id"], "ok": True, "result": "second"})
        thread.join(WAIT_SECS)
        self.assertEqual(results["a"]["result"], "second")
        # close() waited for the first host to exit, so whatever it removes on the way out is gone by now.
        self.assertTrue(os.path.exists(second.path))

    def test_closing_stdin_ends_the_host_and_removes_the_socket(self):
        self.assertEqual(self.extension.close(), 0)
        self.assertFalse(os.path.exists(self.extension.path))

    def test_a_request_waiting_when_the_extension_goes_is_failed_at_once(self):
        results = {}
        thread = self.ask_in_thread({"cmd": "tabs"}, results, "a")
        self.extension.read_request()
        self.extension.close()
        thread.join(WAIT_SECS)
        # Failed by the disconnect, not by waiting out the reply timeout.
        self.assertEqual(results["a"], {"ok": False, "error": "the extension disconnected"})


class StaleSocketTest(unittest.TestCase):
    def test_a_stale_socket_file_is_replaced(self):
        runtime_dir = tempfile.mkdtemp(prefix="vxh")
        self.addCleanup(subprocess.run, ["rm", "-rf", runtime_dir])
        os.makedirs(os.path.join(runtime_dir, "voxcmd"), mode=0o700)
        stale = socket.socket(socket.AF_UNIX)
        stale.bind(os.path.join(runtime_dir, "voxcmd", "firefox.sock"))
        stale.close()
        extension = FakeExtension(runtime_dir)
        try:
            results = {}
            thread = threading.Thread(target=lambda: results.update(a=ask(extension.path, {"cmd": "tabs"})))
            thread.start()
            request = extension.read_request()
            extension.reply({"id": request["id"], "ok": True, "result": []})
            thread.join(WAIT_SECS)
            self.assertEqual(results["a"], {"ok": True, "result": []})
        finally:
            extension.close()
            for stream in (extension.process.stdout, extension.process.stderr):
                stream.close()


if __name__ == "__main__":
    unittest.main()
