#!/usr/bin/env python3
"""Stands in for firefox-host in the voxcmd tests: answers `tabs` and `activate` on $XDG_RUNTIME_DIR/voxcmd/firefox.sock.

  firefox-fake-host <tabs.json> <requests.log> [error|silent-activate|malformed-tabs|malformed-activate]

Every request line is appended to <requests.log>. `tabs` returns the fixture; `activate` returns the title and window
of the tab with that id, or an error for an unknown one. With "error" every request is answered with an error.
"""
import json
import os
import socket
import sys
import time

tabs_path, requests_log = sys.argv[1:3]
mode = sys.argv[3] if len(sys.argv) > 3 else ""
tabs = json.load(open(tabs_path))
path = os.path.join(os.environ["XDG_RUNTIME_DIR"], "voxcmd", "firefox.sock")
os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
if os.path.exists(path):
    os.unlink(path)
listener = socket.socket(socket.AF_UNIX)
listener.bind(path)
listener.listen(4)
while True:
    connection, _ = listener.accept()
    with connection:
        line = connection.makefile().readline()
        with open(requests_log, "a") as log:
            log.write(line)
        request = json.loads(line)
        tab = next((tab for tab in tabs if tab["tab_id"] == request.get("tab_id")), None)
        if mode == "silent-activate" and request["cmd"] == "activate":
            time.sleep(5)
            continue
        if mode == "error":
            reply = {"ok": False, "error": "refused"}
        elif mode == "malformed-tabs" and request["cmd"] == "tabs":
            reply = {"ok": True, "result": [{"tab_id": "x", "window_id": 1}]}
        elif mode == "malformed-activate" and request["cmd"] == "activate":
            reply = {"ok": True, "result": "done"}
        elif request["cmd"] == "tabs":
            reply = {"ok": True, "result": tabs}
        elif request["cmd"] == "activate" and tab:
            reply = {"ok": True, "result": {"activated": True, "title": tab["title"], "window_id": tab["window_id"], "focused": True, "preface_set": True}}
        elif request["cmd"] == "clear_preface":
            reply = {"ok": True, "result": {"cleared": True}}
        else:
            reply = {"ok": False, "error": "No tab with that id"}
        connection.sendall(json.dumps(reply).encode() + b"\n")
