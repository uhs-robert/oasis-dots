#!/usr/bin/env bash
# VOXCMD_ASK_CMD for the suites: called as `ask-stub <kind> <args>` for every question the voxcmd under test asks on its
# own (a run's confirm or pick, the hints overlay's fall back to the text picker), it runs voxcmd-<kind> from the
# directory of VOXCMD_LEGACY_BIN. A suite stubs those in its package copy, so the answers and the lines they log are
# what the suite expects.
set -euo pipefail

kind=${1:?usage: ask-stub pick|confirm|hints <args>}
shift
exec "$(dirname "${VOXCMD_LEGACY_BIN:?ask-stub needs VOXCMD_LEGACY_BIN}")/voxcmd-$kind" "$@"
