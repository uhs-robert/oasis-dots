#!/usr/bin/env python3
"""Fetch a private iCal feed and write normalized events to the calendar cache.

Usage: calendar-sync [--now] [--ics FILE] [--at ISO8601]
       calendar-sync setup [--at ISO8601]   guided connection of your calendar

The feed address is a credential. A secret-store command (the system keyring
by default) prints it into memory, and it never reaches argv, output, the cache
or an error message.
"""

import argparse
import base64
import datetime as dt
import getpass
import json
import os
import re
import select
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

DEFAULT_RBW_ENTRY = "google-calendar-ical"
URL_COMMAND_TIMEOUT_SECONDS = 20
MAX_COMMAND_OUTPUT_BYTES = 64 * 1024
KILL_WAIT_SECONDS = 2
KEYRING_STORE_TIMEOUT_SECONDS = 120
LOCKED_RBW_EXIT_CODE = 3
LOCKED_KEYRING_EXIT_CODE = 4
DEFAULT_DAYS_BACK = 30
DEFAULT_DAYS_AHEAD = 365
MAX_WINDOW_DAYS = 3650
MAX_FEED_BYTES = 32 * 1024 * 1024
FETCH_TIMEOUT_SECONDS = 30

MEET_URL_PATTERN = re.compile(r"https://meet\.google\.com/[\w/-]+(?:\?[\w=&%.-]+)?")
TEAMS_URL_PATTERN = re.compile(r"https://teams\.microsoft\.com/l/meetup-join/[^\s<>\"')\]]+")
GOOGLE_EVENT_ID_PATTERN = re.compile(r"^[a-z0-9_]+$")
EMAIL_PATTERN = re.compile(r"^[^@/\s]+@[^@/\s]+$")


class SyncError(Exception):
    """A failure whose message is safe to write to disk.

    A transient one (network, HTTP) is recorded but exits 0, so a laptop that
    goes offline does not leave the timer's unit in `systemctl --failed`.
    """

    def __init__(self, message, transient=False):
        super().__init__(message)
        self.transient = transient


class NotConfigured(Exception):
    """Nothing to sync yet; the timer stays silent, like a locked vault."""


def cache_dir():
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    return Path(base) / "calendar"


def is_git_marker(git_path):
    """A .git file (a worktree's pointer) or a .git directory holding HEAD, as git itself counts them. An empty .git
    directory is not one: sandboxes such as Codex's create it in /tmp as a mount point."""
    return git_path.is_file() or (git_path / "HEAD").is_file()


def inside_git_work_tree(path):
    path = path.resolve()
    return any(is_git_marker(candidate / ".git") for candidate in [path, *path.parents])


def write_json_atomically(path, payload):
    fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".")
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump(payload, handle, indent=2, ensure_ascii=False)
            handle.write("\n")
        os.replace(tmp_name, path)
    except BaseException:
        Path(tmp_name).unlink(missing_ok=True)
        raise


def config_dir():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return Path(base) / "calendar-sync"


def is_private_to_me(path):
    """Owned by me and not writable by group or others, judged on the link itself."""
    info = path.lstat()
    return info.st_uid == os.getuid() and not info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)


def require_trustworthy_config(config_path):
    """The config names a command we will run, so anyone who can edit it can run code as me.

    It must not sit in a git work tree either: a stow-folded link would make it
    part of a checkout that other people's commits can change.
    """
    for item in (config_path.parent, config_path):
        if not is_private_to_me(item) or inside_git_work_tree(item):
            raise SyncError("the config file or its directory is writable by others or inside a git work tree")


def read_config_values():
    """The `key = value` lines of the config; the first of a repeated key wins, blank and `#` lines are skipped.

    A key with an empty value is kept, so `days_ahead =` is rejected rather than quietly using the default.
    """
    path = config_dir() / "config"
    if not os.path.lexists(path):
        return {}
    require_trustworthy_config(path)
    try:
        lines = path.read_text().splitlines()
    except OSError:
        return {}
    values = {}
    for line in lines:
        key, separator, value = line.partition("=")
        if separator and not key.strip().startswith("#"):
            values.setdefault(key.strip(), value.strip())
    return values


def configured_url_command():
    """The command, which prints the address and never holds it."""
    return read_config_values().get("url_command") or None


def window_days(values, key, default):
    raw = values.get(key)
    if raw is None:
        return default
    if not (raw.isascii() and raw.isdigit()) or int(raw) > MAX_WINDOW_DAYS:
        raise SyncError(f"days_back and days_ahead must be whole numbers from 0 to {MAX_WINDOW_DAYS}")
    return int(raw)


def local_midnight(day):
    return dt.datetime.combine(day, dt.time()).astimezone()


def sync_window(now):
    """Local midnight `days_back` days ago up to, excluding, local midnight after day `days_ahead`.

    Whole days, so a consumer can tell a day it synced from one it never looked at.
    """
    values = read_config_values()
    days_back = window_days(values, "days_back", DEFAULT_DAYS_BACK)
    days_ahead = window_days(values, "days_ahead", DEFAULT_DAYS_AHEAD)
    today = now.date()
    return (
        local_midnight(today - dt.timedelta(days=days_back)),
        local_midnight(today + dt.timedelta(days=days_ahead + 1)),
    )


def url_command():
    return configured_url_command() or KEYRING_COMMAND


def command_program(command):
    """Basename of the first word, after any leading VAR=value words."""
    try:
        words = shlex.split(command)
    except ValueError:
        return None
    for word in words:
        if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", word):
            return os.path.basename(word)
    return None


def needs_unlocked_rbw(command):
    return command_program(command) == "rbw"


def needs_unlocked_keyring(command):
    return command_program(command) == "secret-tool"


KEYRING_LOCKED_QUERIES = (
    [
        "busctl", "--user", "get-property", "org.freedesktop.secrets",
        "/org/freedesktop/secrets/aliases/default", "org.freedesktop.Secret.Collection", "Locked",
    ],
    [
        "gdbus", "call", "--session", "--dest", "org.freedesktop.secrets",
        "--object-path", "/org/freedesktop/secrets/aliases/default",
        "--method", "org.freedesktop.DBus.Properties.Get", "org.freedesktop.Secret.Collection", "Locked",
    ],
)


def keyring_is_unlocked():
    """Asks the Secret Service over D-Bus, which never prompts, unlike secret-tool.

    Unknown (no tool, no service) counts as locked, so the timer never raises an unlock dialog.
    """
    for query in KEYRING_LOCKED_QUERIES:
        try:
            result = subprocess.run(
                query, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=10
            )
        except (OSError, subprocess.TimeoutExpired):
            continue
        answer = result.stdout.lower()
        if result.returncode == 0 and ("false" in answer or "true" in answer):
            return "false" in answer
    return False


def rbw_is_unlocked():
    try:
        result = subprocess.run(
            ["rbw", "unlocked"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0


def stop_process_group(process):
    if process.poll() is None:  # a reaped group's id may already belong to someone else
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            pass
    process.stdout.close()
    try:
        process.wait(timeout=KILL_WAIT_SECONDS)
    except subprocess.TimeoutExpired:
        pass


def read_bounded_output(process, deadline):
    """Reads stdout up to MAX_COMMAND_OUTPUT_BYTES, and gives up at the deadline.

    A descendant that escapes the process group (setsid) can hold the pipe open
    forever, so waiting for end-of-file, as communicate() does, is not an option.
    """
    chunks, total = [], 0
    descriptor = process.stdout.fileno()
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0 or not select.select([descriptor], [], [], remaining)[0]:
            raise NotConfigured("url_command timed out")
        chunk = os.read(descriptor, 4096)
        if not chunk:
            return b"".join(chunks)
        total += len(chunk)
        if total > MAX_COMMAND_OUTPUT_BYTES:
            raise NotConfigured("url_command printed too much")
        chunks.append(chunk)


def run_url_command(command):
    """Its output is the credential, so it is only ever returned, never printed."""
    timeout = float(os.environ.get("CALENDAR_SYNC_COMMAND_TIMEOUT") or URL_COMMAND_TIMEOUT_SECONDS)
    deadline = time.monotonic() + timeout
    # A new session detaches it from the terminal, but an agent-based manager
    # can still pop a GUI pinentry; the timeout bounds that, and killing the
    # process group stops a hung child.
    process = subprocess.Popen(
        ["sh", "-c", command],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    try:
        output = read_bounded_output(process, deadline)
        process.wait(timeout=max(deadline - time.monotonic(), 0.1))
    except subprocess.TimeoutExpired:
        raise NotConfigured("url_command timed out") from None
    finally:
        stop_process_group(process)
    text = output.decode(errors="replace").strip()
    if process.returncode != 0 or not text:
        raise NotConfigured("url_command failed or printed nothing")
    return text


def normalize_feed_url(url):
    if url.startswith("webcal://"):
        url = "https://" + url[len("webcal://") :]
    allowed_schemes = {"https"}
    if os.environ.get("CALENDAR_SYNC_ALLOW_FILE_URL") == "1":
        allowed_schemes.add("file")  # tests serve the fixture without a network
    if urllib.parse.urlsplit(url).scheme not in allowed_schemes:
        raise SyncError("the address is not an https address")
    return url


def read_feed_url(command):
    try:
        url = run_url_command(command)
    except OSError:
        raise NotConfigured("url_command could not run")
    return normalize_feed_url(url)


def fetch_feed(url):
    try:
        with urllib.request.urlopen(url, timeout=FETCH_TIMEOUT_SECONDS) as response:
            body = response.read(MAX_FEED_BYTES + 1)
    except urllib.error.HTTPError as err:
        raise SyncError(f"fetch failed with HTTP {err.code}", transient=True) from None
    except Exception:
        raise SyncError("fetch failed", transient=True) from None
    if len(body) > MAX_FEED_BYTES:
        raise SyncError("feed is too large")
    return body


def google_calendar_id(feed_url, calendar):
    """The id Google puts in an event page link, taken from the feed address
    (.../calendar/ical/<id>/private-<token>/basic.ics) or else the calendar name."""
    if feed_url:
        parts = urllib.parse.urlsplit(feed_url)
        segments = parts.path.split("/")
        if parts.hostname == "calendar.google.com" and segments[1:3] == ["calendar", "ical"]:
            candidate = urllib.parse.unquote(segments[3]) if len(segments) > 3 else ""
            if EMAIL_PATTERN.match(candidate):
                return candidate
    name = str(calendar.get("X-WR-CALNAME", ""))
    return name if EMAIL_PATTERN.match(name) else None


def to_local_datetime(value):
    """Dates become local midnight and floating times are taken as local."""
    if isinstance(value, dt.datetime):
        return value.astimezone()
    return dt.datetime.combine(value, dt.time()).astimezone()


def instance_suffix(value):
    if isinstance(value, dt.datetime):
        return to_local_datetime(value).astimezone(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    return value.strftime("%Y%m%d")


def day_view_url(start):
    return f"https://calendar.google.com/calendar/r/day/{start.year}/{start.month}/{start.day}"


def google_event_url(uid, suffix, calendar_id):
    if not calendar_id or not uid.endswith("@google.com"):
        return None
    event_id = uid[: -len("@google.com")]
    if not GOOGLE_EVENT_ID_PATTERN.match(event_id):
        return None
    if suffix:
        event_id += "_" + suffix
    raw = f"{event_id} {calendar_id}".encode()
    eid = base64.urlsafe_b64encode(raw).decode().rstrip("=")
    return "https://calendar.google.com/calendar/event?eid=" + eid


def https_url(value):
    text = str(value).strip()
    return text if text.startswith("https://") else None


def first_match(pattern, component, fields):
    for field in fields:
        match = pattern.search(str(component.get(field, "")))
        if match:
            return match.group(0)
    return None


def find_join_url(component):
    """Google Meet first, then Microsoft Teams. The dedicated property wins over
    text because a real feed carries both and only the property is exact."""
    for property_name, pattern, fields in (
        ("X-GOOGLE-CONFERENCE", MEET_URL_PATTERN, ("LOCATION", "DESCRIPTION", "URL")),
        ("X-MICROSOFT-SKYPETEAMSMEETINGURL", TEAMS_URL_PATTERN, ("DESCRIPTION", "LOCATION")),
    ):
        url = https_url(component.get(property_name, "")) or first_match(pattern, component, fields)
        if url:
            return url
    return None


def mailto_address(value):
    return re.sub(r"^mailto:", "", str(value), flags=re.IGNORECASE)


def attendee_addresses(component):
    raw = component.get("ATTENDEE", [])
    if not isinstance(raw, list):
        raw = [raw]
    return [mailto_address(item) for item in raw]


def normalize_event(component, recurring_uids, calendar_id):
    uid = str(component.get("UID", ""))
    start_value = component.decoded("DTSTART")
    end_value = component.get("DTEND") and component.decoded("DTEND")
    all_day = not isinstance(start_value, dt.datetime)
    if end_value is None:
        end_value = start_value + (dt.timedelta(days=1) if all_day else dt.timedelta())
    start = to_local_datetime(start_value)
    end = to_local_datetime(end_value)

    recurrence_id = component.get("RECURRENCE-ID")
    # The library stamps RECURRENCE-ID on every occurrence it returns, so only
    # the source feed says whether this event belongs to a series.
    suffix = None
    if uid in recurring_uids:
        suffix = instance_suffix(recurrence_id.dt if recurrence_id is not None else start_value)

    status = str(component.get("STATUS", "confirmed")).lower()
    if status not in ("confirmed", "tentative", "cancelled"):
        status = "confirmed"

    organizer = component.get("ORGANIZER")
    return {
        "uid": f"{uid}#{suffix}" if suffix else uid,
        "title": str(component.get("SUMMARY", "")),
        "start": start.isoformat(),
        "end": end.isoformat(),
        "all_day": all_day,
        "location": str(component.get("LOCATION", "")),
        "join_url": find_join_url(component),
        "event_url": google_event_url(uid, suffix, calendar_id) or day_view_url(start),
        "status": status,
        "organizer": mailto_address(organizer) if organizer else "",
        "attendees": attendee_addresses(component),
    }


def expand_events(feed, window_start, window_end, feed_url):
    import icalendar
    import recurring_ical_events

    try:
        calendar = icalendar.Calendar.from_ical(feed)
        recurring_uids = {
            str(item.get("UID", ""))
            for item in calendar.walk("VEVENT")
            if item.get("RRULE") is not None or item.get("RECURRENCE-ID") is not None
        }
        components = recurring_ical_events.of(calendar).between(window_start, window_end)
        calendar_id = google_calendar_id(feed_url, calendar)
        events = [normalize_event(item, recurring_uids, calendar_id) for item in components]
    except Exception:
        raise SyncError("feed could not be parsed") from None
    # ISO strings with different offsets do not sort chronologically across a DST change.
    events.sort(key=lambda event: (dt.datetime.fromisoformat(event["start"]), event["title"]))
    return events


def poke_bar():
    try:
        subprocess.run(
            ["qs-ipc", "call", "calendar", "refresh"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass


def parse_args(argv):
    parser = argparse.ArgumentParser(description="Sync the iCal feed into the calendar cache.")
    parser.add_argument("command", nargs="?", choices=["setup"], help="setup: connect your calendar interactively")
    parser.add_argument("--check", action="store_true", help=argparse.SUPPRESS)  # setup: exit 0 if already connected
    parser.add_argument("--now", action="store_true", help="manual run: report the outcome instead of staying silent")
    parser.add_argument("--ics", metavar="FILE", help="read this iCal file instead of fetching the feed")
    parser.add_argument("--at", metavar="ISO8601", help="treat this as the current time (tests)")
    return parser.parse_args(argv)


def current_time(args):
    now = dt.datetime.fromisoformat(args.at) if args.at else dt.datetime.now()
    return now.astimezone()


def libraries_available():
    try:
        import icalendar  # noqa: F401
        import recurring_ical_events  # noqa: F401
    except ImportError:
        return False
    return True


def quiet_skip(args, reason):
    if args.now:
        print(f"calendar-sync: {reason}", file=sys.stderr)
    return 0


def sync(args, directory):
    feed_url = None
    if not libraries_available():
        return quiet_skip(args, "install python-icalendar and python-recurring-ical-events")
    if args.ics:
        feed = Path(args.ics).read_bytes()
    else:
        command = url_command()
        if needs_unlocked_rbw(command) and not rbw_is_unlocked():
            return quiet_skip(args, "rbw is locked; unlock it and run again")
        if needs_unlocked_keyring(command) and not keyring_is_unlocked():
            return quiet_skip(args, "the keyring is locked; it should unlock at login")
        try:
            feed_url = read_feed_url(command)
        except NotConfigured as err:
            return quiet_skip(args, f"{err}; see home/calendar/README.md")
        feed = fetch_feed(feed_url)

    now = current_time(args)
    window_start, window_end = sync_window(now)
    events = expand_events(feed, window_start, window_end, feed_url)
    write_json_atomically(
        directory / "events.json",
        {
            "updated": now.isoformat(timespec="seconds"),
            "source": "ical",
            "window_start": window_start.isoformat(),
            "window_end": window_end.isoformat(),
            "events": events,
        },
    )
    (directory / "error.json").unlink(missing_ok=True)
    poke_bar()
    if args.now:
        print(f"synced {len(events)} events")
    return 0


# --- guided setup ---------------------------------------------------------------

GOOGLE_SETTINGS_URL = "https://calendar.google.com/calendar/r/settings"
KEYRING_ATTRIBUTES = ["service", "calendar-sync", "key", "ical-url"]
KEYRING_COMMAND = "secret-tool lookup " + " ".join(KEYRING_ATTRIBUTES)


class SetupAborted(Exception):
    """The user declined or cancelled, or a step failed; nothing further is written."""


class Prompter:
    """Questions for `setup`.

    CALENDAR_SYNC_SETUP_ANSWERS names a file with one answer per line, which
    replaces the terminal. It exists only so tests can drive setup, so it is
    honored only together with CALENDAR_SYNC_ALLOW_FILE_URL=1; prompts are
    still printed, answers never are.
    """

    def __init__(self):
        scripted_path = os.environ.get("CALENDAR_SYNC_SETUP_ANSWERS")
        in_test_mode = os.environ.get("CALENDAR_SYNC_ALLOW_FILE_URL") == "1"
        self.scripted = Path(scripted_path).read_text().splitlines() if scripted_path and in_test_mode else None

    def is_interactive(self):
        return self.scripted is not None or (sys.stdin.isatty() and sys.stdout.isatty())

    def ask(self, question, secret=False):
        if self.scripted is not None:
            print(question)
            if not self.scripted:
                raise SetupAborted("no more scripted answers")
            return self.scripted.pop(0).strip()
        try:
            return (getpass.getpass(question) if secret else input(question)).strip()
        except EOFError:
            raise SetupAborted("input closed") from None

    def confirm(self, question, default=False):
        answer = self.ask(f"{question} [{'Y/n' if default else 'y/N'}] ").lower()
        return default if not answer else answer.startswith("y")


def capture(command, stdin_text=None, timeout=15):
    """Runs a helper and returns (exit code, stdout, stderr); callers must not print stdout."""
    try:
        result = subprocess.run(
            command,
            input=stdin_text,
            text=True,
            capture_output=True,
            stdin=None if stdin_text is not None else subprocess.DEVNULL,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired):
        return 127, "", ""
    return result.returncode, result.stdout, result.stderr


def run_quietly(command, stdin_text=None, timeout=15):
    """Like capture, but only the exit code; the address goes in on stdin, never argv."""
    return capture(command, stdin_text, timeout)[0]


def tool_state(tool, is_unlocked):
    if shutil.which(tool) is None:
        return "missing"
    return "unlocked" if is_unlocked() else "locked"


def rbw_state():
    return tool_state("rbw", rbw_is_unlocked)


def keyring_state():
    return tool_state("secret-tool", keyring_is_unlocked)


def private_file_path():
    base = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    return Path(base) / "calendar-sync" / "ical-url"


def config_file_path():
    return config_dir() / "config"


def ensure_private_directory(path):
    """Creates it 0700, or tightens a directory of mine; one that is not mine is never used."""
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = path.lstat()
    if info.st_uid != os.getuid() or not stat.S_ISDIR(info.st_mode):
        raise SyncError("a calendar-sync directory exists but is not yours")
    os.chmod(path, 0o700)


def store_in_private_file(address):
    path = private_file_path()
    ensure_private_directory(path.parent)
    fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix="ical-url.")
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(address + "\n")
        os.chmod(tmp_name, 0o600)
        os.replace(tmp_name, path)
    except BaseException:
        Path(tmp_name).unlink(missing_ok=True)
        raise
    return f"cat {shlex.quote(str(path))}", f"a private file ({path})"


def store_in_keyring(address):
    command = ["secret-tool", "store", "--label=calendar-sync iCal address", *KEYRING_ATTRIBUTES]
    if run_quietly(command, stdin_text=address + "\n", timeout=KEYRING_STORE_TIMEOUT_SECONDS) != 0:
        raise SetupAborted("the keyring refused the address")
    return KEYRING_COMMAND, "the system keyring"


def rbw_entry_exists(entry):
    code, _, error_text = capture(["rbw", "get", "--", entry])
    if code == 0:
        return True
    message = error_text.lower()
    if "multiple" in message:
        raise SetupAborted(f"rbw has several entries named {entry}; rename or remove the extras first")
    if "no entry" in message:
        return False
    raise SetupAborted("rbw could not look up the entry")


def store_in_rbw(address, entry, entry_exists):
    """Edits an existing entry in place, keeping its notes, so a failure can never lose it."""
    if entry_exists:
        code, notes, _ = capture(["rbw", "get", "--field", "notes", "--", entry])
        if code != 0:
            raise SetupAborted("rbw could not read the existing entry; it was left as it was")
        command, body = ["rbw", "edit", "--", entry], address + "\n" + notes
    else:
        command, body = ["rbw", "add", "--", entry], address + "\n"
    if run_quietly(command, stdin_text=body, timeout=60) != 0:
        raise SetupAborted("rbw could not save the entry; any existing entry was left as it was")
    return f"rbw get -- {shlex.quote(entry)}", f"rbw (entry {entry})"


def choose_backend(prompter):
    rbw, keyring = rbw_state(), keyring_state()
    usable = {}
    # The keyring comes first because it unlocks with the login, so the timer can read it all session; rbw locks
    # again after its lock_timeout and the calendar then goes stale until something unlocks it.
    if keyring == "unlocked":
        usable["keyring"] = "the system keyring (secret-tool)"
    if rbw == "unlocked":
        usable["rbw"] = "rbw"
    usable["file"] = "a private file"
    if keyring == "locked":
        print("The keyring is locked, so it is not offered; unlock it (it normally unlocks at login) to use it.")
    # A lock must not quietly steer Auto to a weaker home for the address.
    password_store_locked = "locked" in (keyring, rbw)
    automatic = next(iter(usable))
    if automatic == "file" and password_store_locked:
        automatic = None
    options = [("auto", f"Auto (recommended): {usable[automatic]}")] if automatic else []
    if not automatic:
        print("A password store is installed but locked, so there is no Auto choice: unlock it and run setup again, or pick another.")
    if rbw == "locked":
        options.append(("rbw-locked", "rbw (locked, unlock it first)"))
    options += list(usable.items())
    print("Where should the address be stored?")
    for number, (_, label) in enumerate(options, 1):
        print(f"  {number}) {label}")
    while True:
        answer = prompter.ask("Choice [1]: " if automatic else "Choice: ").lower()
        for number, (key, _) in enumerate(options, 1):
            if answer in (str(number), key) or (not answer and automatic and number == 1):
                if key == "rbw-locked":
                    print("Unlock rbw first (rbw unlock), then run calendar-sync setup again.")
                    break
                return automatic if key == "auto" else key
        else:
            print("Pick one of the listed numbers or names.")


def check_not_in_work_tree(path, what):
    if inside_git_work_tree(path.parent):
        raise SetupAborted(f"{what} would be inside a git work tree; set XDG_DATA_HOME or XDG_CONFIG_HOME elsewhere")


def validate_address(address, now, window_end):
    """Fetches and parses the feed the way a sync does; returns the count from now to the window's end."""
    feed = fetch_feed(address)
    events = expand_events(feed, now, window_end, address)
    return sum(1 for event in events if event["status"] != "cancelled")


def read_valid_address(prompter, now, window_end):
    while True:
        try:
            address = normalize_feed_url(prompter.ask("Secret iCal address (input hidden): ", secret=True))
            count = validate_address(address, now, window_end)
        except SyncError as err:
            print(f"That did not work: {err}.")
            if not prompter.confirm("Try again?", default=True):
                raise SetupAborted("stopped before saving anything") from None
            continue
        days_ahead = (window_end.date() - now.date()).days - 1
        print(f"Found {count} events in the next {days_ahead} days.")
        return address


def explain_where_the_address_lives(prompter):
    print(
        "In Google Calendar open Settings, pick your calendar, then Integrate calendar,\n"
        'and copy "Secret address in iCal format" (not the public address).'
    )
    if prompter.confirm("Open Google Calendar settings in your browser?"):
        try:
            subprocess.Popen(
                ["xdg-open", GOOGLE_SETTINGS_URL],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError:
            print(f"Could not open a browser; go to {GOOGLE_SETTINGS_URL}")


SETUP_CONFIG_HEADER = "# Written by calendar-sync setup. The command prints the address; it is not stored here."


def other_config_lines(path):
    """Lines to carry over when setup replaces the command, so settings like days_ahead survive."""
    if not os.path.lexists(path):
        return []
    return [
        line
        for line in path.read_text().splitlines()
        if line.partition("=")[0].strip() != "url_command" and line != SETUP_CONFIG_HEADER
    ]


def write_config(command):
    path = config_file_path()
    ensure_private_directory(path.parent)
    kept_lines = other_config_lines(path)
    fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix="config.")
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(f"{SETUP_CONFIG_HEADER}\nurl_command = {command}\n")
            handle.writelines(line + "\n" for line in kept_lines)
        os.replace(tmp_name, path)
    except BaseException:
        Path(tmp_name).unlink(missing_ok=True)
        raise


def enable_timer():
    unit = Path(os.path.expanduser("~/.config/systemd/user/calendar-sync.timer"))
    if not unit.exists():
        print("The timer is not installed. Run `just stow calendar` in your dotfiles checkout,")
        print("then: systemctl --user enable --now calendar-sync.timer")
        return
    run_quietly(["systemctl", "--user", "daemon-reload"])
    if run_quietly(["systemctl", "--user", "enable", "--now", "calendar-sync.timer"]) == 0:
        print("Timer enabled: the calendar syncs every 5 minutes.")
    else:
        print("Could not enable the timer; run: systemctl --user enable --now calendar-sync.timer")


def connection_status():
    """0 when the stored command yields an address, else 1, or a distinct code for a locked store."""
    command = url_command()
    if needs_unlocked_rbw(command) and not rbw_is_unlocked():
        return LOCKED_RBW_EXIT_CODE
    if needs_unlocked_keyring(command) and not keyring_is_unlocked():
        return LOCKED_KEYRING_EXIT_CODE
    try:
        read_feed_url(command)
    except (NotConfigured, SyncError):
        return 1
    return 0


def plan_storage(prompter, backend):
    """Asks and checks everything that could stop setup before any secret is written."""
    check_not_in_work_tree(config_file_path(), "the config file")
    if backend == "file":
        check_not_in_work_tree(private_file_path(), "the private file")
    existing = configured_url_command()
    if existing:
        print(f"A config already exists with: url_command = {existing}")
        if not prompter.confirm("Replace it?"):
            raise SetupAborted("kept the existing config")
    entry, entry_exists = DEFAULT_RBW_ENTRY, False
    if backend == "rbw":
        entry = prompter.ask(f"rbw entry name [{DEFAULT_RBW_ENTRY}]: ") or DEFAULT_RBW_ENTRY
        entry_exists = rbw_entry_exists(entry)
        if entry_exists and not prompter.confirm(f"rbw already has an entry named {entry}. Update it with this address?"):
            raise SetupAborted("left the existing rbw entry alone")
    return entry, entry_exists


def report_older_copies(prompter, backend, entry):
    """Names where an earlier setup left the address, since moving it does not remove the old copy."""
    old_file = private_file_path()
    if backend != "file" and old_file.exists():
        print(f"An older copy of the address is still in the private file {old_file}.")
        if prompter.confirm("Delete it?"):
            old_file.unlink()
    if backend != "keyring" and keyring_state() == "unlocked" and run_quietly(["secret-tool", "lookup", *KEYRING_ATTRIBUTES]) == 0:
        print("An older copy of the address is still in the keyring; remove it with: secret-tool clear service calendar-sync key ical-url")
    if (backend != "rbw" or entry != DEFAULT_RBW_ENTRY) and rbw_state() == "unlocked":
        if run_quietly(["rbw", "get", "--", DEFAULT_RBW_ENTRY]) == 0:
            print(f"An older copy of the address is still in the rbw entry {DEFAULT_RBW_ENTRY}; remove it with: rbw remove -- {DEFAULT_RBW_ENTRY}")


def store_address(backend, address, entry, entry_exists):
    if backend == "rbw":
        return store_in_rbw(address, entry, entry_exists)
    if backend == "keyring":
        return store_in_keyring(address)
    return store_in_private_file(address)


def run_setup(args):
    prompter = Prompter()
    if args.check:
        return connection_status()
    if not prompter.is_interactive():
        print("calendar-sync setup needs a terminal; run it from a shell.", file=sys.stderr)
        return 2
    if not libraries_available():
        print("Install python-icalendar and python-recurring-ical-events first.", file=sys.stderr)
        return 1
    now = current_time(args)
    try:
        explain_where_the_address_lives(prompter)
        _, window_end = sync_window(now)
        address = read_valid_address(prompter, now, window_end)
        backend = choose_backend(prompter)
        entry, entry_exists = plan_storage(prompter, backend)
        command, where = store_address(backend, address, entry, entry_exists)
        print(f"Stored the address in {where}.")
        write_config(command)
        try:
            round_trip_ok = read_feed_url(url_command()) == address
        except (NotConfigured, SyncError):
            round_trip_ok = False
        if not round_trip_ok:
            raise SetupAborted("the address could not be read back; check the stored entry")
        print("Read the address back through the stored command: ok.")
        report_older_copies(prompter, backend, entry)
    except SetupAborted as err:
        print(f"Setup stopped: {err}.", file=sys.stderr)
        return 1
    except SyncError as err:
        print(f"Setup stopped: {err}.", file=sys.stderr)
        return 1
    except (ValueError, OSError) as err:
        print(f"Setup stopped: unexpected {type(err).__name__}.", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\nSetup cancelled.", file=sys.stderr)
        return 130
    enable_timer()
    return main(["--now", *(["--at", args.at] if args.at else [])])


def main(argv):
    args = parse_args(argv)
    if args.command == "setup":
        return run_setup(args)
    directory = cache_dir()
    if inside_git_work_tree(directory):
        print("calendar-sync: cache directory is inside a git work tree, refusing to run", file=sys.stderr)
        return 2
    try:
        ensure_private_directory(directory)
    except SyncError:
        print("calendar-sync: cache directory is not yours, refusing to run", file=sys.stderr)
        return 2
    try:
        return sync(args, directory)
    except SyncError as err:
        message = str(err)
        exit_code = 0 if err.transient else 1
    except Exception as err:
        message = f"unexpected {type(err).__name__}"
        exit_code = 1
    write_json_atomically(
        directory / "error.json",
        {"error": message, "at": dt.datetime.now().astimezone().isoformat(timespec="seconds")},
    )
    print(f"calendar-sync: {message}", file=sys.stderr)
    return exit_code


if __name__ == "__main__":
    try:
        exit_status = main(sys.argv[1:])
    except KeyboardInterrupt:
        print("calendar-sync: interrupted", file=sys.stderr)
        exit_status = 130
    sys.exit(exit_status)
