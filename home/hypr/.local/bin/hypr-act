#!/usr/bin/env bash
# Runs actions on the live Hyprland. Today: `hypr-act list`, the JSON list of every defined action
# ({"version":1,"actions":[...]}, shape in lib/act.lua `Act.list_json`).
#
# The list comes from the running session, so it holds the machine's Config and custom/. With no Hyprland answering
# (within 3 s) stdout stays empty, one line goes to stderr and the exit code is 3; callers treat that as "no actions".
# Nothing is cached, so a caller never reads a list the desktop no longer has.
set -u

# Newest instance whose hyprctl answers, found by its socket and not by HYPRLAND_INSTANCE_SIGNATURE: that variable is
# stale in a shell that outlives a login. Newest by .socket.sock, as a directory's mtime moves with its other sockets.
find_instance() {
  local socket instance runtime=${XDG_RUNTIME_DIR:-/run/user/$UID}
  while read -r socket; do
    instance=$(basename "$(dirname "$socket")")
    if XDG_RUNTIME_DIR=$runtime HYPRLAND_INSTANCE_SIGNATURE=$instance timeout 3 hyprctl version >/dev/null 2>&1; then
      echo "$instance"
      return 0
    fi
  done < <(ls -1t "$runtime"/hypr/*/.socket.sock 2>/dev/null)
  return 1
}

not_running() {
  echo "hypr-act: Hyprland is not running, or did not answer within 3 s; actions come from the running desktop" >&2
  exit 3
}

# Global, not local: the EXIT trap runs after list_actions has returned.
list_file=

list_actions() {
  local instance
  instance=$(find_instance) || not_running
  export HYPRLAND_INSTANCE_SIGNATURE=$instance
  list_file=$(mktemp "${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr-act.XXXXXX") || exit 1
  trap 'rm -f "$list_file"' EXIT
  # hyprctl eval answers only "ok", so Lua writes the list to a file. A level-5 long string cannot be closed by a path.
  timeout 3 hyprctl eval "require('lib.act').write_list([=====[${list_file}]=====])" >/dev/null 2>&1 || not_running
  [[ -s $list_file ]] || not_running
  cat "$list_file"
}

if [[ ${1:-} == list && $# -eq 1 ]]; then
  list_actions
else
  echo "usage: hypr-act list" >&2
  exit 2
fi
