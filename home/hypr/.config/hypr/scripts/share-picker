#!/usr/bin/env bash
# hypr/.config/hypr/scripts/share-picker
# XDPH custom_picker_binary: the bar's overview picks the share; with no bar the share is cancelled.
reply=$(mktemp -u "${XDG_RUNTIME_DIR:-/tmp}/qs-share-XXXXXX")
mkfifo -m 600 "$reply" || exit 1
trap 'rm -f "$reply"' EXIT
exec 3<>"$reply"
if [ "$("$(dirname "$0")/qs-ipc" call screenshot share "${XDPH_WINDOW_SHARING_LIST:-}" "$reply" 2>/dev/null)" != ok ]; then
  notify-send "Screen Share" "Quickshell is not running, share cancelled"
  exit 1
fi
flags=""
[[ " $* " == *" --allow-token "* ]] && flags=r
if read -r -t 600 selection <&3 && [ -n "$selection" ]; then
  printf '[SELECTION]%s/%s\n' "$flags" "$selection"
fi
