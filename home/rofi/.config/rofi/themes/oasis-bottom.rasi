/*****----- Configuration -----*****/
configuration {
  disable-history: true;
}

/*****----- Global Properties -----*****/
@import                          "../colors.rasi"
@import                          "../fonts.rasi"

* {
  font: "JetBrainsMono Nerd Font 11";
}

window {
  location: south;
  anchor: south;

  x-offset: 0px;
  y-offset: 0px;

  width: 100%;
  height: 40%;

  background-color: @bg-crust;
  border: 1px 0px 0px 0px;
  border-color: @fg-muted;
  border-radius: 0px;
}

mainbox {
  padding: 10px 16px;
  spacing: 8px;
  background-color: transparent;
  orientation: vertical;
  children: [ inputbar, listview ];
}

inputbar {
  padding: 8px 12px;
  spacing: 8px;

  background-color: @bg-mantle;
  border-radius: 0px;

  children: [ prompt, entry ];
}

prompt {
  text-color: @theme-primary;
  background-color: transparent;
}

entry {
  text-color: @fg-core;
  background-color: transparent;
  placeholder: "";
  placeholder-color: @fg-muted;
}

listview {
  lines: 8;
  columns: 4;
  fixed-height: true;
  spacing: 2px;
  scrollbar: false;
  background-color: transparent;
}

element {
  padding: 7px 10px;
  border-radius: 0px;
  background-color: transparent;
  text-color: @fg-core;
}

element selected {
  background-color: @bg-surface;
  text-color: @theme-secondary;
}

element-text {
  background-color: transparent;
  text-color: inherit;
}

element-icon {
  size: 22px;
  background-color: transparent;
}
