/** rofi/.config/rofi/colors.rasi — generated by hypr/theme.lua **/

* {
    /* Backgrounds */
    bg-core:    #0C0E13FF;
    bg-mantle:  #141C24FF;
    bg-shadow:  #05070AFF;
    bg-surface: #1E2A38FF;

    /* Foregrounds */
    fg-core:   #F5F5DCFF;
    fg-strong: #FFFFF0FF;
    fg-muted:  #4E6578FF;
    fg-dim:    #74808FFF;

    /* Accents */
    theme-primary:   #7FA3C9FF;
    theme-secondary: #F0E68CFF;
    theme-accent:    #FFA0A0FF;

    /* Status */
    error:   #FFA0A0FF;
    warning: #F0E68CFF;
    info:    #81C0FFFF;
    hint:    #8FD1C7FF;
    ok:      #A3E39AFF;

    /* ANSI semantic colors */
    black:          #0C0E13FF;
    red:            #FF7979FF;
    green:          #7FCF78FF;
    yellow:         #F0E68CFF;
    blue:           #81C0FFFF;
    magenta:        #C695FFFF;
    cyan:           #68C0B6FF;
    white:          #F5F5DCFF;
    bright-black:   #4E6578FF;
    bright-red:     #FFA0A0FF;
    bright-green:   #A3E39AFF;
    bright-yellow:  #F8B471FF;
    bright-blue:    #87CEEBFF;
    bright-magenta: #D2ADFFFF;
    bright-cyan:    #8FD1C7FF;
    bright-white:   #FFFFF0FF;
}
