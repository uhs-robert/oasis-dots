#!/usr/bin/env bash
# voxtype/.local/bin/voxtype-daemon
# Starts the voxtype daemon with config.toml's initial prompt plus voxcmd's wake word and every prompt.d/*.txt appended.
# prompt.d holds machine-local vocabulary (client names and the like) that must stay out of the public config.
# Whisper keeps only the last ~224 prompt tokens, so appended words survive and the base prompt is trimmed from the front.
shopt -s nullglob
prompt_files=("${XDG_CONFIG_HOME:-$HOME/.config}/voxtype/prompt.d/"*.txt)

base_prompt="$(voxtype config get whisper.initial_prompt)"
# The wake word is in the prompt so Whisper spells it one way, which is the one voxcmd listens for (VOXCMD_WAKE_WORD).
wake_word="${VOXCMD_WAKE_WORD:-cortana}"
local_vocabulary="Voice commands start with ${wake_word^}."
if ((${#prompt_files[@]})); then
  # awk 1 ends every file with a newline, so a file without one cannot glue its last word to the next file's first.
  local_vocabulary+=" $(awk 1 "${prompt_files[@]}" | tr -s '[:space:]' ' ')"
fi
# voxtype logs every transcript at INFO, and the journal keeps it, so -q (errors only) is the default.
log_flags=(-q)
if [[ "${VOXCMD_LOG_TRANSCRIPTS:-}" == 1 ]]; then
  log_flags=()
fi

# Music ducking while recording comes from Settings > Voice (environment first, else its voice.env). Without a value
# config.toml's own duck_media_volume applies. The loader belongs to the voxcmd package, which may not be stowed.
voxtype_flags=()
voice_env_loader="${XDG_DATA_HOME:-$HOME/.local/share}/voxcmd/voice-env.sh"
if [ -r "$voice_env_loader" ]; then
  # shellcheck source=/dev/null
  source "$voice_env_loader"
  if duck_percent="$(voice_env_value VOXCMD_DUCK_MEDIA_VOLUME)"; then
    voxtype_flags+=(--duck-media-volume "$duck_percent")
  fi
fi
exec voxtype "${voxtype_flags[@]}" --initial-prompt "$base_prompt ${local_vocabulary% }" "${log_flags[@]}" daemon "$@"
