#!/usr/bin/env bash
# voxtype/.local/bin/voxtype-prompt
# Prints the initial prompt Whisper gets: config.toml's, then voxcmd's wake word and every prompt.d/*.txt appended.
# voxtype-daemon passes it to the daemon and `voxcmd _wake-confirm` to `voxtype transcribe`, so a confirmation hears
# audio the way a dictation does. Both call this one script so the prompts cannot drift.
# prompt.d holds machine-local vocabulary (client names and the like) that must stay out of the public config.
# Whisper keeps only the last ~224 prompt tokens, so appended words survive and the base prompt is trimmed from the front.
shopt -s nullglob
prompt_files=("${XDG_CONFIG_HOME:-$HOME/.config}/voxtype/prompt.d/"*.txt)

base_prompt="$(voxtype config get whisper.initial_prompt)"
# The wake word is in the prompt so Whisper spells it one way. It is fixed ("cortana", the only word the wake model
# knows), and voxcmd's wake_word is the same constant.
local_vocabulary="Voice commands start with Cortana."
if ((${#prompt_files[@]})); then
  # awk 1 ends every file with a newline, so a file without one cannot glue its last word to the next file's first.
  local_vocabulary+=" $(awk 1 "${prompt_files[@]}" | tr -s '[:space:]' ' ')"
fi
printf '%s\n' "$base_prompt ${local_vocabulary% }"
