#!/usr/bin/env python3
"""Regenerates the app corner files from the screen frame's state.

Usage: frame-app-corners [frame.json] [--yazi-dir DIR] [--firefox-dirs DIR...]

FIREFOX_CHROME_DIRS (colon-separated chrome directories) replaces the default profile search.

Reads frame.json ({ "on", "corner", "radius" }, written by FrameExport.qml) and writes
yazi's frame-border.lua and each Firefox profile's chrome/frame.css. Both apps read them at start-up only.
"""
import glob
import json
import os
import sys

# Square-cornered styles, and the stair that yazi's one border box cannot draw, all read as plain.
YAZI_BORDER = {"round": "rounded", "square": "plain", "pixel": "plain", "chamfer": "plain"}


def yazi_border(frame):
    if not frame.get("on"):
        return "plain"
    return YAZI_BORDER.get(frame.get("corner"), "plain")


# TextFox's bordered panes, the only things a chamfer touches. Their own border-radius is --tf-rounding, so a chamfer
# is --tf-rounding 0 plus a clipped corner and a drawn diagonal on each of these, never a clip on the page, sidebar or
# devtools content inside them (Firefox 158 has no `corner-shape: bevel`).
TEXTFOX_PANES = ["#tabbrowser-tabbox", "#sidebar-box", ".buttons-wrapper", "findbar", "#nav-bar", "#PersonalToolbar", "#TabsToolbar", "box#vertical-tabs"]


def chamfer_css(radius):
    r = f"{radius}px"
    w = "var(--border-width, 1px)"
    panes = ",\n".join(TEXTFOX_PANES)
    hovered = ",\n".join(f"{pane}:hover" for pane in TEXTFOX_PANES)
    after = ",\n".join(f"{pane}::after" for pane in TEXTFOX_PANES)
    # The polygon also reaches above the pane so TextFox's title label, which sits on the top border, is not cut.
    clip = (
        f"polygon(0 {r}, {r} 0, {r} -2rem, calc(100% - {r}) -2rem, calc(100% - {r}) 0, 100% {r}, "
        f"100% calc(100% - {r}), calc(100% - {r}) 100%, {r} 100%, 0 calc(100% - {r}))"
    )
    # One diagonal stroke per corner, on the pane's side of the cut: the gradient runs across the corner square and its
    # 50% mark is the cut itself.
    stroke = lambda angle, at: f"linear-gradient({angle}deg, transparent 50%, var(--tf-bevel-line) 50%, var(--tf-bevel-line) calc(50% + {w}), transparent calc(50% + {w})) {at} / {r} {r} no-repeat"
    strokes = ", ".join([stroke(135, "left top"), stroke(225, "right top"), stroke(315, "right bottom"), stroke(45, "left bottom")])
    return f"""
{panes} {{
  position: relative;
  --tf-bevel-line: var(--tf-border);
  clip-path: {clip};
}}

{hovered},
#nav-bar:focus,
#PersonalToolbar:focus,
#TabsToolbar:focus,
box#vertical-tabs:focus {{
  --tf-bevel-line: var(--tf-accent);
}}

{after} {{
  content: "";
  position: absolute;
  inset: calc(-1 * {w});
  pointer-events: none;
  background: {strokes};
}}
"""


def firefox_css(frame):
    corner = frame.get("corner") if frame.get("on") else None
    if corner is None:
        return "/* Generated by frame-app-corners; the screen frame is off. */\n"
    radius = max(0, round(frame.get("radius") or 0))
    # Only a round corner is a border radius; every other profile is square to CSS, and a chamfer is drawn on top.
    rounding = radius if corner == "round" else 0
    css = f"/* Generated by frame-app-corners from the screen frame; do not edit. */\n:root {{\n  --tf-rounding: {rounding}px;\n}}\n"
    if corner == "chamfer" and radius > 0:
        css += chamfer_css(radius)
    return css


def write_if_changed(path, text):
    try:
        with open(path) as f:
            if f.read() == text:
                return
    except FileNotFoundError:
        pass
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def default_firefox_dirs(home):
    found = []
    for base in (home + "/.config/mozilla/firefox", home + "/.mozilla/firefox"):
        found += glob.glob(base + "/*.default-release/chrome")
    return found


def main(argv):
    home = os.environ.get("HOME", "")
    state = os.environ.get("XDG_STATE_HOME") or home + "/.local/state"
    config = os.environ.get("XDG_CONFIG_HOME") or home + "/.config"
    frame_path = state + "/quickshell/frame.json"
    yazi_dir = config + "/yazi"
    firefox_dirs = None
    args = list(argv)
    while args:
        arg = args.pop(0)
        if arg == "--yazi-dir":
            yazi_dir = args.pop(0)
        elif arg == "--firefox-dirs":
            firefox_dirs = args[:]
            args = []
        else:
            frame_path = arg
    if firefox_dirs is None:
        listed = os.environ.get("FIREFOX_CHROME_DIRS")
        firefox_dirs = [d for d in listed.split(":") if d] if listed else default_firefox_dirs(home)
    try:
        with open(frame_path) as f:
            frame = json.load(f)
        if not isinstance(frame, dict):
            raise ValueError("not an object")
    except (OSError, ValueError) as error:
        print(f"frame-app-corners: cannot read {frame_path}: {error}", file=sys.stderr)
        return 1
    write_if_changed(yazi_dir + "/frame-border.lua", f'return "{yazi_border(frame)}"\n')
    css = firefox_css(frame)
    for directory in firefox_dirs:
        write_if_changed(directory + "/frame.css", css)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
