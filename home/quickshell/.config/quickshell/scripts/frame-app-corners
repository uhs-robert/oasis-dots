#!/usr/bin/env python3
"""Regenerates the app corner files from the Corner style.

Usage: frame-app-corners [frame.json] [--yazi-dir DIR] [--firefox-dirs DIR...]

FIREFOX_CHROME_DIRS (colon-separated chrome directories) replaces the default profile search.

Reads frame.json ({ "on", "corner", "radius" }, written by FrameExport.qml) and writes
yazi's frame-border.lua and each Firefox profile's chrome/frame.css. Both apps read them at start-up only. The corner
applies with the screen frame on or off (`on` only says a frame is drawn); an empty corner, as an older Quickshell wrote
for no frame, leaves the apps at their own.
"""
import glob
import json
import os
import sys

# Square-cornered styles, and the stair that yazi's one border box cannot draw, all read as plain.
YAZI_BORDER = {"round": "rounded", "square": "plain", "pixel": "plain", "chamfer": "plain"}


def yazi_border(frame):
    return YAZI_BORDER.get(frame.get("corner"), "plain")


# TextFox's bordered panes, the only things a chamfer touches. Their own border-radius is --tf-rounding, so a chamfer
# is --tf-rounding 0 plus a bevel drawn over each corner of these. It is painted by an ::after rather than cut with
# clip-path or mask, because those also clip what overflows the pane: the URL bar's results, TextFox's title labels.
# The URL bar's own background surfaces are the exception: they overlap page content, so urlbar_chamfer_css clips them.
# (Firefox 158 has no `corner-shape: bevel`.)
TEXTFOX_PANES = ["#tabbrowser-tabbox", "#sidebar-box", ".buttons-wrapper", "findbar", "#nav-bar", "#PersonalToolbar", "#TabsToolbar", "box#vertical-tabs"]


def chamfer_css(radius):
    r = f"{radius}px"
    w = "var(--border-width, 1px)"
    panes = ",\n".join(TEXTFOX_PANES)
    hovered = ",\n".join(f"{pane}:hover" for pane in TEXTFOX_PANES)
    after = ",\n".join(f"{pane}::after" for pane in TEXTFOX_PANES)
    fullscreen = ",\n".join(f":root[inFullscreen] {pane}::after" for pane in TEXTFOX_PANES)
    # Each corner square is the window's background up to the diagonal, then the border-coloured stroke on the pane's
    # side of it. The gradient's 50% mark is the diagonal.
    corner = lambda angle, at: f"linear-gradient({angle}deg, var(--tf-bevel-outside) 50%, var(--tf-bevel-line) 50%, var(--tf-bevel-line) calc(50% + {w}), transparent calc(50% + {w})) {at} / {r} {r} no-repeat"
    corners = ", ".join([corner(135, "left top"), corner(225, "right top"), corner(315, "right bottom"), corner(45, "left bottom")])
    return f"""
/* Registered so the stroke colour interpolates; a plain custom property would flip at once while the border fades. */
@property --tf-bevel-line {{
  syntax: "<color>";
  inherits: true;
  initial-value: transparent;
}}

{panes} {{
  position: relative;
  --tf-bevel-line: var(--tf-border);
  --tf-bevel-outside: var(--tf-bg);
}}

{hovered},
#nav-bar:focus,
#PersonalToolbar:focus,
#TabsToolbar:focus,
box#vertical-tabs:focus {{
  --tf-bevel-line: var(--tf-accent);
}}

/* The toolbars and the sidebar's tabs and tools sit on the toolbox, a different grey from --tf-bg when no Firefox theme is set. */
#nav-bar,
#PersonalToolbar,
#TabsToolbar,
box#vertical-tabs,
.buttons-wrapper {{
  --tf-bevel-outside: var(--toolbox-background-color, var(--tf-bg));
}}

/* Firefox sets overflow: hidden on #vertical-tabs, which cuts the bevel that sits over its border. !important is needed
   (without it Firefox's rule wins). Plain overflow: visible lets the tab strip grow past the box, so clip with a margin of
   the border width and min-height: 0, which overflow: hidden implied, keeps the strip scrolling inside the box. */
box#vertical-tabs {{
  overflow: clip !important;
  overflow-clip-margin: {w} !important;
  min-height: 0 !important;
}}

/* The content box sits on #browser. That is the toolbar colour with vertical tabs off, and with them on the window's
   toolbox colour shows through, which differs from the toolbar colour. Firefox keys its own #browser background on this pref. */
#tabbrowser-tabbox {{
  --tf-bevel-outside: var(--toolbar-background-color, var(--tf-bg));
}}

@media -moz-pref("sidebar.verticalTabs") {{
  #tabbrowser-tabbox {{
    --tf-bevel-outside: var(--toolbox-background-color, var(--tf-bg));
  }}
}}

{after} {{
  content: "";
  position: absolute;
  inset: calc(-1 * {w});
  pointer-events: none;
  background: {corners};
  /* The same timing as TextFox's own border-color transition. */
  transition: --tf-bevel-line var(--tf-border-transition);
}}

/* Firefox sets inFullscreen for F11 and for DOM (video) fullscreen alike. TextFox zeroes the content box's border there but
   never touches ::after, so the bevel triangles would sit over the video. The toolbars hide the same way, by owner choice. */
{fullscreen} {{
  display: none;
}}

/* TextFox gives the find bar no side padding, so its first and last controls would sit under a corner. */
findbar {{
  padding: 8px !important;
}}
""" + urlbar_chamfer_css(radius)


def urlbar_chamfer_css(radius):
    """The URL bar's cuts. Unlike the panes, its surfaces overlap page content (the dropdown's bottom corners), so no
    outside colour can be painted over them: each surface is clipped to an octagon and the diagonal stroke the clip removes
    is painted back as corner gradients. Firefox already clips both halves of the dropdown's joint background, so the
    polygons below replace those clip-paths and keep the same seam."""
    r = f"{radius}px"
    stroke = lambda angle, line, w: f"linear-gradient({angle}deg, transparent 50%, {line} 50%, {line} calc(50% + {w}), transparent calc(50% + {w}))"
    four = lambda line, w: ", ".join(stroke(a, line, w) for a in (135, 225, 315, 45))
    full = "polygon(var(--uc-cut) 0, calc(100% - var(--uc-cut)) 0, 100% var(--uc-cut), 100% calc(100% - var(--uc-cut)), calc(100% - var(--uc-cut)) 100%, var(--uc-cut) 100%, 0 calc(100% - var(--uc-cut)), 0 var(--uc-cut))"
    seam = "calc(100% - var(--urlbar-joint-background-overlap) + var(--urlbar-input-growth-open-block))"
    return f"""
/* The URL bar. Set up as custom properties so the three surfaces share one cut. The halo (the open background, 8px past
   the input) takes a longer cut so it stays concentric with the input's: 2 - sqrt(2) = 0.586. Firefox's own rules are
   author-origin, so every override here is !important. The open shadow is dropped (a clip would cut it) for a thin edge
   in the pane stroke colour. */
.urlbar {{
  --uc-cut: {r};
  --uc-halo-cut: calc(var(--uc-cut) + var(--urlbar-background-overhang-open) * 0.586);
  --uc-edge: var(--tf-bevel-line);
  --uc-edge-w: var(--border-width, 1px);
  --uc-line: var(--toolbar-field-border-color);
  --uc-line-w: var(--urlbar-input-container-border-width);
  --urlbar-background-box-shadow-open: none !important;
  --urlbar-background-border-open: var(--uc-edge-w) solid var(--uc-edge) !important;
}}

.urlbar[focused] {{
  --uc-line: var(--toolbar-field-border-color-focus);
  --uc-line-w: var(--urlbar-input-container-border-width-open);
}}

/* Closed and focused: the background's border is the ring. Open: the ring is the input container's outline. */
.urlbar:not([popover-open]) > .urlbar-background,
.urlbar[popover-open] > .urlbar-input-container {{
  clip-path: {full} !important;
  background-image: {four("var(--uc-line)", "var(--uc-line-w)")} !important;
  background-position: left top, right top, right bottom, left bottom !important;
  background-size: var(--uc-cut) var(--uc-cut) !important;
  background-repeat: no-repeat !important;
  background-origin: border-box !important;
}}

/* Open: the halo's top corners; its bottom edge is the seam, where the view's half of the joint background starts. */
.urlbar[popover-open] > .urlbar-background {{
  clip-path: polygon(var(--uc-halo-cut) 0, calc(100% - var(--uc-halo-cut)) 0, 100% var(--uc-halo-cut), 100% {seam}, 0 {seam}, 0 var(--uc-halo-cut)) !important;
  background-image: {stroke(135, "var(--uc-edge)", "var(--uc-edge-w)")}, {stroke(225, "var(--uc-edge)", "var(--uc-edge-w)")} !important;
  background-position: left top, right top !important;
  background-size: var(--uc-halo-cut) var(--uc-halo-cut) !important;
  background-repeat: no-repeat !important;
  background-origin: border-box !important;
}}

/* Open: the view's half, bottom corners. */
.urlbar > .urlbarView > .urlbarView-background {{
  clip-path: polygon(0 var(--urlbar-joint-background-overlap), 100% var(--urlbar-joint-background-overlap), 100% calc(100% - var(--uc-halo-cut)), calc(100% - var(--uc-halo-cut)) 100%, var(--uc-halo-cut) 100%, 0 calc(100% - var(--uc-halo-cut))) !important;
  background-image: {stroke(315, "var(--uc-edge)", "var(--uc-edge-w)")}, {stroke(45, "var(--uc-edge)", "var(--uc-edge-w)")} !important;
  background-position: right bottom, left bottom !important;
  background-size: var(--uc-halo-cut) var(--uc-halo-cut) !important;
  background-repeat: no-repeat !important;
  background-origin: border-box !important;
}}

/* TextFox's accent border on the view is hidden under the joint background except its top line (a black seam under the
   input) and corner stubs, which would poke out of the cut. */
.urlbar > .urlbarView {{
  border-color: transparent !important;
}}
"""


def firefox_css(frame):
    corner = frame.get("corner") or None
    if corner is None:
        return "/* Generated by frame-app-corners; no corner style is set. */\n"
    radius = max(0, round(frame.get("radius") or 0))
    # Only a round corner is a border radius; every other profile is square to CSS, and a chamfer is drawn on top.
    rounding = radius if corner == "round" else 0
    # Firefox declares the urlbar radii on :root and derives the focus ring, the open outline and the dropdown's corners
    # from them. A userChrome sheet is user-origin, which loses to Firefox's own author rules, so only !important wins.
    # A chamfer is 0 here until its bevel is drawn.
    css = (
        "/* Generated by frame-app-corners from the Corner style; do not edit. */\n"
        f":root {{\n  --tf-rounding: {rounding}px;\n  --urlbar-border-radius: {rounding}px !important;\n  --urlbarview-border-radius: {rounding}px !important;\n}}\n"
        # Firefox declares the open-state top corner (the radius plus an 8px overhang) on the urlbar itself, not on :root.
        f".urlbar,\n#searchbar {{\n  --urlbar-background-border-top-radius-open: {rounding}px !important;\n}}\n"
    )
    if corner == "chamfer" and radius > 0:
        css += chamfer_css(radius)
    return css


def write_if_changed(path, text):
    try:
        with open(path) as f:
            if f.read() == text:
                return
    except FileNotFoundError:
        pass
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def default_firefox_dirs(home):
    found = []
    for base in (home + "/.config/mozilla/firefox", home + "/.mozilla/firefox"):
        # The profile is what exists; its chrome/ is created on write, since a profile that never had one still needs the file.
        found += [profile + "/chrome" for profile in glob.glob(base + "/*.default-release")]
    return found


def main(argv):
    home = os.environ.get("HOME", "")
    state = os.environ.get("XDG_STATE_HOME") or home + "/.local/state"
    config = os.environ.get("XDG_CONFIG_HOME") or home + "/.config"
    frame_path = state + "/quickshell/frame.json"
    yazi_dir = config + "/yazi"
    firefox_dirs = None
    args = list(argv)
    while args:
        arg = args.pop(0)
        if arg == "--yazi-dir":
            yazi_dir = args.pop(0)
        elif arg == "--firefox-dirs":
            firefox_dirs = args[:]
            args = []
        else:
            frame_path = arg
    if firefox_dirs is None:
        listed = os.environ.get("FIREFOX_CHROME_DIRS")
        firefox_dirs = [d for d in listed.split(":") if d] if listed else default_firefox_dirs(home)
    try:
        with open(frame_path) as f:
            frame = json.load(f)
        if not isinstance(frame, dict):
            raise ValueError("not an object")
    except (OSError, ValueError) as error:
        print(f"frame-app-corners: cannot read {frame_path}: {error}", file=sys.stderr)
        return 1
    write_if_changed(yazi_dir + "/frame-border.lua", f'return "{yazi_border(frame)}"\n')
    css = firefox_css(frame)
    for directory in firefox_dirs:
        write_if_changed(directory + "/frame.css", css)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
