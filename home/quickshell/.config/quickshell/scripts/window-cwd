#!/usr/bin/env bash
# Prints what a terminal window shows: an optional `app:<name>` line naming the program running in it (anything but a
# shell), then its open Neovim file as `file:<path>`, Yazi's folder, or its working directory. The process tree it
# reads is its tmux client's pane, else the kitty window, else the deepest child.
# Usage: window-cwd <window pid> <window title> [1 if it is the focused window]
pid=$1
title=$2
focused=${3:-0}
[ -n "$pid" ] || exit 0
run_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# kitty --single-instance gives every OS window the same pid, so narrow pid to the shell of the kitty window showing
# $title; otherwise every window would resolve to whichever tmux client or child the shared process happens to own.
kitty_sock="$run_dir/kitty-$pid"
kitty_cwd=""
kitty_match=""
if [ -S "$kitty_sock" ] && command -v kitty >/dev/null 2>&1; then
  kitty_match=$(kitty @ --to "unix:$kitty_sock" ls 2>/dev/null | python3 -c '
import json, re, sys
title = sys.argv[1]
# Titles that animate a leading spinner (Claude Code, build tools) can change between the Hyprland event and this lookup.
def bare(t):
    return re.sub(r"^\W+", "", t)
shown = []
for osw in json.load(sys.stdin):
    for tab in osw.get("tabs", []):
        if not tab.get("is_active"):
            continue
        for w in tab.get("windows", []):
            if w.get("is_active"):
                shown.append((bool(osw.get("is_focused")), w))
matches = [s for s in shown if s[1].get("title") == title] or [s for s in shown if bare(s[1].get("title", "")) == bare(title)]
if not matches and len(shown) == 1:
    matches = shown
# Two windows can share a title (two shells in ~); kitty focus tells the focused one from the rest, and when that
# still leaves several that disagree on the folder, no answer beats another window'"'"'s.
if len(matches) > 1:
    matches = [s for s in matches if s[0] == (sys.argv[2] == "1")] or matches
if len(matches) > 1 and len({s[1].get("cwd") for s in matches}) > 1:
    matches = []
match = matches[0][1] if matches else None
if match:
    procs = match.get("foreground_processes") or []
    cwd = procs[-1].get("cwd") if procs and procs[-1].get("cwd") else match.get("cwd", "")
    print("%s\t%s" % (match.get("pid", ""), cwd))
' "$title" "$focused")
  # No kitty window shows this title (yet); printing nothing beats printing another window's directory.
  [ -n "$kitty_match" ] || exit 0
  pid=${kitty_match%%$'\t'*}
  kitty_cwd=${kitty_match#*$'\t'}
fi

# The file in the first nvim at or below $1 that answers on its socket.
nvim_file() {
  local queue=("$1") p sock file
  while [ ${#queue[@]} -gt 0 ]; do
    p=${queue[0]}
    queue=("${queue[@]:1}")
    if [ "$(cat "/proc/$p/comm" 2>/dev/null)" = "nvim" ]; then
      for sock in "$run_dir/nvim.$p.0" "$run_dir"/nvim."$p".*; do
        [ -S "$sock" ] || continue
        file=$(timeout 0.5 nvim --server "$sock" --remote-expr 'expand("%:p")' 2>/dev/null)
        [ -n "$file" ] && { printf 'file:%s\n' "$file"; return 0; }
        return 1
      done
    fi
    mapfile -t -O "${#queue[@]}" queue < <(pgrep -P "$p")
  done
  return 1
}

descends() {
  local p=$1
  while [ -n "$p" ] && [ "$p" -gt 1 ]; do
    [ "$p" = "$pid" ] && return 0
    p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
  done
  return 1
}

# Not named: the shells and multiplexers a program runs under.
shells=" bash zsh fish sh dash ksh nu xonsh elvish tmux tmux: client screen zellij sudo doas "
# Full-screen programs another program can open (Neovim from Yazi); the deepest of these is named over its opener.
openers=" nvim vim hx yazi lazygit ranger lf "

# Describes the program in the foreground of the terminal $1 (a shell, or a program a tmux pane runs directly) is
# attached to, with $2 the directory to show at a shell prompt. The foreground process group, not the newest child,
# so a background job (`sleep 60 &`) is never taken for it. Below that program a deeper opener wins, as Neovim
# opened from Yazi, but not a tool's own children.
describe() {
  local root=$1 fallback=$2 prog="" comm p stat
  stat=$(cat "/proc/$root/stat" 2>/dev/null)
  # Fields after the parenthesised comm: state ppid pgrp session tty_nr tpgid.
  read -r _ _ _ _ _ prog _ <<<"${stat##*) }"
  comm=$(cat "/proc/$prog/comm" 2>/dev/null)
  if [ -z "$comm" ] || [[ $shells == *" $comm "* ]]; then
    if [ -n "$fallback" ]; then printf '%s\n' "$fallback"; else readlink "/proc/$root/cwd" 2>/dev/null; fi
    return
  fi
  p=$(pgrep -P "$prog" | tail -n 1)
  while [ -n "$p" ]; do
    comm=$(cat "/proc/$p/comm" 2>/dev/null)
    [[ $openers == *" $comm "* ]] && prog=$p
    p=$(pgrep -P "$p" | tail -n 1)
  done
  comm=$(cat "/proc/$prog/comm" 2>/dev/null)
  printf 'app:%s\n' "$comm"
  case $comm in
    nvim) nvim_file "$prog" && return ;;
    # Yazi never changes its own cwd; init.lua's cd hook writes the folder it shows.
    yazi) [ -s "$run_dir/yazi-cwd-$prog" ] && { cat "$run_dir/yazi-cwd-$prog"; echo; return; } ;;
  esac
  readlink "/proc/$prog/cwd" 2>/dev/null
}

if command -v tmux >/dev/null 2>&1; then
  # The window's own tty, as client_tty prints it. A client on it, or the window process itself, is this window's
  # client whatever the title says; the title only separates several such clients, or the weaker candidates that merely
  # descend from the window pid (kitty --single-instance without a socket shares one pid between windows).
  window_tty=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
  [ -n "$window_tty" ] && [ "$window_tty" != "?" ] && window_tty=/dev/$window_tty || window_tty=""
  pick="" pick_pane="" pick_rank=0 pick_titled=0 ranked=(0 0 0)
  while IFS=$'\t' read -r cpid session path pane_pid ctty; do
    rank=1
    if [ "$cpid" = "$pid" ] || { [ -n "$window_tty" ] && [ "$ctty" = "$window_tty" ]; }; then
      rank=2
    elif ! descends "$cpid"; then
      continue
    fi
    ranked[rank]=$((ranked[rank] + 1))
    titled=0
    case "$title" in
      "$session" | *" $session" | "$session "*) titled=1 ;;
    esac
    if [ "$rank" -gt "$pick_rank" ] || { [ "$rank" -eq "$pick_rank" ] && [ "$titled" -gt "$pick_titled" ]; }; then
      pick_rank=$rank pick_titled=$titled pick=$path pick_pane=$pane_pid
    fi
  done < <(tmux list-clients -F $'#{client_pid}\t#{client_session}\t#{pane_current_path}\t#{pane_pid}\t#{client_tty}' 2>/dev/null)
  # Several clients at the best rank that the title does not separate: no answer beats another client's.
  [ "$pick_titled" -eq 0 ] && [ "${ranked[pick_rank]}" -gt 1 ] && pick=""
  if [ -n "$pick" ]; then
    describe "$pick_pane" "$pick"
    exit 0
  fi
fi

# A kitty window already narrowed pid to its shell; any other terminal is itself the root, and is named by the bar.
if [ -n "$kitty_match" ]; then
  describe "$pid" "$kitty_cwd"
else
  shell=$(pgrep -P "$pid" | tail -n 1)
  [ -n "$shell" ] && describe "$shell" ""
fi
