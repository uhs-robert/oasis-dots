#!/usr/bin/env bash
# Writes the greeter's data files (greeter.json, theme.json, faces/$USER) into /var/lib/qs-greeter when that directory exists and is writable.
# Usage: greeter-data <greeter.json text> <theme.json path> [face path] [music path]
dir=/var/lib/qs-greeter
[[ -d "$dir" && -w "$dir" ]] || exit 0
umask 027

# Replaces $dir/$1 with $2 in one rename, only when $2 is a JSON object.
write() {
  jq -e 'type == "object"' >/dev/null 2>&1 <<<"$2" || return 0
  local tmp
  tmp=$(mktemp "$dir/.$1.XXXXXX") || return 0
  if printf '%s\n' "$2" >"$tmp" && chmod 640 "$tmp" && mv -f "$tmp" "$dir/$1"; then return 0; fi
  rm -f "$tmp"
}

write greeter.json "$1"
[[ -f "$2" ]] && write theme.json "$(cat "$2")"
if [[ -n "${3:-}" && -f "$3" && -n "${USER:-}" ]] && ! cmp -s "$3" "$dir/faces/$USER"; then
  mkdir -p "$dir/faces" && tmp=$(mktemp "$dir/faces/.$USER.XXXXXX") &&
    { cp -L "$3" "$tmp" && chmod 640 "$tmp" && mv -f "$tmp" "$dir/faces/$USER" || rm -f "$tmp"; }
fi

# The theme music the greeter plays; an empty or missing path clears it.
rm -f "$dir"/music.ogg "$dir"/music.wav "$dir"/music.mp3
if [[ -n "${4:-}" && -f "$4" ]]; then
  case "${4##*.}" in
  ogg | wav | mp3) cp -L "$4" "$dir/music.${4##*.}" && chmod 640 "$dir/music.${4##*.}" ;;
  esac
fi
exit 0
