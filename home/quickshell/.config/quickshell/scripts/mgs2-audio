#!/usr/bin/env bash
# Imports the MGS2 lock skin's audio into $XDG_DATA_HOME/quickshell/mgs2-audio: the title and menu themes as an intro plus a loop, and the menu sound effects.
# Music is title.* (else any file with "title" in its name) and menu.*, in SOURCE_DIR or its music/; loops come from --*-loop, else LOOPSTART/LOOPLENGTH (or LOOPEND) tags, else the whole track loops.
# Effects, in SOURCE_DIR or its fx/: back, select, error, submit, transition_wipe, transition_left and transition_right; a missing file stays silent.
# Usage: mgs2-audio [--title-loop START END] [--menu-loop START END] [--out DIR] [SOURCE_DIR]   (seconds)
set -euo pipefail

src="$HOME/Downloads/Metal Gear"
title_loop=()
menu_loop=()
out="${XDG_DATA_HOME:-$HOME/.local/share}/quickshell/mgs2-audio"
while (($#)); do
  case "$1" in
  --title-loop)
    title_loop=("$2" "$3")
    shift 3
    ;;
  --menu-loop)
    menu_loop=("$2" "$3")
    shift 3
    ;;
  --out)
    out=$2
    shift 2
    ;;
  -h | --help)
    sed -n '2,5p' "$0"
    exit 0
    ;;
  *)
    src=$1
    shift
    ;;
  esac
done

for tool in ffmpeg ffprobe jq; do
  command -v "$tool" >/dev/null || {
    echo "mgs2-audio: $tool is required" >&2
    exit 1
  }
done
[[ -d $src ]] || {
  echo "mgs2-audio: no source directory $src" >&2
  exit 1
}
rate=44100
mkdir -p "$out"

# Prints the first file in $src or one folder down named $1 with one of the extensions $2.., ignoring case.
find_src() {
  local name=$1 ext file
  shift
  for ext in "$@"; do
    file=$(find "$src" -maxdepth 2 -type f -iname "$name.$ext" -print -quit)
    if [[ -n $file ]]; then
      printf '%s\n' "$file"
      return 0
    fi
  done
}

# Prints "start end" in seconds from the file's loop tags, or nothing.
read_tags() {
  local sr
  sr=$(ffprobe -v error -select_streams a:0 -show_entries stream=sample_rate -of csv=p=0 "$1")
  ffprobe -v error -show_entries format_tags:stream_tags -of json "$1" |
    jq -r --argjson sr "$sr" '[.format.tags, (.streams // [])[].tags] | map(select(. != null)) | add // {} | with_entries(.key |= ascii_upcase)
      | (.LOOPSTART // "" | tonumber? // null) as $s | (.LOOPLENGTH // "" | tonumber? // null) as $l | (.LOOPEND // "" | tonumber? // null) as $e
      | if $s == null then empty elif $l != null then "\($s / $sr) \(($s + $l) / $sr)" elif $e != null then "\($s / $sr) \($e / $sr)" else empty end'
}

# Writes $out/$1_intro.ogg and $out/$1_loop.ogg from the source $1.*, looping between the two given seconds when set.
music() {
  local name=$1 file start end
  shift
  file=$(find_src "$name" flac ogg mp3 wav)
  [[ -n $file || $name != title ]] || file=$(find "$src" -maxdepth 2 -type f -iname '*title*' \( -iname '*.flac' -o -iname '*.ogg' -o -iname '*.mp3' -o -iname '*.wav' \) -print -quit)
  if [[ -z $file ]]; then
    if [[ $name == menu ]]; then
      echo "mgs2-audio: no menu track in $src; the menus keep the title theme" >&2
    else
      echo "mgs2-audio: no $name track in $src; it stays silent" >&2
    fi
    return 0
  fi
  if (($# == 2)); then
    start=$1 end=$2
  else
    read -r start end < <(read_tags "$file") || true
  fi
  rm -f "$out/${name}_intro.ogg" "$out/${name}_loop.ogg"
  if [[ -z ${start:-} ]]; then
    ffmpeg -v error -y -i "$file" -ar "$rate" -c:a libvorbis -q:a 6 "$out/${name}_loop.ogg"
    printf 'mgs2-audio: %s loops whole\n' "$name"
    return 0
  fi
  local s e
  s=$(awk -v t="$start" -v r="$rate" 'BEGIN { printf "%d", t * r + 0.5 }')
  e=$(awk -v t="$end" -v r="$rate" 'BEGIN { printf "%d", t * r + 0.5 }')
  if ((s > 0)); then
    ffmpeg -v error -y -i "$file" -ar "$rate" -af "atrim=end_sample=$s" -c:a libvorbis -q:a 6 "$out/${name}_intro.ogg"
  fi
  ffmpeg -v error -y -i "$file" -ar "$rate" -af "atrim=start_sample=$s:end_sample=$e,asetpts=N/SR/TB" -c:a libvorbis -q:a 6 "$out/${name}_loop.ogg"
  printf 'mgs2-audio: %s loops %ss to %ss\n' "$name" "$start" "$end"
}

# Writes $out/$1.wav from the source $1.* as 16-bit PCM, which QSoundEffect can play.
fx() {
  local file
  file=$(find_src "$1" wav ogg flac mp3)
  rm -f "$out/$1.wav"
  if [[ -z $file ]]; then
    echo "mgs2-audio: no $1 effect in $src; it stays silent" >&2
    return 0
  fi
  ffmpeg -v error -y -i "$file" -ar "$rate" -c:a pcm_s16le "$out/$1.wav"
}

music title "${title_loop[@]}"
music menu "${menu_loop[@]}"
for name in back select error submit transition_wipe transition_left transition_right; do fx "$name"; done
printf 'mgs2-audio: wrote %s\n' "$out"
