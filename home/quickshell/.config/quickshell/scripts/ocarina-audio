#!/usr/bin/env bash
# Imports the Ocarina lock skin's game audio into $XDG_DATA_HOME/quickshell/ocarina-audio (gitignored): loops cut at detected or given points, loudness evened out.
# Each track's source is its first of .flac, .ogg or .mp3; loop points come from LOOPSTART/LOOPLENGTH (or LOOPEND) tags in it; untagged tracks are detected and the result is tagged into the source losslessly.
# The fairy fountain plays from OCARINA_START (a tag in its source, else --fairy-start or 28s, snapped to an onset) into its loop.
# Usage: ocarina-audio [--title-loop START END] [--fairy-loop START END] [--fairy-start SEC] [--redetect] [--out DIR] SOURCE_DIR   (seconds; overrides are tagged too)
set -euo pipefail
# shellcheck source=lib/audio-loop.sh
source "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/lib/audio-loop.sh"
audio_name=ocarina-audio
audio_loop_flags=--title-loop/--fairy-loop

src=""
title_loop=()
fairy_loop=()
fairy_start=
redetect=0
out="${XDG_DATA_HOME:-$HOME/.local/share}/quickshell/ocarina-audio"
while (($#)); do
  case "$1" in
  --title-loop)
    title_loop=("$2" "$3")
    shift 3
    ;;
  --fairy-loop)
    fairy_loop=("$2" "$3")
    shift 3
    ;;
  --fairy-start)
    fairy_start=$2
    shift 2
    ;;
  --redetect)
    redetect=1
    shift
    ;;
  --out)
    out=$2
    shift 2
    ;;
  -h | --help)
    sed -n '2,5p' "$0"
    exit 0
    ;;
  *)
    src=$1
    shift
    ;;
  esac
done
audio_require_src

rate=44100
audio_require ffmpeg ffprobe jq python3
audio_require_numpy
mkdir -p "$out"

# Prints the value of tag $2 in $1 (any case, file or stream level), or nothing.
read_tag() {
  ffprobe -v error -show_entries format_tags:stream_tags -of json "$1" |
    jq -r --arg k "${2^^}" '[.format.tags, (.streams // [])[].tags] | map(select(. != null)) | add // {} | with_entries(.key |= ascii_upcase) | .[$k] // empty'
}

# Prints the sample (at $rate) of the onset nearest $2 seconds among the strong ones within 1.5s, favouring bass attacks, placed 10ms early on a rising zero crossing.
snap_start() {
  ffmpeg -v error -i "$1" -ac 1 -ar "$rate" -f f32le - | python3 -c '
import sys
import numpy as np
x = np.frombuffer(sys.stdin.buffer.read(), dtype=np.float32).astype(np.float64)
rate, target = int(sys.argv[1]), float(sys.argv[2])
n, hop = 2048, 512
lo = max(0, int((target - 1.5) * rate) - n)
hi = min(len(x), int((target + 1.5) * rate) + n)
seg = x[lo:hi]
if len(seg) < 4 * n:
    print(max(0, min(len(x) - 1, int(target * rate))))
    sys.exit()
mag = np.log1p(np.abs(np.fft.rfft(np.lib.stride_tricks.sliding_window_view(seg, n)[::hop] * np.hanning(n), axis=1)))
flux = np.maximum(0, np.diff(mag, axis=0))
low = int(300 * n / rate)
score = flux.sum(axis=1) / (flux.sum(axis=1).max() + 1e-9) + flux[:, :low].sum(axis=1) / (flux[:, :low].sum(axis=1).max() + 1e-9)
centres = lo + (np.arange(1, len(mag)) * hop) + n // 2
ok = np.abs(centres - target * rate) <= 1.5 * rate
peak = np.r_[False, (score[1:-1] >= score[:-2]) & (score[1:-1] >= score[2:]), False]
strong = ok & peak & (score >= 0.6 * score[ok].max())
if not strong.any():
    strong = ok & (score == score[ok].max())
c = int(min(centres[strong], key=lambda v: abs(v - target * rate)))
blk = 64
e = np.array([np.sum(x[i:i + blk] ** 2) for i in range(c - 1024, c + 1024, blk)])
c = c - 1024 + int(np.argmax(np.diff(e))) * blk - int(0.01 * rate)
for k in sorted(range(-300, 301), key=abs):
    if c + k >= 1 and x[c + k - 1] <= 0 < x[c + k]:
        c += k
        break
print(max(0, c))
' "$rate" "$2"
}

# Cuts samples [$5, end) of $1 into $2 with $4 dB of gain, fading in over 5ms when it starts past 0.
cut() {
  local fade=
  (($5 > 0)) && fade=",afade=t=in:d=0.005"
  ffmpeg -v error -y -i "$1" -ar "$rate" -af "atrim=start_sample=$5:end_sample=$3,asetpts=PTS-STARTPTS$fade,volume=$4dB" -c:a libvorbis -q:a 6 -fflags +bitexact -flags:a +bitexact "$2"
}

# Prints the sample (at $rate) where $1 first sounds: 20ms RMS held over max(-50 dBFS, median - 40 dB) for 100ms, backed off 20ms onto a zero crossing.
sound_start() {
  ffmpeg -v error -i "$1" -ac 1 -ar "$rate" -f f32le - | python3 -c '
import sys
import numpy as np
x = np.frombuffer(sys.stdin.buffer.read(), dtype=np.float32).astype(np.float64)
rate = int(sys.argv[1])
w, hop = int(0.02 * rate), int(0.005 * rate)
if len(x) < 2 * w:
    print(0)
    sys.exit()
env = 20 * np.log10(np.sqrt(np.lib.stride_tricks.sliding_window_view(x ** 2, w)[::hop].mean(axis=1)) + 1e-12)
thr = max(-50.0, float(np.median(env[env > -80])) - 40 if np.any(env > -80) else -50.0)
run = int(0.1 / 0.005)
loud = env > thr
hits = [i for i in range(len(loud) - run) if loud[i:i + run].all()]
if not hits:
    print(0)
    sys.exit()
c = max(0, hits[0] * hop - int(0.02 * rate))
for k in range(0, 301):
    if c - k >= 1 and (x[c - k - 1] <= 0) != (x[c - k] <= 0):
        c -= k
        break
print(c)
' "$rate"
}

title_src=$(find_first_ext "$src/music/Title Theme")
fairy_src=$(find_first_ext "$src/music/Great Fairy's Fountain")
title_json=null
fairy_json=null

if [[ -f $title_src ]]; then
  title_json=$(resolve_loop "$title_src" "${title_loop[@]}")
  s=$(jq -r .start <<<"$title_json")
  e=$(jq -r .end <<<"$title_json")
  gain=$(music_gain "$title_src")
  if ((s > 0)); then
    trim=$(sound_start "$title_src")
    ((trim < s)) || trim=0
    cut "$title_src" "$out/title_intro.ogg" "$s" "$gain" "$trim"
    title_json=$(jq -c --argjson t "$trim" --argjson r "$rate" '. + {trim_start: $t, trim_start_s: ($t / $r * 10000 | round / 10000)}' <<<"$title_json")
  else
    rm -f "$out/title_intro.ogg"
  fi
  cut_loop "$title_src" "$out/title_loop.ogg" "$s" "$e" "$gain"
else
  echo "ocarina-audio: no $src/music/Title Theme.{flac,ogg,mp3}, skipping the title theme" >&2
fi

if [[ -f $fairy_src ]]; then
  fairy_json=$(resolve_loop "$fairy_src" "${fairy_loop[@]}")
  s=$(jq -r .start <<<"$fairy_json")
  e=$(jq -r .end <<<"$fairy_json")
  gain=$(music_gain "$fairy_src")
  cut_loop "$fairy_src" "$out/fairy_loop.ogg" "$s" "$e" "$gain"
  sr=$(src_rate "$fairy_src")
  tag=$(read_tag "$fairy_src" OCARINA_START)
  if [[ -z $fairy_start && $tag =~ ^[0-9]+$ ]]; then
    from=$(python3 -c "import sys; print(round(int(sys.argv[1]) * $rate / int(sys.argv[2])))" "$tag" "$sr")
    from_how=tags
  else
    from=$(snap_start "$fairy_src" "${fairy_start:-28}")
    from_how=snapped
    write_meta "$fairy_src" OCARINA_START="$(python3 -c "import sys; print(round(int(sys.argv[1]) * int(sys.argv[2]) / $rate))" "$from" "$sr")" || true
  fi
  if ((from < e)); then
    cut_loop "$fairy_src" "$out/fairy_intro.ogg" "$s" "$e" "$gain" "$from"
  else
    rm -f "$out/fairy_intro.ogg"
  fi
  fairy_json=$(jq -c --argjson f "$from" --arg how "$from_how" --argjson r "$rate" \
    '. + {play_from: $f, play_from_s: ($f / $r * 10000 | round / 10000), play_from_source: $how}' <<<"$fairy_json")
else
  echo "ocarina-audio: no $src/music/Great Fairy's Fountain.{flac,ogg,mp3}, skipping the fairy fountain" >&2
fi

declare -A fx=([start]=OOT_PressStart [move]=OOT_MainMenu_Cursor [letter]=OOT_MainMenu_Letter [decide]=OOT_MainMenu_Select [cancel]=OOT_MainMenu_Cancel [error]=OOT_MainMenu_Error)
for name in "${!fx[@]}"; do
  file="$src/fx/${fx[$name]}.wav"
  [[ -f $file ]] || continue
  peak=$(ffmpeg -hide_banner -nostats -i "$file" -af volumedetect -f null - 2>&1 | awk '/max_volume:/ { v = $5 } END { print v }')
  gain=$(python3 -c "import sys; print(round(-3 - float(sys.argv[1]), 2))" "$peak")
  ffmpeg -v error -y -i "$file" -ar "$rate" -ac 2 -af "volume=${gain}dB" -c:a pcm_s16le "$out/$name.wav"
done

jq -n --argjson title "$title_json" --argjson fairy "$fairy_json" --argjson rate "$rate" \
  '{rate: $rate, title: $title, fairy: $fairy}' | tee "$out/loops.json"
