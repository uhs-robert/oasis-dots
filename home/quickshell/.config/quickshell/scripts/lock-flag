#!/usr/bin/env bash
# Tracks a Quickshell session lock across qs restarts, so a new qs can take over a lock whose owner died.
# Usage: lock-flag set <qs pid> | clear | check <qs pid> | hyprlock
run="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
flag="$run/qs-session-locked"
sig=${HYPRLAND_INSTANCE_SIGNATURE:-}

case "$1" in
set)
  [ -n "$sig" ] || exit 1
  printf '%s %s\n' "$sig" "$2" >"$flag"
  ;;
clear) rm -f "$flag" ;;
check)
  [ -f "$flag" ] && [ -n "$sig" ] || exit 0
  read -r owner_sig owner_pid <"$flag"
  if [ "$owner_sig" != "$sig" ]; then
    [ -n "$owner_sig" ] && [ ! -e "$run/hypr/$owner_sig" ] && rm -f "$flag"
    exit 0
  fi
  [ "$owner_pid" = "$2" ] && exit 0
  case "$(cat "/proc/$owner_pid/comm" 2>/dev/null)" in
  qs | quickshell) exit 0 ;;
  esac
  echo relock
  ;;
hyprlock)
  exec 9>"$run/qs-hyprlock.lock"
  flock -n 9 || exit 0
  pidof hyprlock >/dev/null && exit 0
  start=$(date +%s%N)
  hyprlock --immediate-render --no-fade-in || exit 0
  [ $(($(date +%s%N) - start)) -gt 1000000000 ] && rm -f "$flag"
  ;;
*) exit 2 ;;
esac
