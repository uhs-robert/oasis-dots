#!/usr/bin/env bash
# Imports the GoldenEye lock skin's watch theme into $XDG_DATA_HOME/quickshell/goldeneye-audio (gitignored) as music.ogg: one loop cut at detected or given points, loudness evened out.
# The source is the first of .flac, .ogg or .mp3 (SOURCE may be the file or its path without extension); loop points come from LOOPSTART/LOOPLENGTH (or LOOPEND) tags in it; an untagged source is detected and the result is tagged into it losslessly.
# The loop starts at its start point and its last 60ms crossfade into the audio just before it, so the file repeats seamlessly.
# Usage: goldeneye-audio [--loop START END] [--redetect] [--out DIR] SOURCE   (seconds; an override is tagged too)
set -euo pipefail
# shellcheck source=lib/audio-loop.sh
source "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/lib/audio-loop.sh"
audio_name=goldeneye-audio
audio_loop_flags=--loop

src=""
loop=()
redetect=0
out="${XDG_DATA_HOME:-$HOME/.local/share}/quickshell/goldeneye-audio"
while (($#)); do
  case "$1" in
  --loop)
    loop=("$2" "$3")
    shift 3
    ;;
  --redetect)
    redetect=1
    shift
    ;;
  --out)
    out=$2
    shift 2
    ;;
  -h | --help)
    sed -n '2,5p' "$0"
    exit 0
    ;;
  *)
    src=$1
    shift
    ;;
  esac
done
audio_require_src

rate=44100
audio_require ffmpeg ffprobe jq python3
audio_require_numpy
mkdir -p "$out"

track=$(find_first_ext "${src%.*}")
[[ -n $track ]] || track=$([[ -f $src ]] && echo "$src")
if [[ -z $track ]]; then
  echo "goldeneye-audio: no $src (or .flac/.ogg/.mp3 of that name)" >&2
  exit 1
fi

json=$(resolve_loop "$track" "${loop[@]}")
s=$(jq -r .start <<<"$json")
e=$(jq -r .end <<<"$json")
gain=$(music_gain "$track")
tmp=$(mktemp "$out/.music.XXXXXX.ogg")
trap 'rm -f "$tmp"' EXIT
cut_loop "$track" "$tmp" "$s" "$e" "$gain"
chmod 644 "$tmp"
mv -f "$tmp" "$out/music.ogg"
jq -n --argjson loop "$json" --argjson rate "$rate" --argjson gain "$gain" '{rate: $rate, gain_db: $gain, loop: $loop}' | tee "$out/loops.json"
