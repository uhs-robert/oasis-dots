#!/usr/bin/env python3
"""Read and edit the front matter of plan docs under .plans/. See home/plans/README.md in the dotfiles repo."""

import os
import sys

# Stow links this file into ~/.local/bin, so the library is found from its real path. No bytecode, because a
# __pycache__ lands inside the stow package.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib", "plans"))

from plans import cli  # noqa: E402

sys.exit(cli.main())
