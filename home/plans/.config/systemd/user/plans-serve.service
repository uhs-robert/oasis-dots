[Unit]
Description=plans board: a web board over the plan docs of every repo, on 127.0.0.1:8765
Documentation=https://github.com/uhs-robert/oasis-dots/blob/main/home/plans/README.md
# The board's `o` key opens a terminal, which needs the Wayland session's environment.
PartOf=graphical-session.target
# Not After=graphical-session.target: the target wants this unit once enabled, and a target orders itself after the
# units it wants, so that would be a cycle.
After=graphical-session-pre.target

# Off unless asked for: `systemctl --user enable --now plans-serve` starts it now and with every graphical session.
# Nothing enables it on install.
# The service does not see a GITHUB_DIR exported only in the shell. Without ~/.config/plans/roots it uses the default
# roots and can miss repos that `plans ls --all` finds. That file replaces the defaults, so list every root in it.
[Service]
Type=simple
ExecStart=/usr/bin/python3 -I %h/.local/bin/plans serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
