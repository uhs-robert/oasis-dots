[Unit]
Description=voxcmd wake word listener ("Cortana")
Documentation=https://github.com/uhs-robert/oasis-dots/issues/845
PartOf=graphical-session.target
# Not After=graphical-session.target: the target wants this unit once enabled, and a target orders itself after the
# units it wants, so that would be a cycle.
After=graphical-session-pre.target

# Off unless asked for: `voxcmd wake on` starts it for this login, `voxcmd wake off` releases the microphone, and
# `systemctl --user enable voxcmd-wake` starts it at every login. Nothing enables it on install.
[Service]
Type=simple
Environment=OMP_NUM_THREADS=1
# Fetches the models on first use; it holds the unit in "activating" meanwhile. A failed download ("-") does not fail
# the start here: the listener then finds the models missing and exits 78, which is not restarted, instead of the
# download being retried every few seconds.
ExecStartPre=-/usr/bin/python3 -I %h/.local/bin/voxcmd-wake --fetch-models
ExecStart=/usr/bin/python3 -I %h/.local/bin/voxcmd-wake
ExecStopPost=/usr/bin/rm -f %t/voxcmd/wake.json
Restart=on-failure
RestartSec=5
# 78: openwakeword is not installed or a model is missing, which a restart cannot fix.
RestartPreventExitStatus=78
TimeoutStartSec=5min

[Install]
WantedBy=graphical-session.target
