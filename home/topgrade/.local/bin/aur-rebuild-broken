#!/usr/bin/env bash
# Rebuild the AUR packages that an upgrade broke, as the user (makepkg refuses
# root, so a pacman hook cannot do this). topgrade runs it as a post command.
set -euo pipefail

# checkrebuild with no options already lists foreign (AUR) packages: it tags
# them "foreign" in its repo table. Without -i it skips sync repos, which
# pacman and its hook cover. The list lines are "name<TAB>repo". -v appends
# the ldd detail after them, so one run gives the list and the reasons.
report=$(checkrebuild -v)
broken=$(awk -F '\t' 'NF == 2 && $2 == "foreign" { print $1 }' <<<"$report")

# A rebuild cannot fix a package whose library is missing outright (man
# checkrebuild: wrong dependency, typical for -bin). It can fix one whose
# library only moved to a newer soname, so a library counts as missing only
# when no installed library shares its name before ".so".
installed_libs=$(ldconfig -p | awk '/=>/ { print $1 }')
only_missing_libs() {
    local package=$1 path lib found=0 fixable=0
    # The detail block of a binary is "ldd <path>", a blank line, then one
    # "<lib> => not found" line per missing library.
    while IFS= read -r line; do
        if [[ $line == "ldd "* ]]; then
            path=${line#ldd }
            [[ $(pacman -Qqo -- "$path" 2>/dev/null) == "$package" ]] && found=1 || found=0
        elif ((found)) && [[ $line == *"=> not found"* ]]; then
            lib=$(awk '{ print $1 }' <<<"$line")
            grep -q -- "^${lib%%.so*}\.so" <<<"$installed_libs" && fixable=1
        fi
    done <<<"$report"
    # No ldd detail means a python, perl, ruby or haskell flag: a rebuild fixes it.
    ((fixable)) && return 1
    grep -qxF -- "$package" <<<"$ldd_packages" || return 1
    return 0
}
ldd_packages=$(
    awk '/^ldd / { sub(/^ldd /, ""); print }' <<<"$report" |
        xargs -r pacman -Qqo 2>/dev/null | sort -u
)

rebuildable=()
while IFS= read -r package; do
    [[ -n $package ]] || continue
    if [[ $package == *-bin ]]; then
        printf 'skip %s: prebuilt binary, a rebuild cannot fix it\n' "$package"
    elif only_missing_libs "$package"; then
        printf 'skip %s: a library is missing, not replaced\n' "$package"
    else
        rebuildable+=("$package")
    fi
done <<<"$broken"

if ((${#rebuildable[@]} == 0)); then
    printf 'aur-rebuild-broken: nothing to rebuild\n'
    exit 0
fi

printf 'aur-rebuild-broken: rebuilding %s\n' "${rebuildable[*]}"
paru -S --rebuild --noconfirm --skipreview -- "${rebuildable[@]}"
