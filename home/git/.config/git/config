[include]
	path = identity

[init]
	defaultBranch = main

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true

[pull]
	ff = only

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[rebase]
	autostash = true
	autosquash = true

[diff]
	algorithm = histogram
	colorMoved = zebra

[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"

[alias]
	dft = difftool --tool difftastic

[merge]
	conflictstyle = zdiff3

[rerere]
	enabled = true

[commit]
	verbose = true

[credential "https://github.com"]
	helper = !gh auth git-credential
