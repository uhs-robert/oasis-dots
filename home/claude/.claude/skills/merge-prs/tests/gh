#!/usr/bin/env bash
# Fake gh for merge-prs.sh, backed by the bare repo $ORIGIN. Each PR's fields live in $GH_STATE.<number>, or in
# $GH_STATE for a single-PR test. A PR with lag_reads=N reports stale_oid as its head for N reads after a push,
# the way GitHub can for a moment after a force-push.
set -euo pipefail
args="$*"
# resolve-thread.sh tests: log every call to $GH_LOG and answer from FAKE_* variables. The thread list is raw JSON, so
# the script's own jq filter runs; the repo name and isResolved answers stand in for gh's --jq output.
if [[ -n ${GH_LOG-} ]]; then
  echo "${args//$'\n'/ }" >>"$GH_LOG"
  case "$args" in
  "repo view"*) echo "${FAKE_REPO:-me/repo}" ;;
  *"addPullRequestReviewThreadReply"*)
    [[ -z ${FAKE_REPLY_FAIL-} ]] || {
      echo "reply failed" >&2
      exit 1
    }
    echo '{"data":{}}'
    ;;
  *"resolveReviewThread"*) echo '{"data":{}}' ;;
  *"... on PullRequestReviewThread"*) echo "${FAKE_RESOLVED:-false}" ;;
  # A second page is served when the call carries an after= cursor.
  *"reviewThreads(first: 100"*)
    if [[ $args == *" after="* ]]; then cat "$FAKE_THREADS_2"; else cat "$FAKE_THREADS"; fi
    ;;
  *)
    echo "fake gh: unhandled: $args" >&2
    exit 1
    ;;
  esac
  exit 0
fi
number=""
case "$args" in
"pr view "* | "pr merge "* | "pr edit "* | "pr comment "*) number=$3 ;;
"api graphql"*) number=$(grep -o 'number=[0-9]*' <<<"$args" | cut -d= -f2) ;;
esac
state_file=$GH_STATE
[[ -n $number && -f $GH_STATE.$number ]] && state_file=$GH_STATE.$number
get() { awk -F= -v k="$1" '$1==k{print substr($0, length(k)+2)}' "$state_file"; }
put() {
  grep -v "^$1=" "$state_file" >"$state_file.new" || true
  printf '%s=%s\n' "$1" "$2" >>"$state_file.new"
  mv "$state_file.new" "$state_file"
}
head_oid() { git -C "$ORIGIN" rev-parse -q --verify "refs/heads/$(get head)" || echo gone; }
reported_oid() {
  local oid lag
  oid=$(head_oid)
  lag=$(get lag_reads)
  if [[ -n $lag && $lag -gt 0 && $oid != "$(get stale_oid)" ]]; then
    put lag_reads $((lag - 1))
    oid=$(get stale_oid)
  fi
  echo "$oid"
}
# A new commit on the PR's branch, as a push from the author.
push_new_commit() {
  local w branch=${1:-$(get head)}
  w=$(mktemp -d)
  git clone -q "$ORIGIN" "$w/c"
  git -C "$w/c" checkout -q "$branch"
  echo late >"$w/c/late"
  git -C "$w/c" add late
  git -C "$w/c" -c user.name=t -c user.email=t@t commit -qm "feat: late push"
  git -C "$w/c" push -q origin "HEAD:$branch"
  rm -rf "$w"
}
# Reads of the merge gate (the registry's installed-reviewer inference, CodeRabbit's check run, review and summary, quota
# comments). They read the single-PR $GH_STATE, and a key a test leaves out takes the default noted here.
gate_state() {
  state_file=$GH_STATE
  [[ -f $state_file ]] || state_file=/dev/null
}
case "$args" in
# history_logins: ;-separated authors of the last PRs' comments, default Codex; "none" for no comments.
"pr list"*"--state all"*)
  gate_state
  logins=$(get history_logins)
  [[ -n $logins ]] || logins=chatgpt-codex-connector
  [[ $logins == none ]] || tr ';' '\n' <<<"$logins"
  exit 0
  ;;
# push_date: when the head reached GitHub (its earliest check suite); no suite when a test leaves it out.
*"/commits/"*"/check-suites"*"created_at"*)
  gate_state
  get push_date
  exit 0
  ;;
# suites: ;-separated app slugs of the default branch head's check suites, 30 per page unless the call paginates.
*"/check-suites"*)
  gate_state
  if [[ $args == *--paginate* ]]; then get suites | tr ';' '\n'; else get suites | tr ';' '\n' | head -30; fi
  exit 0
  ;;
# cr_run: ;-separated "name|status|conclusion|started|completed" check runs of the head. While cr_running_reads=N is
# above 0 each read counts it down and reports cr_run_running instead.
*"/check-runs"*)
  gate_state
  [[ -z $(get cr_api_fail) ]] || {
    echo "gh: HTTP 502" >&2
    exit 1
  }
  # push_on_cr_read=1: someone pushes to the PR branch while the check runs are read.
  [[ -z $(get push_on_cr_read) ]] || {
    put push_on_cr_read ""
    push_new_commit
  }
  reads=$(get cr_running_reads)
  if [[ -n $reads && $reads -gt 0 ]]; then
    put cr_running_reads $((reads - 1))
    get cr_run_running | tr ';' '\n'
  else
    get cr_run | tr ';' '\n'
  fi
  exit 0
  ;;
# cr_reviews: ;-separated "login|commit" PR reviews. $GH_STATE.comments holds the issue comments, one JSON object per line.
*"/pulls/"*"/reviews"*) gate_state && get cr_reviews | tr ';' '\n' && exit 0 ;;
*"/issues/"*"/comments"*)
  [[ ! -f $GH_STATE.comments ]] || cat "$GH_STATE.comments"
  exit 0
  ;;
# head_date: the head commit's committer date, default long ago. head_date_fail=1: the call fails.
*"/commits/"*"committer.date")
  gate_state
  [[ -z $(get head_date_fail) ]] || {
    echo "gh: HTTP 502" >&2
    exit 1
  }
  date=$(get head_date)
  echo "${date:-2000-01-01T00:00:00Z}"
  exit 0
  ;;
# A CodeRabbit re-request replaces its check run with cr_after, if the test gives one.
"pr comment"*"@coderabbitai review"*)
  put commented_cr 1
  [[ -z $(get cr_after) ]] || put cr_run "$(get cr_after)"
  # cr_after_running_reads=N: the new run shows as running for N reads first.
  [[ -z $(get cr_after_running_reads) ]] || put cr_running_reads "$(get cr_after_running_reads)"
  exit 0
  ;;
esac
case "$args" in
"repo view"*) printf 'me/repo\tmain\ttrue\ttrue\ttrue\n' ;;
"pr list"*)
  base=$(sed -E 's/.*--base ([^ ]+).*/\1/' <<<"$args")
  for f in "$GH_STATE".*; do
    [[ -f $f && $f != *.new ]] || continue
    state_file=$f
    [[ $(get base) == "$base" && $(get state) == OPEN ]] || continue
    printf '%s\t%s\t%s\tfalse\n' "${f##*.}" "$(get head)" "$(head_oid)"
  done
  ;;
# Each side of a compare against main: reviewed_subjects/reviewed_files for the commit Codex reviewed, head_subjects/
# head_files for anything else, as ;-separated lists.
"api repos/"*"/compare/"*)
  sha=$(sed -E 's|.*/compare/[^.]+\.\.\.([^ ]+).*|\1|' <<<"$args")
  side="head"
  [[ -n $(get codex_commit) && $sha == "$(get codex_commit)"* ]] && side=reviewed
  case $args in
  # The head side lists "sha<TAB>subject" (shas c1, c2, ... by position), the reviewed side subjects alone.
  *.sha*) get head_subjects | tr ';' '\n' | awk '{ printf "c%d\t%s\n", NR, $0 }' ;;
  *commits*) get "${side}_subjects" | tr ';' '\n' ;;
  *) get "${side}_files" | tr ';' '\n' ;;
  esac
  ;;
# Files of one commit: commit_files_<sha> in the state, as a ;-separated list.
"api repos/"*"/commits/"*)
  sha=$(sed -E 's|.*/commits/([^ ]+).*|\1|' <<<"$args")
  get "commit_files_$sha" | tr ';' '\n'
  ;;
# An @codex review runs for one read, then completes at the head.
"pr comment"*)
  put commented 1
  put codex_running_reads 1
  # codex_never_reviews=1: Codex answers with a summary that records no commit, as it does out of quota.
  [[ $(get codex_never_reviews || true) == 1 ]] || put codex_commit "$(head_oid | cut -c1-7)"
  ;;
"pr edit"*) put base "$(sed -E 's/.*--base ([^ ]+).*/\1/' <<<"$args")" ;;
"api graphql"*)
  # codex_pending_reads=N reports no Codex review yet on a fresh PR for N reads, then completed.
  pending=$(get codex_pending_reads || true)
  if [[ -n $pending ]]; then
    if ((pending > 0)); then
      put codex_pending_reads $((pending - 1))
      put codex Pending
    elif [[ $(get no_codex || true) == 1 ]]; then
      put codex none
    else
      put codex Completed
    fi
  fi
  # codex_running_reads=N reports the Codex review as running for N reads, then completed.
  runs=$(get codex_running_reads || true)
  if [[ -n $runs ]]; then
    if ((runs > 0)); then
      put codex_running_reads $((runs - 1))
      put codex Running
    else
      put codex Completed
    fi
  fi
  printf '%s\t%s\t%s\t%s\n' "$(get open_threads || true)" "$(get codex || true)" "$(get codex_commit || true)" "$(head_oid)" |
    awk -F'\t' -v OFS='\t' '{ if ($1 == "") $1 = 0; if ($2 == "") $2 = "none"; if ($3 == "") { $3 = "-"; if ($2 == "Completed") $2 = "Unreviewed" } print }'
  ;;
"pr view"*"headRefName,headRefOid,baseRefName,state,isCrossRepository"*)
  # push_on_merge_read=1: a push lands between the reviewer checks and the merge.
  [[ -z $(get push_on_merge_read) ]] || {
    put push_on_merge_read ""
    push_new_commit
  }
  # push_branch_on_merge_read=<branch>: the same push, to another PR's branch (a child).
  [[ -z $(get push_branch_on_merge_read) ]] || {
    branch=$(get push_branch_on_merge_read)
    put push_branch_on_merge_read ""
    push_new_commit "$branch"
  }
  printf '%s\t%s\t%s\t%s\t%s\n' "$(get head)" "$(reported_oid)" "$(get base)" "$(get state)" "$(get cross || true)" |
    awk -F'\t' -v OFS='\t' '{ if ($5 == "") $5 = "false"; print }'
  ;;
"pr view"*"headRefOid,mergeable"*)
  oid=$(reported_oid)
  m=MERGEABLE
  [[ $oid != "$(get conflicting_oid)" ]] || m=CONFLICTING
  # real_merge=1 reports the conflicts a merge into the base branch would really have.
  if [[ $(get real_merge) == 1 ]] && ! git -C "$ORIGIN" merge-tree --write-tree "refs/heads/$(get base)" "$oid" >/dev/null 2>&1; then
    m=CONFLICTING
  fi
  printf '%s\t%s\n' "$oid" "$m"
  ;;
"pr view"*"--json isCrossRepository --jq"*) get cross || echo false ;;
"pr view"*"--json headRefOid --jq"*) reported_oid ;;
"pr view"*"--json state"*) get state ;;
"pr merge"*)
  [[ $args == *"--match-head-commit $(head_oid)"* ]] || {
    echo "Head branch was modified" >&2
    exit 1
  }
  [[ $(get conflicting_oid) != "$(head_oid)" ]] || {
    echo "not mergeable" >&2
    exit 1
  }
  w=$(mktemp -d)
  git clone -q "$ORIGIN" "$w/c"
  git -C "$w/c" -c user.name=t -c user.email=t@t cherry-pick "origin/main..origin/$(get head)" >/dev/null
  git -C "$w/c" push -q origin HEAD:main
  [[ $args != *--delete-branch* ]] || git -C "$ORIGIN" branch -q -D "$(get head)"
  rm -rf "$w"
  put state MERGED
  ;;
*)
  echo "fake gh: unhandled: $args" >&2
  exit 1
  ;;
esac
