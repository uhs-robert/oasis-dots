#!/usr/bin/env python3
"""act <id> [param...]: perform one action of the manifest in ~/.config/actions from the logged-in desktop session.

Exit 0 when the performer ran, 1 when it failed, 2 on an unknown id, a bad param or an unreadable manifest, without
running anything. Reads the bar through hypr's qs-ipc, so run it inside the session.
"""

import os
import subprocess
import sys

sys.dont_write_bytecode = True
# Beside this file's real path, so the stowed symlink finds the module in the checkout.
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "share", "actions"))
import manifest  # noqa: E402

QS_IPC = "~/.config/hypr/scripts/qs-ipc"


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip().splitlines()[0], file=sys.stderr)
        return 2
    try:
        actions, bindings = manifest.load()
        action = actions.get(argv[0])
        if action is None:
            raise manifest.ActionError(f"unknown action {argv[0]!r} (known: {', '.join(sorted(actions))})")
        if argv[0] not in bindings:
            raise manifest.ActionError(f"{argv[0]} has no quickshell binding")
        values = manifest.bind_params(action, argv[1:])
        qs_ipc = os.environ.get("ACT_QS_IPC") or os.path.expanduser(QS_IPC)
        command = manifest.command_line(bindings[argv[0]], values, qs_ipc)
    except manifest.ActionError as error:
        print(f"act: {error}", file=sys.stderr)
        return 2
    try:
        return 0 if subprocess.run(command).returncode == 0 else 1
    except OSError as error:
        print(f"act: cannot run {command[0]}: {error.strerror}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
