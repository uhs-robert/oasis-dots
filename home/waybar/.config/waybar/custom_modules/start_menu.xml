<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkMenu" id="menu">

    <!-- Top: All apps opens your launcher -->
    <child>
      <object class="GtkMenuItem" id="apps">
        <child>
          <object class="GtkLabel">
            <property name="use-markup">true</property>
            <property name="xalign">0</property>
            <property name="label">&lt;span size="12288" foreground="#6BBF59"&gt;󰣇&lt;/span&gt;  Apps</property>
          </object>
        </child>
      </object>
    </child>

    <child><object class="GtkSeparatorMenuItem" id="sep0"/></child>

    <!-- Session -->

    <child>
      <object class="GtkMenuItem" id="lock">
        <child>
          <object class="GtkLabel">
            <property name="use-markup">true</property>
            <property name="xalign">0</property>
            <property name="label">&lt;span size="12288" foreground="#cdd6f4"&gt;󰌾&lt;/span&gt;  Lock</property>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="GtkMenuItem" id="logout">
        <child>
          <object class="GtkLabel">
            <property name="use-markup">true</property>
            <property name="xalign">0</property>
            <property name="label">&lt;span size="12288" foreground="#89dceb"&gt;󰍃&lt;/span&gt;  Logout</property>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="GtkMenuItem" id="reboot">
        <child>
          <object class="GtkLabel">
            <property name="use-markup">true</property>
            <property name="xalign">0</property>
            <property name="label">&lt;span size="12288" foreground="#f9e2af"&gt;󰜉&lt;/span&gt;  Reboot</property>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="GtkMenuItem" id="power">
        <child>
          <object class="GtkLabel">
            <property name="use-markup">true</property>
            <property name="xalign">0</property>
            <property name="label">&lt;span size="12288" foreground="#f38ba8"&gt;󰐥&lt;/span&gt;  Power Off</property>
          </object>
        </child>
      </object>
    </child>

  </object>
</interface>
