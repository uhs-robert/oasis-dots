# vim: ft=config
# default keys are in `man imv`

# [OPTIONS]
[options]
background = 0C0E13
overlay_font = ProFont IIx Nerd Font Mono:14

[binds]
# [NAVIGATION]
<Shift+H> = next
<Shift+L> = prev

# [ZOOM]
i = zoom 1
+ = zoom 1
o = zoom -1
- = zoom -1
= = reset
0 = zoom actual
f = fullscreen
# r = reset

# [PAN]
h = pan 50 0
l = pan -50 0

# [ROTATION]
<Ctrl+r> = rotate by 90
# c = center

# [MISC]
q = quit
d = overlay
t = slideshow +1
T = slideshow -1
# p = print to stdout
# SPACE = toggle_playing
