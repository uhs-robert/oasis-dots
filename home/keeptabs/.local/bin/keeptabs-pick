#!/usr/bin/env bash
# Pick a running agent session (Claude Code, Codex) and focus its window, tmux pane, and nvim terminal.
# keeptabs: state files are written by keeptabs-hook.

set -uo pipefail

DIR="${XDG_RUNTIME_DIR:-/tmp}/keeptabs"

# shellcheck source=/dev/null
source "$HOME/.local/share/keeptabs/lib.sh"

sessions() {
  local f pid comm
  for f in "$DIR"/*.json; do
    [[ -e "$f" ]] || continue
    IFS=$'\x1f' read -r pid comm < <(jq -r '[.pid, .comm // "claude"] | map(tostring) | join("\u001f")' "$f")
    if [[ "$(cat "/proc/$pid/comm" 2>/dev/null)" != "$comm" ]]; then
      rm -f "$f"
      continue
    fi
    cat "$f"
  done | jq -s '
    {waiting: 0, done: 1, running: 2, idle: 3} as $rank
    | sort_by($rank[.state] // 4, .since)'
}

tmux_cmd() { tmux -S "$socket" "$@"; }

focus_tmux() {
  local client
  session="$(tmux_cmd display -p -t "$pane" '#{session_name}')" || return 1
  client="$(tmux_cmd list-clients -t "$session" -F '#{client_activity} #{client_pid} #{client_tty}' | sort -rn | head -n 1)"

  tmux_cmd select-window -t "$pane"
  tmux_cmd select-pane -t "$pane"

  if [[ -z "$client" ]]; then
    kitty -e tmux -S "$socket" attach -t "$session" &
    return 1
  fi
  tmux_cmd switch-client -c "$(awk '{print $3}' <<<"$client")" -t "$session"
  anchor="$(awk '{print $2}' <<<"$client")"
}

focus_window() {
  local pids term_pid kitty_sock win_json win_id title address
  pids="$(ancestors "$anchor" | jq -s .)"
  term_pid="$(hyprctl clients -j | jq -r --argjson p "$pids" '[.[].pid | select(IN($p[]))][0] // empty')"
  [[ -z "$term_pid" ]] && return 1

  kitty_sock="${XDG_RUNTIME_DIR:-/tmp}/kitty-$term_pid"
  if [[ -S "$kitty_sock" ]]; then
    win_json="$(kitten @ --to "unix:$kitty_sock" ls | jq -c --argjson p "$pids" '
      [.[].tabs[].windows[]
       | select((.pid | IN($p[])) or any(.foreground_processes[]; .pid | IN($p[])))][0] // empty')"
    if [[ -n "$win_json" ]]; then
      win_id="$(jq -r .id <<<"$win_json")"
      title="$(jq -r .title <<<"$win_json")"
      kitten @ --to "unix:$kitty_sock" focus-window --match "id:$win_id"
    fi
  fi

  address="$(hyprctl clients -j | jq -r --argjson pid "$term_pid" --arg title "${title:-}" --arg session "${session:-}" '
    [.[] | select(.pid == $pid)] as $c
    | ([$c[] | select(.title == $title)]
       + [$c[] | select($session != "" and (.title | ascii_downcase | contains($session | ascii_downcase)))]
       + $c)[0].address')"
  hyprctl dispatch "hl.dsp.focus({ window = 'address:$address' })" >/dev/null
}

focus_nvim() {
  [[ -S "$nvim" ]] || return 0
  local pids lua
  pids="$(ancestors "$agent_pid" | paste -sd,)"
  lua='(function(p) local s = {} for _, v in ipairs(p) do s[v] = true end'
  lua+=' for _, b in ipairs(vim.api.nvim_list_bufs()) do'
  lua+=' if vim.bo[b].buftype == "terminal" and s[select(2, pcall(vim.fn.jobpid, vim.bo[b].channel))] then'
  lua+=' local w = vim.fn.win_findbuf(b)[1]'
  lua+=' if w then vim.api.nvim_set_current_win(w) else vim.api.nvim_set_current_buf(b) end'
  lua+=' vim.cmd.startinsert() return 1 end end return 0 end)(_A)'
  nvim --server "$nvim" --remote-expr "luaeval('$lua', [$pids])" >/dev/null
}

# Print the given keys of session $1, separated by \x1f so empty values survive read.
field() {
  local i="$1"
  shift
  jq -r --argjson i "$i" --args '.[$i] as $s | [$ARGS.positional[] | $s[.] // "" | tostring] | join("\u001f")' "$@" <<<"$data"
}

age() {
  local s=$(($(date +%s) - $1))
  if ((s < 60)); then echo "${s}s"; elif ((s < 3600)); then echo "$((s / 60))m"; else echo "$((s / 3600))h"; fi
}

escape() { sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' <<<"$1"; }

declare -A COLOR=([waiting]="#FFA0A0" [done]="#A3E39A" [running]="#7FA3C9" [idle]="#717A84")
MUTED="#717A84"

data="$(sessions)"
count="$(jq length <<<"$data")"
if ((count == 0)); then
  rofi -e "No agent sessions"
  exit 0
fi

rows=""
for ((i = 0; i < count; i++)); do
  IFS=$'\x1f' read -r id state since cwd socket pane nvim title agent < <(field "$i" id state since cwd tmux_socket tmux_pane nvim title agent)
  where="terminal"
  [[ -n "$pane" ]] && where="tmux $(tmux -S "$socket" display -p -t "$pane" '#{session_name}:#{window_index}' 2>/dev/null)"
  [[ -n "$nvim" ]] && where+=" nvim"
  rows+="$(printf '<span color="%s"><b>%-8s</b></span> %s  <span color="%s">%s · %s · %s · %s</span>' \
    "${COLOR[$state]:-$MUTED}" "${state^^}" "$(escape "${title:-Untitled}")" \
    "$MUTED" "${agent:-claude}" "$(escape "$(basename "$cwd")")" "$where" "$(age "$since")")"$'\n'
done

rofi_args=(-name rofiDmenu -i -dmenu -markup-rows -p Agents -format i)

index="$(printf '%s' "$rows" | rofi "${rofi_args[@]}")"
[[ "$index" =~ ^[0-9]+$ ]] || exit 0

IFS=$'\x1f' read -r id state agent_pid socket pane nvim agent < <(field "$index" id state pid tmux_socket tmux_pane nvim agent)

# Jumping to a finished session counts as seeing it, so it drops from done to idle.
if [[ "$state" == "done" ]]; then
  printf '{"session_id":"%s"}' "$id" | AGENT_PID="$agent_pid" ~/.local/bin/keeptabs-hook idle "${agent:-claude}"
fi

anchor="$agent_pid"
if [[ -n "$pane" ]]; then
  focus_tmux || exit 0
fi
focus_window
focus_nvim
