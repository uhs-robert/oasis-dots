#!/usr/bin/env bash
# /usr/local/bin/qs-greeter
# Runs the Quickshell greeter; falls back to tuigreet in kitty when it is missing, does not come up in 10s, crashes, or asks for it (F10, SUPER+T).

config=${QS_GREETER_CONFIG:-/etc/greetd/quickshell}
state="${XDG_RUNTIME_DIR:-/tmp}/qs-greeter"
mkdir -p "$state/cache" "$state/state" "$state/data"
rm -f "$state/ready" "$state/fallback" "$state/launched"

tuigreet_fallback() {
  kitty -- tuigreet --config /etc/tuigreet/config.toml --debug /tmp/tuigreet.log &
  local terminal_pid=$!
  sleep 1.5
  hyprctl eval 'FULLSCREEN_TERMINAL()' >/dev/null
  wait "$terminal_pid"
  exit 0
}

stop_qs() {
  kill "$qs_pid" 2>/dev/null
  for _ in 1 2 3 4 5 6 7 8; do
    kill -0 "$qs_pid" 2>/dev/null || return
    sleep 0.25
  done
  kill -9 "$qs_pid" 2>/dev/null
}

command -v qs >/dev/null && [[ -f "$config/shell.qml" ]] || tuigreet_fallback

# The greeter user's home is /, so its XDG dirs live here; no crash dialog over the fallback.
XDG_CACHE_HOME="$state/cache" XDG_STATE_HOME="$state/state" XDG_DATA_HOME="$state/data" \
  QS_DISABLE_CRASH_HANDLER=1 QS_GREETER_STATE="$state" QS_THEME_JSON=/var/lib/qs-greeter/theme.json \
  qs -p "$config" >"$state/qs.log" 2>&1 &
qs_pid=$!

for _ in $(seq 40); do
  [[ -e "$state/ready" ]] && break
  kill -0 "$qs_pid" 2>/dev/null || break
  sleep 0.25
done
if [[ ! -e "$state/ready" ]]; then
  stop_qs
  tuigreet_fallback
fi

wait "$qs_pid"
status=$?
[[ -e "$state/launched" ]] && exit 0
[[ -e "$state/fallback" || $status -ne 0 ]] && tuigreet_fallback
exit 0
