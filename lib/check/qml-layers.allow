# Upward Quickshell edges that exist today (lib/check/steps/qml_layers.py), one per line:
#   <file> -> <target>  # <reason> (<item that removes it>)
# Delete a line in the PR that removes its edge; a line whose edge is gone fails the check as stale. "5.9 step N" is
# the step of the imports-that-run-the-wrong-way item in quickshell-refactor.md.

services/StyleIpc.qml -> qs.features.audio                              # services has no destination yet (undecided)
styles/goldeneye/widgets/WatchDial.qml -> qs.features.windows           # the workspace icons come in as a feature type; inject the data instead (5.9 step 5)
styles/oasis/widgets/Constellation.qml -> qs.features.windows           # the workspace icons come in as a feature type; inject the data instead (5.9 step 5)
theme/Style.qml -> styles/IconSets.js                                   # the style engine consumes style data by design (permanent)
theme/Style.qml -> styles/goldeneye/Watch.js                            # the style engine consumes style data by design (permanent)
theme/Style.qml -> styles/index.js                                      # the style engine consumes style data by design (permanent)
theme/Style.qml -> url:features/lock/skins/index.json                   # skin list read as data by the style engine (permanent)
theme/Style.qml -> url:styles                                           # the style engine consumes style data by design (permanent)
ui/frames/CustomFrame.qml -> qs.styles.ff7.widgets                      # popup framework moves above styles, or takes the data as properties (5.9 step 5)
ui/frames/CustomFrame.qml -> qs.styles.gameboy.widgets                  # popup framework moves above styles, or takes the data as properties (5.9 step 5)
ui/frames/CustomFrame.qml -> qs.styles.oasis.widgets                    # popup framework moves above styles, or takes the data as properties (5.9 step 5)
ui/frames/CustomFrame.qml -> qs.styles.tie.widgets                      # popup framework moves above styles, or takes the data as properties (5.9 step 5)
ui/frames/TitleStrip.qml -> qs.features.popups                          # popup framework moves above styles, or takes the data as properties (5.9 step 5)
ui/gauges/Meter.qml -> styles/goldeneye/Watch.js                        # popup framework moves above styles, or takes the data as properties (5.9 step 5)
ui/gauges/Meter.qml -> url:styles                                       # popup framework moves above styles, or takes the data as properties (5.9 step 5)
ui/gauges/Slider.qml -> qs.styles.ps2.widgets                           # skinned tier moves above styles, or takes the skin as a property (5.9 step 5)
ui/gauges/Waveform.qml -> qs.features.voice                             # shared widget reads the voice level; inject the data (5.9 step 5)
ui/keys/ControllerBadge.qml -> url:styles                               # popup framework moves above styles, or takes the data as properties (5.9 step 5)
ui/keys/KeyHelp.qml -> qs.features.audio                                # popup framework moves above styles, or takes the data as properties (5.9 step 5)
ui/keys/KeyHelp.qml -> qs.features.popups                               # popup framework moves above styles, or takes the data as properties (5.9 step 5)
ui/menu/MenuFooter.qml -> qs.styles.metroid.widgets                     # popup framework moves above styles, or takes the data as properties (5.9 step 5)
ui/menu/MenuFooter.qml -> qs.styles.oasis.widgets                       # popup framework moves above styles, or takes the data as properties (5.9 step 5)
