#!/usr/bin/env python3
"""Writes the IPC function table in the Quickshell README from the IpcHandler declarations; --check only compares."""

import json
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import docgen  # noqa: E402
from docgen import ROOT, GenError, cell, run_lua, splice  # noqa: E402,F401

sys.path.insert(0, os.path.join(ROOT, "lib", "check", "steps"))
import qml_ipc  # noqa: E402

DOC = os.path.join(ROOT, qml_ipc.QS_DIR, "README.md")
ACTIONS_SCRIPT = os.path.join("home", "hypr", "tests", "act_refs.lua")


def action_ids(actions_json):
    """{(target, function): [action ids]} for the actions that perform an IPC call."""
    try:
        actions = json.loads(actions_json)["actions"]
    except (ValueError, KeyError) as error:
        raise GenError(f"{ACTIONS_SCRIPT} printed no action list: {error}")
    ids = {}
    for action in actions:
        perform = action["perform"]
        if perform["kind"] == "ipc":
            ids.setdefault((perform["target"], perform["function"]), []).append(action["id"])
    return ids


def render(handlers, ids):
    """The table: targets alphabetical, functions in source order, so a regeneration never reorders rows."""
    lines = ["| Target | Signature | Action id |", "| --- | --- | --- |"]
    for target, handler in sorted(handlers.items()):
        for name, parameters, returns in handler.signatures:
            signature = f"{name}({parameters}): {returns}"
            lines.append(f"| {cell(target, True)} | {cell(signature, True)} | {cell(', '.join(ids.get((target, name), [])), True)} |")
    return "\n".join(lines) + "\n"


def add_arguments(parser):
    parser.add_argument("--actions", help="read the action list JSON from this file instead of running lua")
    parser.add_argument("--root", default=ROOT, help="the checkout whose QML is read")


def render_table(args):
    if args.actions:
        with open(args.actions, encoding="utf-8") as file:
            actions = file.read()
    else:
        actions = run_lua(ACTIONS_SCRIPT)
    # Only the shell's handlers belong in its README; the demo overlay's do not.
    handlers, findings = qml_ipc.declared(args.root, (qml_ipc.QS_DIR,))
    if findings:
        raise GenError("; ".join(f"{f.path}:{f.line}: {f.message}" for f in findings))
    return render(handlers, action_ids(actions))


def main():
    return docgen.main("gen-ipc", __doc__, DOC, "IPC table", add_arguments, render_table)


if __name__ == "__main__":
    sys.exit(main())
