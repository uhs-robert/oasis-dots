#!/usr/bin/env bash
# One-time copy of the laptop's bar state, theme, FF7 lock audio and fonts to an agent host, so the shadow bar there looks
# like the real one. Usage: agent-host-seed <host>
# Existing files on the host are never overwritten, so a rerun cannot undo state the host has made since.
# weather.local.json (a location) never leaves the laptop.
set -euo pipefail

host=${1:?usage: agent-host-seed <host>}
# The laptop's ssh config runs a RemoteCommand (a tmux attach) and may request a tty; rsync needs a plain connection.
rsh='ssh -o RemoteCommand=none -o RequestTTY=no'

# What the shadow bar reads (.claude/skills/shadow/shadow.sh seed_home and its font config): the state JSON of the bar and
# Hyprland, Hyprland's `theme` file, the user fonts, and the gitignored FF7 audio from the dotfiles checkout.
# Copies a directory's contents to the same place under the host's home. The remote mkdir comes first because rsync makes
# no parent directories before 3.2.3.
copy() {
  local dir=$1
  shift
  if [[ ! -d $HOME/$dir ]]; then
    echo "skip $dir: not on this machine"
    return 0
  fi
  rsync -a --ignore-existing --exclude=weather.local.json -e "$rsh" --rsync-path="mkdir -p $dir && rsync" "$@" "$HOME/$dir/" "$host:$dir/"
}

copy .local/state/quickshell --include='*.json' --exclude='*'
copy .local/state/hypr --include='*.json' --include=theme --exclude='*'
# The shadow reads the audio from the checkout, not ~/.config, and --server does not stow quickshell. The host's checkout
# sits at the same path under its home as this one (AGENT_HOST_CHECKOUT overrides the main checkout used here).
checkout=${AGENT_HOST_CHECKOUT:-$(git -C "$(dirname "$0")" rev-parse --path-format=absolute --git-common-dir | sed 's|/\.git$||')}
if [[ $checkout == "$HOME"/* ]]; then
  # The remote mkdir would otherwise leave a stray tree where a later clone has to go.
  # shellcheck disable=SC2086  # $rsh is a command with options
  if $rsh "$host" "test -d '${checkout#"$HOME"/}/.git'"; then
    copy "${checkout#"$HOME"/}/home/quickshell/.config/quickshell/features/lock/skins/ff7/audio"
  else
    echo "skip the FF7 audio: $host has no checkout at ~/${checkout#"$HOME"/}; clone it there and run this again"
  fi
else
  echo "skip the FF7 audio: $checkout is not under $HOME, so the host path is unknown"
fi
# The shadow reads fonts here, and install_fonts is skipped under --server.
copy .local/share/fonts
