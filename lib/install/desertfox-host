#!/usr/bin/env bash
# Installs or updates the DesertFox native hosts and CLI by running the latest release's own install.sh, which checks the checksums.
# DESERTFOX_REPO and DESERTFOX_API exist for the offline test; DESERTFOX_NO_GH skips gh so the test reaches the curl fallback.
set -euo pipefail
repo=${DESERTFOX_REPO:-uhs-robert/desertfox}
api=${DESERTFOX_API:-https://api.github.com/repos/$repo/releases/latest}
download_base=${DESERTFOX_DOWNLOAD:-https://github.com/$repo/releases/download}

tag=""
if [[ -z ${DESERTFOX_NO_GH:-} ]] && command -v gh >/dev/null 2>&1; then
  tag=$(gh release view --repo "$repo" --json tagName --jq .tagName 2>/dev/null) || tag=""
fi
if [[ -z $tag ]]; then
  # sed, not jq: this must work on a machine that has only curl.
  tag=$(curl -fsSL --max-time 20 "$api" | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1) || tag=""
fi
if [[ -z $tag ]]; then
  echo "desertfox-host: cannot find the latest release of $repo (needs network)" >&2
  exit 1
fi
version=${tag#v}

# The script runs remote code, so it goes in a fresh directory and is passed by path.
dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
curl -fsSL --max-time 60 -o "$dir/install.sh" "$download_base/$tag/install.sh"
bash "$dir/install.sh" "$version"
