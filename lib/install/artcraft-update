#!/usr/bin/env bash
# Usage: artcraft-update [--check] [--if-installed] [app...]
# Installs or updates the ArtCraft apps in packages/artcraft.ini (or the named ones) from their GitHub releases.
# --check only lists what is behind. --if-installed does nothing unless some ArtCraft app is installed, so topgrade
# never installs the suite on a machine that declined it. ArtCraft has no pacman repo or AUR package, so this is how
# they stay current.
set -uo pipefail

repo_dir=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
manifest="${ARTCRAFT_MANIFEST:-$repo_dir/packages/artcraft.ini}"
releases="${ARTCRAFT_RELEASES:-https://github.com/storytold}"
# Every ArtCraft repo signs SHA256SUMS.txt with this primary key. The key file comes from the release itself, so the
# pinned fingerprint is what makes the signature mean anything.
fingerprint="${ARTCRAFT_FINGERPRINT:-2B76741B414AAD6CD33E631213A005C0B9D7C3ED}"

read -ra as_root <<<"${ARTCRAFT_SUDO-sudo}"

check_only=0
if_installed=0
apps=()
for arg in "$@"; do
  case $arg in
  --check) check_only=1 ;;
  --if-installed) if_installed=1 ;;
  -*)
    echo "artcraft-update: unknown option $arg" >&2
    exit 2
    ;;
  *) apps+=("$arg") ;;
  esac
done
if ((${#apps[@]} == 0)); then
  if [[ ! -r $manifest ]]; then
    echo "artcraft-update: cannot read $manifest" >&2
    exit 1
  fi
  mapfile -t apps < <(grep -v -e '^#' -e '^\[' -e '^[[:space:]]*$' "$manifest")
fi
# Names reach paths, URLs and pacman, so anything but a plain package name is refused.
for app in "${apps[@]}"; do
  if [[ ! $app =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    echo "artcraft-update: not an app name: $app" >&2
    exit 2
  fi
done
# grep reads the whole list: with -q it stops early, pacman dies of SIGPIPE, and pipefail reads that as no ArtCraft.
if ((if_installed)) && ! pacman -Qq 2>/dev/null | grep '^ai\.storyteller\.' >/dev/null; then
  exit 0
fi

case $(uname -m) in
x86_64) arch=x86_64 ;;
aarch64) arch=aarch64 ;;
*)
  echo "artcraft-update: no Arch package for $(uname -m)" >&2
  exit 1
  ;;
esac

work=$(mktemp -d) || exit 1
stage=""
# shellcheck disable=SC2329 # run by the EXIT trap
cleanup() {
  rm -rf "$work"
  [[ -z $stage ]] || "${as_root[@]}" rm -rf "$stage"
}
trap cleanup EXIT
mkdir -m 700 "$work/gnupg"

# The latest tag, read from where /releases/latest redirects. This needs no API token and no rate limit.
latest_version() {
  local url
  url=$(curl -fsSL --max-time 20 -o /dev/null -w '%{url_effective}' "$releases/$1/releases/latest") || return 1
  [[ $url == */tag/v* ]] || return 1
  printf '%s\n' "${url##*/tag/v}"
}

# Checks SHA256SUMS.txt against the pinned key, then the package against SHA256SUMS.txt, and prints the package's sum.
verify() {
  local dir=$1 file=$2 statuses primary line
  gpg --homedir "$work/gnupg" --batch --quiet --import "$dir/release-signing-key.asc" 2>/dev/null || return 1
  statuses=$(gpg --homedir "$work/gnupg" --batch --status-fd 1 --verify "$dir/SHA256SUMS.txt.asc" "$dir/SHA256SUMS.txt" 2>/dev/null)
  # gpg can print VALIDSIG beside an expired or revoked key or signature, so those statuses refuse it outright.
  grep -qE '^\[GNUPG:\] (EXPSIG|EXPKEYSIG|REVKEYSIG|BADSIG|ERRSIG) ' <<<"$statuses" && return 1
  grep -q '^\[GNUPG:\] GOODSIG ' <<<"$statuses" || return 1
  # VALIDSIG's last field is the primary key's fingerprint, even when a subkey made the signature.
  primary=$(awk '$2 == "VALIDSIG" { print $NF }' <<<"$statuses")
  [[ $primary == "$fingerprint" ]] || return 1
  line=$(awk -v file="$file" '$2 == file && $1 ~ /^[0-9a-f]{64}$/ { print; exit }' "$dir/SHA256SUMS.txt")
  [[ -n $line ]] || return 1
  (cd "$dir" && sha256sum --check --quiet --status - <<<"$line") || return 1
  printf '%s\n' "${line%% *}"
}

status=0
to_install=()
sums=()
for app in "${apps[@]}"; do
  installed=$(pacman -Q "ai.storyteller.$app" 2>/dev/null | awk '{ print $2 }')
  installed=${installed%-*}
  if ! latest=$(latest_version "$app"); then
    echo "artcraft-update: $app: could not read the latest release" >&2
    status=1
    continue
  fi
  if [[ -n $installed ]] && (($(vercmp "$installed" "$latest") >= 0)); then
    continue
  fi
  echo "artcraft-update: $app ${installed:-not installed} -> $latest"
  ((check_only)) && continue

  dir="$work/$app"
  file="$app-$latest-linux-$arch.pkg.tar.zst"
  base="$releases/$app/releases/download/v$latest"
  mkdir -p "$dir"
  for name in "$file" SHA256SUMS.txt SHA256SUMS.txt.asc release-signing-key.asc; do
    curl -fsSL --max-time 600 -o "$dir/$name" "$base/$name" || break
  done
  if ! sum=$(verify "$dir" "$file"); then
    echo "artcraft-update: $app: download missing or failed its signature or checksum, skipped" >&2
    status=1
    continue
  fi
  to_install+=("$dir/$file")
  sums+=("$sum")
done

# Another process of this user could swap a checked file in $work before pacman reads it as root. So the packages are
# copied into a directory only root can write, and checked again there against the sums verify read.
if ((${#to_install[@]} > 0)); then
  stage=$("${as_root[@]}" mktemp -d /var/tmp/artcraft-update.XXXXXX) || exit 1
  staged=()
  for i in "${!to_install[@]}"; do
    target="$stage/${to_install[i]##*/}"
    "${as_root[@]}" install -m 644 "${to_install[i]}" "$target" || exit 1
    if ! "${as_root[@]}" sha256sum --check --quiet --status - <<<"${sums[i]}  $target"; then
      echo "artcraft-update: ${to_install[i]##*/} changed after it was verified, nothing installed" >&2
      exit 1
    fi
    staged+=("$target")
  done
  "${as_root[@]}" pacman -U --needed "${staged[@]}" || status=1
fi
exit "$status"
