node_modules/
__pycache__/
*.pyc
*.egg-info/
**/package.toml
!home/yazi/.config/yazi/package.toml

# Yazi package-managed plugins are restored from package.toml.
home/yazi/.config/yazi/plugins/*
!home/yazi/.config/yazi/plugins/folder-rules.yazi/
!home/yazi/.config/yazi/plugins/folder-rules.yazi/**

# ────────────────────────────────────────────────
# ⚠️ Security: Hidden sensitive config
# ────────────────────────────────────────────────
.ssh/
.gnupg/
.aws/
.gcloud/
.netrc
.bash_history
.zsh_history


# ────────────────────────────────────────────────
# 🤖 AI assistant artifacts (Claude, Gemini, etc.)
# ────────────────────────────────────────────────
# Ignored by default: a new tracked file needs a `!` rule covering its path (most subtrees already have a `!.../**`
# one; skills/synced/ is re-ignored below), or git silently never adds it.
home/claude/**
!home/claude/.claude/
!home/claude/.claude/_agents/
!home/claude/.claude/_agents/**
!home/claude/.claude/agents/
!home/claude/.claude/agents/**
!home/claude/.claude/commands/
!home/claude/.claude/commands/**
!home/claude/.claude/hooks/
!home/claude/.claude/hooks/**
!home/claude/.claude/skills/
!home/claude/.claude/skills/**
home/claude/.claude/skills/synced/
!home/claude/.claude/AGENTS.md
!home/claude/.claude/settings.json
!home/claude/.claude/keybindings.json
!home/claude/.claude/statusline-command.sh
!home/claude/.claude/pr-context.sh
home/gemini/**
!home/gemini/.gemini/
!home/gemini/.gemini/commands/
!home/gemini/.gemini/commands/**
!home/gemini/.gemini/theme/
!home/gemini/.gemini/theme/**
!home/gemini/.gemini/settings.json
home/codex/**
!home/codex/.codex/
!home/codex/.codex/prompts/
!home/codex/.codex/prompts/**
!home/codex/.codex/skills/
!home/codex/.codex/skills/**
!home/codex/.codex/hooks.json
**/.codex/skills/.**
# Assistant instruction files stay ignored everywhere except the repository root (and the tracked ~/.claude copy):
# a nested AGENTS.md under home/ is an app's own state, which the blanket rules above exist to keep out.
CLAUDE.md
GEMINI.md
AGENTS.md
!/CLAUDE.md
!/AGENTS.md
!home/claude/.claude/CLAUDE.md

# ────────────────────────────────────────────────
# 🪪 Machine-local git identity
# ────────────────────────────────────────────────
home/git/.config/git/identity

# ────────────────────────────────────────────────
# 🧒 Child Git Repositories
# ────────────────────────────────────────────────
**/.tmuxifier/
/repos/

# Theme switcher state (per machine)
home/hypr/.config/hypr/theme/.current_theme

# The systemd packages are stowed with --no-folding, so these are written to ~. They only reach the repo if the package is stowed by hand without it.
# Per-machine voxtype GPU drop-in from setup_voxtype
home/systemd/.config/systemd/user/voxtype.service.d/gpu.conf
# voxtype's own unit from `voxtype setup systemd`
home/systemd/.config/systemd/user/voxtype.service
# Links from `systemctl --user enable`
home/*/.config/systemd/user/*.wants/*

# Generated by hypr/theme/generate/ on every Hyprland load
home/rofi/.config/rofi/colors.rasi
home/foot/.config/foot/foot.ini
home/yazi/.config/yazi/theme.toml
home/yazi/.config/yazi/frame-border.lua
home/kitty/.config/kitty/oasis-theme.conf
home/ghostty/.config/ghostty/oasis-theme.conf

# Local installer overrides (GITHUB_DIR, GITHUB_ORG)
/install.local

# Claude Code agent worktrees
/.claude/worktrees/

# Release notes drafted locally and pasted into the GitHub release
/RELEASE.md

# web-ext sign keeps its pending upload here
extras/voxcmd-firefox/.amo-upload-uuid

# Local plans and evidence for work in progress (see AGENTS.md "Docs")
/.plans/
/.logs/
